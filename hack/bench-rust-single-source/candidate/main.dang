pub description = "Minimal ordinary Cargo action for engine latency measurements"

type Rust {
  pub image: String!
  pub cacheKey: String!
  pub tracePhases: Boolean! = false
  pub pinnedSourceSync: Boolean! = false
  pub prepareProjectToolchain: Boolean! = false

  # Packaging experiment for the pinned Debian bookworm/amd64 image only.
  # Resolve dependencies with APT when refreshing these pins, not on every
  # user's first check. Dagger verifies and owns the downloaded File inputs.
  let toolchain: Container! {
    let base = container.from(image)
    if (pinnedSourceSync) {
      base
        .withMountedFile("/tmp/rust-sync-libpopt.deb", http(
          "https://deb.debian.org/debian/pool/main/p/popt/libpopt0_1.19%2Bdfsg-1_amd64.deb",
          checksum: "sha256:6f94b488255acd996254f775c77ff3956557c61f860a3c9caeaf65457554194f",
        ))
        .withMountedFile("/tmp/rust-sync-rsync.deb", http(
          "https://deb.debian.org/debian/pool/main/r/rsync/rsync_3.2.7-1%2Bdeb12u6_amd64.deb",
          checksum: "sha256:ce99de6b36cbb62dc614a73463e467f2c1ef509545a9a2b33cab19b50530b672",
        ))
        .withExec(["sh", "-c", "test \"$(dpkg --print-architecture)\" = amd64 && dpkg -i /tmp/rust-sync-libpopt.deb /tmp/rust-sync-rsync.deb"])
    } else {
      base.withExec(["sh", "-c", "apt-get update -qq && apt-get install -y --no-install-recommends rsync"])
    }
  }

  # Derive root toolchain files from the same immutable source used by Cargo.
  # Directory.filter preserves content hashing, so unrelated edits need not
  # invalidate the installed compiler/components. No second host read or cache.
  let projectToolchain(source: Directory!): Container! {
    if (prepareProjectToolchain) {
      let config = source.filter(include: ["rust-toolchain", "rust-toolchain.toml"])
      if (config.entries.isEmpty) {
        toolchain
      } else {
        toolchain
          .withWorkdir("/src")
          .withMountedDirectory("/src", config)
          .withExec(["rustup", "toolchain", "install", "--no-self-update"])
          .withoutMount("/src")
      }
    } else {
      toolchain
    }
  }

  let action(ws: Workspace!): Container! {
    let source = ws.directory("/", exclude: [".git", "target", "dagger.toml", "dagger.lock"])
    let command = if (tracePhases) {
      "set -e; start=$(date +%s%N); rsync -rclp --delete /input/ /src/; synced=$(date +%s%N); cargo check --workspace --locked; checked=$(date +%s%N); printf 'RUST_BENCH_PHASE_NS sync=%s cargo=%s\\n' \"$((synced-start))\" \"$((checked-synced))\" >&2"
    } else {
      "rsync -rclp --delete /input/ /src/ && cargo check --workspace --locked"
    }
    projectToolchain(source)
      .withWorkdir("/src")
      .withMountedDirectory("/input", source)
      .withMountedCache("/src", cacheVolume(cacheKey + "-source"), sharing: CacheSharingMode.LOCKED)
      .withMountedCache("/usr/local/cargo/registry", cacheVolume(cacheKey + "-registry"))
      .withMountedCache("/usr/local/cargo/git", cacheVolume(cacheKey + "-git"))
      .withEnvVariable("CARGO_TARGET_DIR", "/target")
      .withMountedCache("/target", cacheVolume(cacheKey), sharing: CacheSharingMode.LOCKED)
      .withExec(["sh", "-c", command])
  }

  pub check(ws: Workspace!): Void @check {
    action(ws).sync
    null
  }

  """
  Read the cached Cargo diagnostic output after a measured check, outside its timer.
  """
  pub checkLog(ws: Workspace!): String! {
    action(ws).stderr
  }

  """
  Inspect prepared toolchain files without running a proxy that could install
  missing components. Used only by the correctness harness, outside timings.
  """
  pub toolchainFiles(ws: Workspace!): Directory! {
    let source = ws.directory("/", exclude: [".git", "target", "dagger.toml", "dagger.lock"])
    projectToolchain(source).directory("/usr/local/rustup/toolchains")
  }
}
