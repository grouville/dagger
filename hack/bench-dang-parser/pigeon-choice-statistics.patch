+++ b/examples/json/choice_stats_options_test.go
@@ -0,0 +1,58 @@
+package json
+
+import "testing"
+
+func TestChoiceStatsOptInAndUndo(t *testing.T) {
+	p := newParser("stats", []byte(`{"value": 123}`))
+	if _, err := p.parse(g); err != nil {
+		t.Fatal(err)
+	}
+	if p.ExprCnt == 0 {
+		t.Fatal("default expression counting must remain active")
+	}
+	if len(p.ChoiceAltCnt) != 0 {
+		t.Fatal("choice counters must be opt-in")
+	}
+
+	p = newParser("options", nil)
+	base := p.Stats
+	a, b := &Stats{ExprCnt: 7}, &Stats{ExprCnt: 11}
+	undoA := Statistics(a, "a-none")(p)
+	undoB := Statistics(b, "b-none")(p)
+	undoB(p)
+	if p.Stats != a || p.choiceNoMatch != "a-none" || p.ExprCnt != 7 {
+		t.Fatal("undo B must restore A")
+	}
+	redoA := undoA(p)
+	if p.Stats != base || p.choiceNoMatch != "" || p.ExprCnt != 0 {
+		t.Fatal("undo A must restore default")
+	}
+	p.rstack = []*rule{{name: "options"}}
+	choice := &choiceExpr{pos: position{line: 2, col: 3}}
+	p.incChoiceAltCnt(choice, choiceNoMatch)
+	if len(base.ChoiceAltCnt) != 0 {
+		t.Fatal("undo must restore disabled choice collection")
+	}
+	undoAgain := redoA(p)
+	p.incChoiceAltCnt(choice, choiceNoMatch)
+	if a.ChoiceAltCnt["options 2:3"]["a-none"] != 1 {
+		t.Fatal("redo must restore enabled choice collection")
+	}
+	undoAgain(p)
+	p.incChoiceAltCnt(choice, choiceNoMatch)
+	if len(base.ChoiceAltCnt) != 0 {
+		t.Fatal("second undo must restore disabled choice collection")
+	}
+}
+
+func TestChoiceStatsKeepExpressionLimit(t *testing.T) {
+	_, err := Parse("limit", []byte(`{"value": 123}`), MaxExpressions(1))
+	if err == nil {
+		t.Fatal("default expression limit must still be enforced")
+	}
+	stats := &Stats{ExprCnt: 50}
+	_, err = Parse("limit", []byte(`{}`), Statistics(stats, "none"), MaxExpressions(1))
+	if err == nil || stats.ExprCnt != 51 {
+		t.Fatal("requested/preseeded counter must still enforce the limit")
+	}
+}
