diff --git a/gomod/.dagger/modules/e2e/main.dang b/gomod/.dagger/modules/e2e/main.dang
index 0ee95e2..c6bdd6b 100644
--- a/gomod/.dagger/modules/e2e/main.dang
+++ b/gomod/.dagger/modules/e2e/main.dang
@@ -158,6 +158,25 @@ type E2e {
     null
   }
 
+  """
+  Selecting several paths preserves the single-path rules and input order.
+  """
+  batchedSelectionCheck: Void @check {
+    let paths = ["docs/keep", "core", "/docs/", "docs-tools", "docs/keep", "."]
+    assert(gomod.selectedPaths([], ["**"]) == [], "empty input gained paths")
+    assert(gomod.selectedPaths(paths, []) == paths, "select-all changed paths or order")
+    assert(
+      gomod.selectedPaths(paths, ["/docs/**/"]) == ["docs/keep", "/docs/", "docs/keep"],
+      "selection changed normalization, duplicates or path boundaries",
+    )
+    assert(
+      gomod.selectedPaths(paths, ["**", "!docs", "docs/keep"]) == ["core", "docs-tools", "."],
+      "an include overrode an exclusion",
+    )
+    assert(gomod.selectedPaths(paths, ["."]) == ["."], "root selection included another path")
+    null
+  }
+
   """
   One selection syntax for every tool. These are the cases each tool used to
   assert separately.
