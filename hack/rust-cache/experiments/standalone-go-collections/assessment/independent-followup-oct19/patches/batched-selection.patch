+  """
+  Paths selected by the same rules as GoMod.selected, in input order.
+  Return each path as given, including duplicates.
+  """
+  selectedPaths(paths: [String!]!, patterns: [String!]!): [String!]! {
+    paths.filter { path => at(path).selected(patterns) }
+  }
