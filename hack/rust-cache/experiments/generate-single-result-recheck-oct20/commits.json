[{"sha":"57cec7676d74f3b569b2759c4a99defd6910b9fa","node_id":"C_kwDOHF1ZUtoAKDU3Y2VjNzY3NmQ3NGYzYjU2OWIyNzU5YzRhOTlkZWZkNjkxMGI5ZmE","commit":{"author":{"name":"Guillaume de Rouville","email":"guillaume@dagger.io","date":"2026-09-15T00:13:30Z"},"committer":{"name":"Guillaume de Rouville","email":"31691250+grouville@users.noreply.github.com","date":"2026-10-06T00:01:41Z"},"message":"fix(generate): keep snapshots when only one generator produced changes\n\n`dagger generate` sent every generator's output through a Git merge, even\nwhen there was one generator and nothing to merge. That round trip has a\ncost and a correctness problem.\n\nThe cost: Git copies and hashes every generated file. On a Rust\nworkspace whose generator writes binaries, that is seconds.\n\nThe correctness problem: a Git round trip drops permission bits other\nthan the executable bit, and loses empty directories. So a generator\nthat produces a 0600 file or an empty dir did not get what it asked for.\n\nWith exactly one result there is nothing to merge, so build the\nChangeset from the snapshots directly. The root .git exclusion and the\npost-generation check of skipped modules are kept. Zero results,\nseveral results, and conflict handling are untouched.\n\nMeasured on ripgrep, whose generator writes about 74MB of binaries:\nedit a source file, `dagger check`, then time `dagger generate -y`, six\ninterleaved rounds against engines built from main with and without\nthis commit:\n\n    before   7426ms median (7151-8912)\n    after    4368ms median (4237-5404)\n\nVerify:\n  dagger api call engine-dev test --pkg ./core/integration --run '^TestGenerators$/^TestSingleGenerator'\nSigned-off-by: Guillaume de Rouville <guillaume@dagger.io>","tree":{"sha":"e01a03800c2be5d95fdb7f66f93b6b52f750f33c","url":"https://api.github.com/repos/dagger/dagger/git/trees/e01a03800c2be5d95fdb7f66f93b6b52f750f33c"},"url":"https://api.github.com/repos/dagger/dagger/git/commits/57cec7676d74f3b569b2759c4a99defd6910b9fa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/dagger/dagger/commits/57cec7676d74f3b569b2759c4a99defd6910b9fa","html_url":"https://github.com/dagger/dagger/commit/57cec7676d74f3b569b2759c4a99defd6910b9fa","comments_url":"https://api.github.com/repos/dagger/dagger/commits/57cec7676d74f3b569b2759c4a99defd6910b9fa/comments","author":{"login":"grouville","id":31691250,"node_id":"MDQ6VXNlcjMxNjkxMjUw","avatar_url":"https://avatars.githubusercontent.com/u/31691250?v=4","gravatar_id":"","url":"https://api.github.com/users/grouville","html_url":"https://github.com/grouville","followers_url":"https://api.github.com/users/grouville/followers","following_url":"https://api.github.com/users/grouville/following{/other_user}","gists_url":"https://api.github.com/users/grouville/gists{/gist_id}","starred_url":"https://api.github.com/users/grouville/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/grouville/subscriptions","organizations_url":"https://api.github.com/users/grouville/orgs","repos_url":"https://api.github.com/users/grouville/repos","events_url":"https://api.github.com/users/grouville/events{/privacy}","received_events_url":"https://api.github.com/users/grouville/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"grouville","id":31691250,"node_id":"MDQ6VXNlcjMxNjkxMjUw","avatar_url":"https://avatars.githubusercontent.com/u/31691250?v=4","gravatar_id":"","url":"https://api.github.com/users/grouville","html_url":"https://github.com/grouville","followers_url":"https://api.github.com/users/grouville/followers","following_url":"https://api.github.com/users/grouville/following{/other_user}","gists_url":"https://api.github.com/users/grouville/gists{/gist_id}","starred_url":"https://api.github.com/users/grouville/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/grouville/subsc