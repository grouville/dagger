+// Merge returns a new map, preserving left-hand key positions and appending
+// new right-hand keys in order. Right-hand values win on overlapping keys.
+func (m MapValue) Merge(other MapValue) MapValue {
+	if len(other.Keys) == 0 {
+		return m
+	}
+	keys := make([]string, len(m.Keys), len(m.Keys)+len(other.Keys))
+	copy(keys, m.Keys)
+	entries := make(map[string]Value, len(m.Entries)+len(other.Keys))
+	for key, value := range m.Entries {
+		entries[key] = value
+	}
+	for _, key := range other.Keys {
+		if _, exists := entries[key]; !exists {
+			keys = append(keys, key)
+		}
+		entries[key] = other.Entries[key]
+	}
+	return MapValue{Keys: keys, Entries: entries, ValType: m.ValType}
+}
