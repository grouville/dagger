+
+# Shared path conversion needs only the workspace's immutable working directory.
+type WorkspacePaths {
+  let cwd: String!
+
+  let root(path: String!): String! {
+    let segments = path.split("/").filter { segment => segment != "" and segment != "." }
+    let up = segments.filter { segment => segment == ".." }.length
+    let down = segments.filter { segment => segment != ".." }
+    let resolved = cwd.split("/").filter { segment => segment != "" }.dropLast(up) + down
+
+    if (resolved.length == 0) { "." } else { resolved.join("/") }
+  }
+}
