+  """
+  Header validation agrees with individual discovery for unusual contents and
+  filenames, including when search cannot confirm a match.
+  """
+  packageHeaderVariantsCheck: Void @check {
+    let headers = [
+      {{data: "module example.com/normal\n", valid: true}},
+      {{data: "\x00\nmodule example.com/binary\n", valid: true}},
+      {{data: "\tmodule(example.com/legacy\n", valid: true}},
+      {{data: "module\r\n", valid: false}},
+      {{data: "# module example.com/comment\n", valid: false}},
+      {{data: "moduledifferent example.com/invalid\n", valid: false}},
+    ]
+    headers.each { header =>
+      let ws = directory
+        .withNewFile("go.mod", header.data)
+        .withNewFile("item.go", "package item\n")
+        .asWorkspace
+      assert(gomod.at(".").isGoModule(ws) == header.valid, "header classification changed")
+      comparePackageFacts(ws)
+    }
+    let unusual = directory
+      .withNewFile("go.mod", "go 1.26.6\n")
+      .withNewFile("root.go", "package root\n")
+      .withNewFile("prefix\nnormal/go.mod", "module example.com/newline\n")
+      .withNewFile("prefix\nnormal/item.go", "package item\n")
+      .withNewFile("normal/go.mod", "# module example.com/comment\n")
+      .withNewFile("normal/item.go", "package normal\n")
+    comparePackageFacts(unusual.asWorkspace)
+    let linked = directory
+      .withNewFile("declaration", "module example.com/linked\n")
+      .withNewFile("linked/item.go", "package linked\n")
+      .withSymlink(target: "../declaration", linkName: "linked/go.mod")
+    let individual = { gomod.modules(linked.asWorkspace).{{path}}; "accepted" } rescue {
+      err: Error => "" + err.message
+    }
+    let batched = { gomod.packageFacts(linked.asWorkspace, []).{{path}}; "accepted" } rescue {
+      err: Error => "" + err.message
+    }
+    assert(individual.contains("stat go.mod: no such file or directory") and batched.contains("stat go.mod: no such file or directory"), "symlink read failure changed: " + JSON.encode({{individual: individual, batched: batched}}))
+    null
+  }
+
