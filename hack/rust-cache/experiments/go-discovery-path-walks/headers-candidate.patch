+  # Search establishes positive headers in one request. Unmatched paths still
+  # use the original reader, including its binary, symlink and error behavior.
+  let moduleHeaders(ws: Workspace!, roots: [String!]!): Map[Boolean!]! {
+    let empty: [String!]! = []
+    let pattern = at(".").moduleHeaderPattern
+    let found = if (roots.length == 0) {
+      empty
+    } else {
+      {
+        ws.search(
+          paths: roots.map { root => absolute(at(root).subpath("go.mod")) },
+          pattern: "module",
+          literal: true,
+        ).{{filePath, matchedLines}}
+          .filter { match => match.matchedLines.match(pattern) != null }
+          .map { match =>
+            let parent = match.filePath.trimPrefix("/").trimPrefix("./").split("/").dropLast(1).join("/")
+            if (parent == "") { "." } else { parent }
+          }
+      } rescue {
+        err: Error => empty
+      }
+    }
+    rootIndex(found)
+  }
