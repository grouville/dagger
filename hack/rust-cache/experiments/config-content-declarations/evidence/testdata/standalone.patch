+# Dagger workspace configuration
+# Install modules with: dagger mod install <module>
+# Example:
+#   dagger mod install github.com/dagger/dagger/modules/wolfi
+
+[modules.dang-sdk]
+source = "github.com/dagger/dang-sdk@collections"
+
+[modules.go-dev]
+source = ".dagger/modules/go-dev"
+entrypoint = true
+
+# Each tool's suite is installed under a <tool>-checks key, so one `dagger
+# check` runs all four and prefixes each check with the tool it belongs to.
+# The key is what prefixes; "e2e" would kebab-case into "e-2-e".
+#
+# The "./" is required. A source that holds a "." but does not start with one
+# may be a hostname to Dagger, so it is not rewritten into the repository when
+# the workspace is loaded from git, as in CI, and fails to load there.
+[modules.gomod-checks]
+source = "./gomod/.dagger/modules/e2e"
+
+[modules.golangci-lint-checks]
+source = "./golangci-lint/.dagger/modules/e2e"
+
+[modules.staticcheck-checks]
+source = "./staticcheck/.dagger/modules/e2e"
+
+[sdks.dang]
+module = "dang-sdk"
+
+[sdks.dang.scopes."."]
+is-module = true
+name = "go"
+clients = ["./gomod"]
+
+[sdks.dang.scopes."gomod"]
+is-module = true
+name = "gomod"
+
+[sdks.dang.scopes."gomod/.dagger/modules/e2e"]
+is-module = true
+name = "e2e"
+clients = ["./gomod"]
+
+[sdks.dang.scopes."golangci-lint"]
+is-module = true
+name = "golangci-lint"
+clients = ["./gomod"]
+
+[sdks.dang.scopes."golangci-lint/.dagger/modules/e2e"]
+is-module = true
+name = "e2e"
+clients = ["./golangci-lint"]
+
+[sdks.dang.scopes."staticcheck"]
+is-module = true
+name = "staticcheck"
+clients = ["./gomod"]
+
+[sdks.dang.scopes."staticcheck/.dagger/modules/e2e"]
+is-module = true
+name = "e2e"
+clients = ["./staticcheck"]
