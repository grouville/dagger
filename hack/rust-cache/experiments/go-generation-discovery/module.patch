+
+# Immutable generation matches for one workspace and set of tool settings.
+# Discovery shares this value locally; it is not stored in collection getters.
+type GoGenerateMatches {
+  let includeAll: Boolean!
+  let included: [String!]!
+  let excluded: [String!]!
+
+  new(ws: Workspace!, patterns: [String!]!) {
+    let include = patterns.filter { p => p.hasPrefix("!") == false }
+    let exclude = patterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
+    self.includeAll = include.length == 0
+    self.included = matchingGenerateDirectories(ws, include)
+    self.excluded = matchingGenerateDirectories(ws, exclude)
+    self
+  }
+
+  let select(dirs: [String!]!): [String!]! {
+    dirs.filter { dir =>
+      (includeAll or included.any { match => match == dir })
+        and excluded.any { match => match == dir } == false
+    }
+  }
+
+  let matchingGenerateDirectories(ws: Workspace!, patterns: [String!]!): [String!]! {
+    let empty: [String!]! = []
+    patterns.reduce(empty) { dirs, pattern =>
+      dirs + ws
+        .glob(pattern.trimSuffix("/") + "/*.go")
+        .filter { file => file.hasSuffix("/") == false }
+        .map { file =>
+          let dir = file.split("/").dropLast(1).join("/")
+          if (dir == "") { "." } else { dir }
+        }
+    }
   }
 }
