diff --git a/compiler/replay/diagnostic.go b/compiler/replay/diagnostic.go
new file mode 100644
index 0000000..fdbfc62
--- /dev/null
+++ b/compiler/replay/diagnostic.go
@@ -0,0 +1,73 @@
+package replay
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/Khan/genqlient/graphql"
+)
+
+type diagnosticKey struct{}
+
+type diagnosticEvent struct {
+	Phase        string  `json:"phase"`
+	StartMS      float64 `json:"start_ms"`
+	DurationMS   float64 `json:"duration_ms"`
+	RequestBytes int     `json:"request_bytes,omitempty"`
+}
+
+type diagnosticProfile struct {
+	start  time.Time
+	mu     sync.Mutex
+	events []diagnosticEvent
+}
+
+func DiagnosticCompile(ctx context.Context) (context.Context, func()) {
+	p := &diagnosticProfile{start: time.Now()}
+	return context.WithValue(ctx, diagnosticKey{}, p), func() {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		data, _ := json.Marshal(struct {
+			TotalMS float64           `json:"total_ms"`
+			Events  []diagnosticEvent `json:"events"`
+		}{float64(time.Since(p.start)) / float64(time.Millisecond), p.events})
+		fmt.Fprintf(os.Stderr, "RUST_COMPILE_DIAGNOSTIC %s\n", data)
+	}
+}
+
+func DiagnosticSteps(ctx context.Context, prefix string) func(string) {
+	p, _ := ctx.Value(diagnosticKey{}).(*diagnosticProfile)
+	last := time.Now()
+	return func(name string) {
+		end := time.Now()
+		if p != nil {
+			p.record(prefix+"."+name, last, end, 0)
+		}
+		last = end
+	}
+}
+
+func (p *diagnosticProfile) record(phase string, start, end time.Time, size int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.events = append(p.events, diagnosticEvent{phase, float64(start.Sub(p.start)) / float64(time.Millisecond), float64(end.Sub(start)) / float64(time.Millisecond), size})
+}
+
+type diagnosticQueries struct{ graphql.Client }
+
+func DiagnosticQueries(client graphql.Client) graphql.Client {
+	return &diagnosticQueries{client}
+}
+
+func (q *diagnosticQueries) MakeRequest(ctx context.Context, req *graphql.Request, response *graphql.Response) error {
+	start := time.Now()
+	err := q.Client.MakeRequest(ctx, req, response)
+	if p, _ := ctx.Value(diagnosticKey{}).(*diagnosticProfile); p != nil {
+		p.record("graphql.request", start, time.Now(), len(req.Query))
+	}
+	return err
+}
