+		fnErr = fn(boltutil.WithTransaction(writeCtx, tx))
+		writing.EndErr(fnErr)
+		_, commit = wcprof.BeginOp(ctx, wcprof.OpKindInternal, "snapshot.ownerLease.commit", wcprof.OpOpts{})
 		return nil
 	})
+	if !entered {
+		waiting.EndErr(err)
+	}
+	commit.EndErr(err)
