+	ctx, operation := wcprof.BeginOp(ctx, wcprof.OpKindInternal, "snapshot.ownerLease.transaction", wcprof.OpOpts{})
+	defer func() { operation.EndErr(rerr) }()
 	if cm.metadataDB == nil {
 		return true, fn(ctx)
 	}
+	_, waiting := wcprof.BeginOp(ctx, wcprof.OpKindInternal, "snapshot.ownerLease.transactionWait", wcprof.OpOpts{})
