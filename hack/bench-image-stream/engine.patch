+package resolver
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"sync/atomic"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/errdefs"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStreamedFetchOptionalReaderContract(t *testing.T) {
+	payload := []byte("one supported bounded streaming reader")
+	reader := &privateStreamReader{reader: io.NopCloser(bytes.NewReader(append(bytes.Clone(payload), []byte("trailing unread bytes")...))), size: int64(len(payload))}
+	_, err := reader.ReadAt(make([]byte, 1), 0)
+	require.True(t, errdefs.IsNotImplemented(err), "even sequential ReadAt is explicitly unsupported")
+	actual, err := io.ReadAll(content.NewReader(reader))
+	require.NoError(t, err, "content.NewReader must select optional Reader(), not its ReadAt fallback")
+	require.Equal(t, payload, actual, "optional Reader must preserve descriptor-size bound")
+	_, err = io.ReadAll(content.NewReader(reader))
+	require.True(t, errdefs.IsNotImplemented(err), "repeat Reader() must not silently share/reset the pipe")
+}
+
+type streamOptionalTrackingProvider struct {
+	content.Provider
+	readerCalls *atomic.Int64
+	readAtCalls *atomic.Int64
+}
+
+func (p streamOptionalTrackingProvider) ReaderAt(ctx context.Context, desc ocispecs.Descriptor) (content.ReaderAt, error) {
+	r, err := p.Provider.ReaderAt(ctx, desc)
+	if err != nil {
+		return nil, err
+	}
+	return streamOptionalTrackingReader{reader: r, readerCalls: p.readerCalls, readAtCalls: p.readAtCalls}, nil
+}
+
+type streamOptionalTrackingReader struct {
+	reader      content.ReaderAt
+	readerCalls *atomic.Int64
+	readAtCalls *atomic.Int64
+}
+
+func (r streamOptionalTrackingReader) Reader() io.Reader {
+	r.readerCalls.Add(1)
+	optional, ok := r.reader.(interface{ Reader() io.Reader })
+	if !ok {
+		return privateStreamReadError{errdefs.ErrNotImplemented}
+	}
+	return optional.Reader()
+}
+
+func (r streamOptionalTrackingReader) ReadAt(p []byte, off int64) (int, error) {
+	r.readAtCalls.Add(1)
+	return r.reader.ReadAt(p, off)
+}
+
+func (r streamOptionalTrackingReader) Size() int64  { return r.reader.Size() }
+func (r streamOptionalTrackingReader) Close() error { return r.reader.Close() }
diff --git a/engine/server/resolver/streamed_fetch_owned_pipe_test.go b/engine/server/resolver/streamed_fetch_owned_pipe_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..55468bbbd7aa0ee1a0d0455b0f03b3784844c917
--- /dev/null
+++ b/engine/server/resolver/streamed_fetch_owned_pipe_test.go
@@ -0,0 +1,91 @@
+package resolver
+
+import (
+	"errors"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+)
+
+type trackedPrivatePipe struct {
+	*io.PipeReader
+	entered chan struct{}
+	once    sync.Once
+	active  atomic.Bool
+	reads   atomic.Int64
+}
+
+func (p *trackedPrivatePipe) Read(b []byte) (int, error) {
+	p.active.Store(true)
+	defer p.active.Store(false)
+	p.reads.Add(1)
+	p.once.Do(func() { close(p.entered) })
+	return p.PipeReader.Read(b)
+}
+
+func TestStreamedFetchOwnedPipeCloseStopsReads(t *testing.T) {
+	input, writer := io.Pipe()
+	defer input.Close()
+	defer writer.Close()
+	tracked := &trackedPrivatePipe{PipeReader: input, entered: make(chan struct{})}
+	reader := &privateStreamReader{reader: tracked, size: 1024}
+	stream := content.NewReader(reader)
+	readDone := make(chan error, 1)
+	go func() { _, err := stream.Read(make([]byte, 1)); readDone <- err }()
+	<-tracked.entered
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- reader.Close() }()
+	select {
+	case err := <-closeDone:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Close did not interrupt the owned input read")
+	}
+	if tracked.active.Load() {
+		t.Error("owned source Read still active after Close returned")
+	}
+	select {
+	case err := <-readDone:
+		if !errors.Is(err, io.ErrClosedPipe) {
+			t.Fatalf("interrupted owned read returned %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("owned input read leaked after Close")
+	}
+	before := tracked.reads.Load()
+	if _, err := stream.Read(make([]byte, 1)); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("read after Close returned %v", err)
+	}
+	if tracked.reads.Load() != before {
+		t.Fatal("read after Close reached the owned input")
+	}
+	if err := reader.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestStreamedFetchOwnedPipeCloseReleasesWriter(t *testing.T) {
+	input, writer := io.Pipe()
+	defer input.Close()
+	defer writer.Close()
+	reader := &privateStreamReader{reader: input, size: 1024}
+	writeDone := make(chan error, 1)
+	go func() { _, err := writer.Write([]byte("unconsumed bytes")); writeDone <- err }()
+	if err := reader.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-writeDone:
+		if !errors.Is(err, errPrivateConsumerFinished) {
+			t.Fatalf("writer must distinguish private consumption from verification: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("owned writer remained blocked after Close")
+	}
+}
