index 0000000000000000000000000000000000000000..4b0749eb7cdda087e36e04d0cd8e21ec6b8f2136
--- /dev/null
+++ b/engine/snapshots/pull_pipeline_test.go
@@ -0,0 +1,393 @@
+package snapshots
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"maps"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/mount"
+	ctdsnapshots "github.com/containerd/containerd/v2/core/snapshots"
+	localcontent "github.com/containerd/containerd/v2/plugins/content/local"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+// These tests drive the real ImportImage scheduler, manager, metadata and local
+// content store. Snapshot mounting, application and lease GC are test doubles;
+// successful completion here does not establish real tar unpack or containerd GC.
+type pipelineTestSnapshotter struct {
+	*applySnapshotDiffTestSnapshotter
+	onCommit func(string)
+	muMount  sync.Mutex
+	mounts   int
+}
+
+func (sn *pipelineTestSnapshotter) Prepare(ctx context.Context, key, parent string, opts ...ctdsnapshots.Opt) error {
+	if parent != "" {
+		if _, err := sn.Stat(ctx, parent); err != nil {
+			return fmt.Errorf("missing parent at prepare: %w", err)
+		}
+	}
+	return sn.applySnapshotDiffTestSnapshotter.Prepare(ctx, key, parent, opts...)
+}
+
+func (sn *pipelineTestSnapshotter) Commit(ctx context.Context, name, key string, opts ...ctdsnapshots.Opt) error {
+	if err := sn.applySnapshotDiffTestSnapshotter.Commit(ctx, name, key, opts...); err != nil {
+		return err
+	}
+	if sn.onCommit != nil {
+		sn.onCommit(name)
+	}
+	return nil
+}
+
+func (sn *pipelineTestSnapshotter) Mounts(context.Context, string) (MountableRef, error) {
+	return pipelineTestMount{sn}, nil
+}
+
+type pipelineTestMount struct{ sn *pipelineTestSnapshotter }
+
+func (m pipelineTestMount) Mount() ([]mount.Mount, func() error, error) {
+	m.sn.muMount.Lock()
+	m.sn.mounts++
+	m.sn.muMount.Unlock()
+	return nil, func() error { m.sn.muMount.Lock(); defer m.sn.muMount.Unlock(); m.sn.mounts--; return nil }, nil
+}
+
+type pipelineTestApplier func(context.Context, ocispecs.Descriptor) error
+
+func (fn pipelineTestApplier) Apply(ctx context.Context, desc ocispecs.Descriptor, _ []mount.Mount, _ ...diff.ApplyOpt) (ocispecs.Descriptor, error) {
+	if err := fn(ctx, desc); err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	return ocispecs.Descriptor{Digest: digest.Digest(desc.Annotations["containerd.io/uncompressed"])}, nil
+}
+
+func newPipelineTestManager(t *testing.T) (*snapshotManager, *pipelineTestSnapshotter, context.Context) {
+	t.Helper()
+	cm := newApplySnapshotDiffTestManager(t)
+	sn := &pipelineTestSnapshotter{applySnapshotDiffTestSnapshotter: cm.Snapshotter.(*applySnapshotDiffTestSnapshotter)}
+	cm.Snapshotter = sn
+	store, err := localcontent.NewLabeledStore(t.TempDir(), &pipelineTestLabels{labels: map[digest.Digest]map[string]string{}})
+	require.NoError(t, err)
+	cm.ContentStore = store
+	cm.Applier = pipelineTestApplier(func(context.Context, ocispecs.Descriptor) error { return nil })
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	t.Cleanup(cancel)
+	ctx, release, err := WithLazyLease(ctx, cm.LeaseManager)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, release(context.Background()))
+		sn.muMount.Lock()
+		defer sn.muMount.Unlock()
+		require.Zero(t, sn.mounts)
+	})
+	return cm, sn, ctx
+}
+
+func pipelineTestLayer(name string) (ocispecs.Descriptor, []byte) {
+	data := []byte("complete test layer " + name)
+	return ocispecs.Descriptor{MediaType: ocispecs.MediaTypeImageLayer, Digest: digest.FromBytes(data), Size: int64(len(data)), Annotations: map[string]string{"containerd.io/uncompressed": digest.FromBytes(data).String()}}, data
+}
+
+type pipelineTestLabels struct {
+	mu     sync.Mutex
+	labels map[digest.Digest]map[string]string
+}
+
+func (s *pipelineTestLabels) Get(d digest.Digest) (map[string]string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return maps.Clone(s.labels[d]), nil
+}
+func (s *pipelineTestLabels) Set(d digest.Digest, labels map[string]string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.labels[d] = maps.Clone(labels)
+	return nil
+}
+func (s *pipelineTestLabels) Update(d digest.Digest, labels map[string]string) (map[string]string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.labels[d] == nil {
+		s.labels[d] = map[string]string{}
+	}
+	for k, v := range labels {
+		if v == "" {
+			delete(s.labels[d], k)
+		} else {
+			s.labels[d][k] = v
+		}
+	}
+	return maps.Clone(s.labels[d]), nil
+}
+
+func pipelineTestWrite(ctx context.Context, cm *snapshotManager, desc ocispecs.Descriptor, data []byte) error {
+	return content.WriteBlob(ctx, cm.ContentStore, desc.Digest.String(), bytes.NewReader(data), desc)
+}
+
+func pipelineTestWait(ctx context.Context, ch <-chan struct{}) error {
+	select {
+	case <-ch:
+		return nil
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	}
+}
+
+type pipelineTestResult struct {
+	ref ImmutableRef
+	err error
+}
+
+func pipelineTestStart(cm *snapshotManager, ctx context.Context, img *ImportedImage, fetch func(context.Context, ocispecs.Descriptor) error) <-chan pipelineTestResult {
+	done := make(chan pipelineTestResult, 1)
+	go func() {
+		ref, err := cm.ImportImage(ctx, img, ImportImageOpts{FetchLayer: fetch})
+		done <- pipelineTestResult{ref, err}
+	}()
+	return done
+}
+
+func pipelineTestFinish(t *testing.T, ctx context.Context, done <-chan pipelineTestResult) pipelineTestResult {
+	t.Helper()
+	select {
+	case got := <-done:
+		if got.ref != nil {
+			t.Cleanup(func() { require.NoError(t, got.ref.Release(context.Background())) })
+		}
+		return got
+	case <-ctx.Done():
+		t.Fatal("pipeline did not join before deadline:", context.Cause(ctx))
+		return pipelineTestResult{}
+	}
+}
+
+func TestImportImagePipelineOverlapsAndOrdersApply(t *testing.T) {
+	cm, sn, ctx := newPipelineTestManager(t)
+	first, firstData := pipelineTestLayer("base")
+	second, secondData := pipelineTestLayer("later")
+	firstApply := make(chan struct{})
+	allowFirstApply := make(chan struct{})
+	laterFetch := make(chan struct{})
+	allowLaterFetch := make(chan struct{})
+	var mu sync.Mutex
+	var events []string
+	cm.Applier = pipelineTestApplier(func(ctx context.Context, desc ocispecs.Descriptor) error {
+		mu.Lock()
+		events = append(events, "apply:"+desc.Digest.String())
+		mu.Unlock()
+		if desc.Digest == first.Digest {
+			close(firstApply)
+			return pipelineTestWait(ctx, allowFirstApply)
+		}
+		return nil
+	})
+	sn.onCommit = func(string) { mu.Lock(); events = append(events, "commit"); mu.Unlock() }
+	done := pipelineTestStart(cm, ctx, &ImportedImage{Layers: []ocispecs.Descriptor{first, second}}, func(ctx context.Context, desc ocispecs.Descriptor) error {
+		if desc.Digest == second.Digest {
+			close(laterFetch)
+			if err := pipelineTestWait(ctx, allowLaterFetch); err != nil {
+				return err
+			}
+			return pipelineTestWrite(ctx, cm, desc, secondData)
+		}
+		return pipelineTestWrite(ctx, cm, desc, firstData)
+	})
+	require.NoError(t, pipelineTestWait(ctx, laterFetch))
+	require.NoError(t, pipelineTestWait(ctx, firstApply), "base apply must start while the later fetch remains blocked")
+	close(allowLaterFetch)
+	close(allowFirstApply)
+	got := pipelineTestFinish(t, ctx, done)
+	require.NoError(t, got.err)
+	require.NotNil(t, got.ref)
+	mu.Lock()
+	defer mu.Unlock()
+	require.Equal(t, []string{"apply:" + first.Digest.String(), "commit", "apply:" + second.Digest.String(), "commit"}, events)
+}
+
+func TestImportImagePipelineDeduplicatesFetchNotApplication(t *testing.T) {
+	cm, _, ctx := newPipelineTestManager(t)
+	layer, data := pipelineTestLayer("repeated")
+	var mu sync.Mutex
+	fetches, applies := 0, 0
+	cm.Applier = pipelineTestApplier(func(context.Context, ocispecs.Descriptor) error { applies++; return nil })
+	done := pipelineTestStart(cm, ctx, &ImportedImage{Layers: []ocispecs.Descriptor{layer, layer}}, func(ctx context.Context, desc ocispecs.Descriptor) error {
+		mu.Lock()
+		fetches++
+		mu.Unlock()
+		return pipelineTestWrite(ctx, cm, desc, data)
+	})
+	got := pipelineTestFinish(t, ctx, done)
+	require.NoError(t, got.err)
+	require.Equal(t, 1, fetches)
+	require.Equal(t, 2, applies, "same bytes on a different parent are a different layer application")
+}
+
+func TestImportImagePipelineFetchFailure(t *testing.T) {
+	for _, phase := range []string{"before-apply", "after-base-commit"} {
+		t.Run(phase, func(t *testing.T) {
+			cm, sn, ctx := newPipelineTestManager(t)
+			first, data := pipelineTestLayer("base")
+			second, _ := pipelineTestLayer("failed-fetch")
+			committed := make(chan struct{})
+			sn.onCommit = func(string) { close(committed) }
+			fetchErr := errors.New("specific fetch failure")
+			done := pipelineTestStart(cm, ctx, &ImportedImage{Layers: []ocispecs.Descriptor{first, second}}, func(ctx context.Context, desc ocispecs.Descriptor) error {
+				if desc.Digest == first.Digest {
+					if phase == "before-apply" {
+						<-ctx.Done()
+						return context.Cause(ctx)
+					}
+					return pipelineTestWrite(ctx, cm, desc, data)
+				}
+				if phase == "after-base-commit" {
+					if err := pipelineTestWait(ctx, committed); err != nil {
+						return err
+					}
+				}
+				return fetchErr
+			})
+			got := pipelineTestFinish(t, ctx, done)
+			require.Nil(t, got.ref)
+			require.ErrorIs(t, got.err, fetchErr)
+			sn.mu.Lock()
+			defer sn.mu.Unlock()
+			if phase == "before-apply" {
+				require.Empty(t, sn.commitLeaseID)
+			} else {
+				require.Len(t, sn.commitLeaseID, 1)
+			}
+		})
+	}
+}
+
+func TestImportImagePipelineApplyFailureCancelsAndJoinsFetch(t *testing.T) {
+	cm, sn, ctx := newPipelineTestManager(t)
+	first, data := pipelineTestLayer("base")
+	second, _ := pipelineTestLayer("blocked")
+	started, sawCancel, permitExit := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var permitExitOnce sync.Once
+	allowExit := func() { permitExitOnce.Do(func() { close(permitExit) }) }
+	defer allowExit()
+	applyErr := errors.New("specific apply failure")
+	cm.Applier = pipelineTestApplier(func(ctx context.Context, _ ocispecs.Descriptor) error {
+		if err := pipelineTestWait(ctx, started); err != nil {
+			return err
+		}
+		return applyErr
+	})
+	done := pipelineTestStart(cm, ctx, &ImportedImage{Layers: []ocispecs.Descriptor{first, second}}, func(ctx context.Context, desc ocispecs.Descriptor) error {
+		if desc.Digest == first.Digest {
+			return pipelineTestWrite(ctx, cm, desc, data)
+		}
+		close(started)
+		<-ctx.Done()
+		close(sawCancel)
+		<-permitExit
+		return context.Cause(ctx)
+	})
+	require.NoError(t, pipelineTestWait(ctx, sawCancel))
+	select {
+	case got := <-done:
+		t.Fatalf("returned without joining fetch worker: %v", got.err)
+	default:
+	}
+	allowExit()
+	got := pipelineTestFinish(t, ctx, done)
+	require.Nil(t, got.ref)
+	require.ErrorIs(t, got.err, applyErr)
+	sn.mu.Lock()
+	defer sn.mu.Unlock()
+	require.Empty(t, sn.commitLeaseID)
+}
+
+func TestImportImagePipelineParentCancellation(t *testing.T) {
+	cm, _, ctx := newPipelineTestManager(t)
+	pipelineCtx, cancel := context.WithCancelCause(ctx)
+	first, _ := pipelineTestLayer("base")
+	second, _ := pipelineTestLayer("later")
+	started := make(chan struct{}, 2)
+	exited := make(chan struct{}, 2)
+	done := pipelineTestStart(cm, pipelineCtx, &ImportedImage{Layers: []ocispecs.Descriptor{first, second}}, func(ctx context.Context, _ ocispecs.Descriptor) error {
+		started <- struct{}{}
+		<-ctx.Done()
+		exited <- struct{}{}
+		return context.Cause(ctx)
+	})
+	require.NoError(t, pipelineTestWait(ctx, started))
+	require.NoError(t, pipelineTestWait(ctx, started))
+	cause := errors.New("caller abandoned import")
+	cancel(cause)
+	got := pipelineTestFinish(t, ctx, done)
+	require.Nil(t, got.ref)
+	require.ErrorIs(t, got.err, cause)
+	require.Len(t, exited, 2)
+}
+
+func TestImportImagePipelineEmptyLocalAndSingle(t *testing.T) {
+	for _, kind := range []string{"nil", "empty", "local", "single"} {
+		t.Run(kind, func(t *testing.T) {
+			cm, _, ctx := newPipelineTestManager(t)
+			layer, data := pipelineTestLayer(kind)
+			img := &ImportedImage{}
+			var fetch func(context.Context, ocispecs.Descriptor) error
+			if kind == "nil" {
+				img = nil
+			}
+			if kind == "single" || kind == "local" {
+				img.Layers = []ocispecs.Descriptor{layer}
+			}
+			if kind == "local" {
+				require.NoError(t, pipelineTestWrite(ctx, cm, layer, data))
+			} else {
+				fetch = func(ctx context.Context, desc ocispecs.Descriptor) error {
+					if kind != "single" {
+						return errors.New("unexpected fetch for empty image")
+					}
+					return pipelineTestWrite(ctx, cm, desc, data)
+				}
+			}
+			got := pipelineTestFinish(t, ctx, pipelineTestStart(cm, ctx, img, fetch))
+			if kind == "nil" {
+				require.Error(t, got.err)
+				require.Nil(t, got.ref)
+			} else {
+				require.NoError(t, got.err)
+				require.NotNil(t, got.ref)
+			}
+		})
+	}
+}
+
+func TestImportImageLayerReuseMissingContentFallsBack(t *testing.T) {
+	for _, lookup := range []string{"blob", "diff"} {
+		t.Run(lookup, func(t *testing.T) {
+			cm, sn, ctx := newPipelineTestManager(t)
+			const oldID = "stale-content-parent"
+			sn.snapshots[oldID] = ctdsnapshots.Info{Name: oldID, Kind: ctdsnapshots.KindCommitted}
+			layer, data := pipelineTestLayer("replacement")
+			cm.snapshotContentDigests[oldID] = map[digest.Digest]struct{}{digest.FromString("missing-old-content"): {}}
+			if lookup == "blob" {
+				cm.importedLayerByBlob[ImportedLayerBlobKey{BlobDigest: layer.Digest}] = oldID
+			} else {
+				cm.importedLayerByDiff[ImportedLayerDiffKey{DiffID: layer.Digest}] = oldID
+			}
+			require.NoError(t, pipelineTestWrite(ctx, cm, layer, data))
+			ref, err := cm.importImageLayer(ctx, layer, nil, ImportImageOpts{})
+			require.NoError(t, err)
+			defer ref.Release(context.Background())
+			require.NotEqual(t, oldID, ref.SnapshotID(), "a missing content closure must not escape as a valid reuse hit")
+			require.Equal(t, ref.SnapshotID(), cm.importedLayerByBlob[ImportedLayerBlobKey{BlobDigest: layer.Digest}])
+			require.Equal(t, ref.SnapshotID(), cm.importedLayerByDiff[ImportedLayerDiffKey{DiffID: layer.Digest}])
+		})
+	}
+}
