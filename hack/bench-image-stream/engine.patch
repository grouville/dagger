diff --git a/core/integration/engine_streamed_snapshot_test.go b/core/integration/engine_streamed_snapshot_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8de64a20b38b206af128dca91b5c22a1f4dd113d
--- /dev/null
+++ b/core/integration/engine_streamed_snapshot_test.go
@@ -0,0 +1,88 @@
+package core
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"dagger.io/dagger"
+	"github.com/dagger/testctx"
+	"github.com/stretchr/testify/require"
+)
+
+// Runs only focused filesystem/snapshot correctness tests in the supported
+// source-built dev-engine image. The outer test runner stays unprivileged.
+// This does not benchmark Cargo or change engine-dev's global exec privileges.
+func (EngineSuite) TestVerifiedStreamRealPrivateSnapshot(ctx context.Context, t *testctx.T) {
+	runVerifiedStreamPrivateSnapshot(ctx, t, false, "^(TestStreamedFetch.*|TestStreamedSnapshotRealPrivate)$", false, 1)
+}
+
+// Diagnostic only: containerd chooses its external gzip tool once per process.
+// Both variants must satisfy the same real-snapshot assertions; failures stay
+// failures rather than becoming an expected-error success gate.
+func (EngineSuite) TestVerifiedStreamDecoderBoundary(ctx context.Context, t *testctx.T) {
+	for _, decoder := range []string{"default", "builtin-control"} {
+		t.Run(decoder, func(ctx context.Context, t *testctx.T) {
+			runVerifiedStreamPrivateSnapshot(ctx, t, decoder == "builtin-control", "^TestStreamedSnapshotRealPrivate$", false, 1)
+		})
+	}
+}
+
+func (EngineSuite) TestVerifiedStreamRealPrivateSnapshotRace(ctx context.Context, t *testctx.T) {
+	runVerifiedStreamPrivateSnapshot(ctx, t, false, "^(TestStreamedFetch.*|TestStreamedSnapshotRealPrivate|TestDeferredPull.*)$", true, 3)
+}
+
+func (EngineSuite) TestVerifiedStreamLargePrivateSnapshotRace(ctx context.Context, t *testctx.T) {
+	runVerifiedStreamPrivateSnapshot(ctx, t, false, "^TestStreamedSnapshotRealPrivateLarge$", true, 3)
+}
+
+func runVerifiedStreamPrivateSnapshot(ctx context.Context, t *testctx.T, builtin bool, pattern string, race bool, count int) {
+	c := connect(ctx, t)
+	workdir, err := os.Getwd()
+	require.NoError(t, err)
+	repoRoot := filepath.Clean(filepath.Join(workdir, "..", ".."))
+	_, err = os.Stat(filepath.Join(repoRoot, "go.mod"))
+	require.NoError(t, err)
+	testBinary := filepath.Join(t.TempDir(), "streamed-resolver.test")
+	buildArgs := []string{"test", "-c", "-o", testBinary}
+	cgoEnabled := "CGO_ENABLED=0"
+	if race {
+		buildArgs = append(buildArgs, "-race")
+		cgoEnabled = "CGO_ENABLED=1"
+	}
+	buildArgs = append(buildArgs, "./engine/server/resolver")
+	cmd := exec.CommandContext(ctx, "go", buildArgs...)
+	cmd.Dir = repoRoot
+	cmd.Env = append(os.Environ(), cgoEnabled, "GOTOOLCHAIN=local", "GOWORK=off", "GOENV=off", "GOFLAGS=-mod=readonly", "GOPROXY=off", "GOSUMDB=off")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, "compile exact source resolver test binary: %s", output)
+	runner := devEngineContainer(c).
+		WithFile("/streamed-resolver.test", c.Host().File(testBinary), dagger.ContainerWithFileOpts{Permissions: 0755}).
+		WithEnvVariable("XDG_RUNTIME_DIR", "/tmp")
+	if builtin {
+		runner = runner.WithEnvVariable("CONTAINERD_DISABLE_IGZIP", "true").
+			WithEnvVariable("CONTAINERD_DISABLE_PIGZ", "true")
+	}
+	timeout := "90s"
+	if pattern == "^TestStreamedSnapshotRealPrivateLarge$" {
+		// Three larger race-instrumented payload-generation repetitions need
+		// a separate suite budget; all per-case/marker/cleanup gates stay fixed.
+		timeout = "3m"
+	}
+	outputText, err := runner.
+		WithExec([]string{"/streamed-resolver.test", "-test.v", "-test.count=" + strconv.Itoa(count), "-test.timeout=" + timeout, "-test.run=" + pattern}, dagger.ContainerWithExecOpts{InsecureRootCapabilities: true}).
+		Stdout(ctx)
+	t.Log(outputText)
+	require.NoError(t, err)
+	if strings.Contains(pattern, "TestStreamedFetch") {
+		require.Contains(t, outputText, "--- PASS: TestStreamedFetchStandardGzipApplier")
+		require.Contains(t, outputText, "--- PASS: TestStreamedFetchOptionalReaderContract")
+	}
+	require.Contains(t, outputText, "--- PASS: TestStreamedSnapshotRealPrivate")
+	if pattern == "^TestStreamedSnapshotRealPrivateLarge$" {
+		require.Contains(t, outputText, "--- PASS: TestStreamedSnapshotRealPrivateLarge (")
+	}
+}
diff --git a/engine/server/resolver/deferred_pull_test.go b/engine/server/resolver/deferred_pull_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..79aee57e3c68293d2dc2b944a87d4e13ef14f16f
--- /dev/null
+++ b/engine/server/resolver/deferred_pull_test.go
@@ -0,0 +1,237 @@
+package resolver
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/leases"
+	"github.com/containerd/containerd/v2/core/remotes/docker"
+	localcontent "github.com/containerd/containerd/v2/plugins/content/local"
+	cerrdefs "github.com/containerd/errdefs"
+	digest "github.com/opencontainers/go-digest"
+	"github.com/opencontainers/image-spec/specs-go"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+// Writer contexts are observed, not simulated as real containerd content-GC.
+// HTTP transfer, digest/size verification, local store commits and labels are real.
+type deferredPullTestStore struct {
+	content.Store
+	mu           sync.Mutex
+	writerLeases map[digest.Digest]string
+}
+
+func (s *deferredPullTestStore) Writer(ctx context.Context, opts ...content.WriterOpt) (content.Writer, error) {
+	var writerOpts content.WriterOpts
+	for _, opt := range opts {
+		if err := opt(&writerOpts); err != nil {
+			return nil, err
+		}
+	}
+	leaseID, _ := leases.FromContext(ctx)
+	s.mu.Lock()
+	s.writerLeases[writerOpts.Desc.Digest] = leaseID
+	s.mu.Unlock()
+	return s.Store.Writer(ctx, opts...)
+}
+
+type deferredPullTestFixture struct {
+	rslvr          *Resolver
+	store          *deferredPullTestStore
+	lm             *testLeaseManager
+	ref            string
+	layer          ocispecs.Descriptor
+	registryHost   string
+	mu             sync.Mutex
+	layerGETs      int
+	requestStarted chan struct{}
+}
+
+func newDeferredPullTestFixture(t *testing.T, bodyMode string) *deferredPullTestFixture {
+	t.Helper()
+	layerBytes := []byte("complete layer bytes used only for transfer verification")
+	layer := testDescriptor(ocispecs.MediaTypeImageLayer, layerBytes)
+	configBytes, err := json.Marshal(ocispecs.Image{Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}, RootFS: ocispecs.RootFS{Type: "layers", DiffIDs: []digest.Digest{layer.Digest}}})
+	require.NoError(t, err)
+	config := testDescriptor(ocispecs.MediaTypeImageConfig, configBytes)
+	manifestBytes, err := json.Marshal(ocispecs.Manifest{Versioned: specs.Versioned{SchemaVersion: 2}, MediaType: ocispecs.MediaTypeImageManifest, Config: config, Layers: []ocispecs.Descriptor{layer}})
+	require.NoError(t, err)
+	manifest := testDescriptor(ocispecs.MediaTypeImageManifest, manifestBytes)
+	f := &deferredPullTestFixture{lm: newTestLeaseManager(), layer: layer, requestStarted: make(chan struct{}, 1)}
+	registry := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.URL.Path == "/v2/":
+			w.WriteHeader(http.StatusOK)
+		case strings.HasPrefix(r.URL.Path, "/v2/pipeline/test/manifests/"):
+			serveTestRegistryDescriptor(w, r, manifest, manifestBytes)
+		case r.URL.Path == "/v2/pipeline/test/blobs/"+config.Digest.String():
+			serveTestRegistryDescriptor(w, r, config, configBytes)
+		case r.URL.Path == "/v2/pipeline/test/blobs/"+layer.Digest.String():
+			if bodyMode == "blocked" && r.Method == http.MethodGet {
+				f.requestStarted <- struct{}{}
+				<-r.Context().Done()
+				return
+			}
+			if r.Method == http.MethodGet {
+				f.mu.Lock()
+				f.layerGETs++
+				f.mu.Unlock()
+			}
+			payload := append([]byte(nil), layerBytes...)
+			if bodyMode == "corrupt" {
+				payload[0] ^= 1
+			}
+			if bodyMode == "truncated" {
+				payload = payload[:len(payload)-5]
+			}
+			serveTestRegistryDescriptor(w, r, layer, payload)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(registry.Close)
+	f.registryHost = strings.TrimPrefix(registry.URL, "http://")
+	store, err := localcontent.NewLabeledStore(t.TempDir(), newTestContentLabelStore())
+	require.NoError(t, err)
+	f.store = &deferredPullTestStore{Store: store, writerLeases: map[digest.Digest]string{}}
+	f.rslvr = New(Opts{Hosts: func(domain string) ([]docker.RegistryHost, error) {
+		if domain != f.registryHost {
+			return nil, fmt.Errorf("unexpected registry: %s", domain)
+		}
+		return []docker.RegistryHost{{Scheme: "http", Host: domain, Path: "/v2", Capabilities: docker.HostCapabilityPull | docker.HostCapabilityResolve}}, nil
+	}, ContentStore: f.store, LeaseManager: f.lm})
+	t.Cleanup(func() { require.NoError(t, f.rslvr.Close()) })
+	f.ref = fmt.Sprintf("%s/pipeline/test:latest@%s", f.registryHost, manifest.Digest)
+	return f
+}
+
+func TestDeferredPullMetadataThenVerifiedLayer(t *testing.T) {
+	f := newDeferredPullTestFixture(t, "valid")
+	ctx := t.Context()
+	pulled, err := f.rslvr.Pull(ctx, f.ref, PullOpts{DeferLayerDownload: true, Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, pulled.Release(context.Background())) })
+	require.NotNil(t, pulled.FetchLayer)
+	f.mu.Lock()
+	before := f.layerGETs
+	f.mu.Unlock()
+	require.Zero(t, before, "Pull must return without downloading layer content")
+	_, err = f.store.Info(ctx, f.layer.Digest)
+	require.True(t, cerrdefs.IsNotFound(err))
+	_, err = f.store.Info(ctx, pulled.ConfigDesc.Digest)
+	require.NoError(t, err)
+	_, err = f.store.Info(ctx, pulled.ManifestDesc.Digest)
+	require.NoError(t, err)
+	active, err := f.lm.List(ctx)
+	require.NoError(t, err)
+	f.store.mu.Lock()
+	pullLeaseID := f.store.writerLeases[pulled.ConfigDesc.Digest]
+	f.store.mu.Unlock()
+	require.NotEmpty(t, pullLeaseID)
+	var pullLeaseFound bool
+	for _, lease := range active {
+		if lease.ID == pullLeaseID {
+			pullLeaseFound = true
+		}
+	}
+	require.True(t, pullLeaseFound)
+	// A distinct caller lease proves the callback explicitly reinstalls its
+	// pull-content lease rather than capturing a canceled dispatch context.
+	require.NoError(t, pulled.FetchLayer(leases.WithLease(ctx, "caller-operation-lease"), pulled.Layers[0]))
+	info, err := f.store.Info(ctx, f.layer.Digest)
+	require.NoError(t, err)
+	sourceHost, _, err := net.SplitHostPort(f.registryHost)
+	require.NoError(t, err)
+	require.Equal(t, "pipeline/test", info.Labels["containerd.io/distribution.source."+sourceHost])
+	f.store.mu.Lock()
+	actualLease := f.store.writerLeases[f.layer.Digest]
+	f.store.mu.Unlock()
+	require.Equal(t, pullLeaseID, actualLease)
+	require.NoError(t, pulled.Release(context.Background()))
+	active, err = f.lm.List(ctx)
+	require.NoError(t, err)
+	for _, lease := range active {
+		require.NotEqual(t, pullLeaseID, lease.ID, "pull release must remove its own lease; independent metadata leases can remain")
+	}
+	// A complete content closure remains the pre-existing local fast path.
+	local, err := f.rslvr.Pull(ctx, f.ref, PullOpts{DeferLayerDownload: true, Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}})
+	require.NoError(t, err)
+	defer local.Release(context.Background())
+	require.Nil(t, local.FetchLayer)
+}
+
+func TestDeferredPullRejectsInvalidLayerTransfers(t *testing.T) {
+	for _, mode := range []string{"corrupt", "truncated"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newDeferredPullTestFixture(t, mode)
+			pulled, err := f.rslvr.Pull(t.Context(), f.ref, PullOpts{DeferLayerDownload: true, Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}})
+			require.NoError(t, err)
+			defer pulled.Release(context.Background())
+			require.Error(t, pulled.FetchLayer(t.Context(), pulled.Layers[0]))
+			_, err = f.store.Info(t.Context(), f.layer.Digest)
+			require.True(t, cerrdefs.IsNotFound(err), "invalid content must not commit")
+		})
+	}
+}
+
+func TestDeferredPullLayerLimitedStaysEager(t *testing.T) {
+	f := newDeferredPullTestFixture(t, "valid")
+	limit := 1
+	pulled, err := f.rslvr.Pull(t.Context(), f.ref, PullOpts{DeferLayerDownload: true, LayerLimit: &limit, Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}})
+	require.NoError(t, err)
+	defer pulled.Release(context.Background())
+	require.Nil(t, pulled.FetchLayer)
+	_, err = f.store.Info(t.Context(), f.layer.Digest)
+	require.NoError(t, err)
+}
+
+func TestDeferredPullForceKeepsDeferredContract(t *testing.T) {
+	f := newDeferredPullTestFixture(t, "valid")
+	for range 2 {
+		pulled, err := f.rslvr.Pull(t.Context(), f.ref, PullOpts{DeferLayerDownload: true, ResolveMode: ResolveModeForcePull, Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}})
+		require.NoError(t, err)
+		require.NotNil(t, pulled.FetchLayer)
+		require.NoError(t, pulled.FetchLayer(t.Context(), pulled.Layers[0]))
+		require.NoError(t, pulled.Release(context.Background()))
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	require.Equal(t, 1, f.layerGETs, "force metadata refresh must not duplicate a complete verified blob")
+}
+
+func TestDeferredPullLayerCancellation(t *testing.T) {
+	f := newDeferredPullTestFixture(t, "blocked")
+	ctx, timeout := context.WithTimeout(t.Context(), 10*time.Second)
+	defer timeout()
+	pulled, err := f.rslvr.Pull(ctx, f.ref, PullOpts{DeferLayerDownload: true, Platform: ocispecs.Platform{OS: "linux", Architecture: "amd64"}})
+	require.NoError(t, err)
+	defer pulled.Release(context.Background())
+	fetchCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- pulled.FetchLayer(fetchCtx, pulled.Layers[0]) }()
+	select {
+	case <-f.requestStarted:
+	case <-ctx.Done():
+		t.Fatal("HTTP layer request did not start")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		require.Error(t, err)
+	case <-ctx.Done():
+		t.Fatal("canceled fetch did not exit")
+	}
+	_, err = f.store.Info(ctx, f.layer.Digest)
+	require.True(t, cerrdefs.IsNotFound(err))
+}
