+package snapshots
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStreamedImportFinalStartsAfterParentCommit(t *testing.T) {
+	cm, sn, ctx := newPipelineTestManager(t)
+	parent, parentData := pipelineTestLayer("ordered-parent")
+	last, lastData := pipelineTestLayer("ordered-final")
+	cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+	var commits, streams atomic.Int64
+	sn.onCommit = func(string) { commits.Add(1) }
+	ref, err := cm.ImportImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{parent, last}}, ImportImageOpts{
+		FetchLayer: func(ctx context.Context, d ocispecs.Descriptor) error {
+			if d.Digest != parent.Digest {
+				return errors.New("final layer fetched outside private stream")
+			}
+			return pipelineTestWrite(ctx, cm, parent, parentData)
+		},
+		FetchLayerWhileApplying: func(ctx context.Context, d ocispecs.Descriptor, apply func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+			streams.Add(1)
+			if commits.Load() != 1 || d.Digest != last.Digest {
+				return ocispecs.Descriptor{}, errors.New("final stream started before its parent committed")
+			}
+			applied, err := apply(ctx, cm.ContentStore)
+			if err != nil {
+				return ocispecs.Descriptor{}, err
+			}
+			return applied, pipelineTestWrite(ctx, cm, last, lastData)
+		},
+	})
+	require.NoError(t, err)
+	require.NoError(t, ref.Release(ctx))
+	require.EqualValues(t, 1, streams.Load())
+	require.EqualValues(t, 2, commits.Load())
+}
+
+func TestStreamedImportIneligibleFinalUsesCompletePipeline(t *testing.T) {
+	for _, mode := range []string{"duplicate-final", "no-streaming-applier"} {
+		t.Run(mode, func(t *testing.T) {
+			cm, _, ctx := newPipelineTestManager(t)
+			layer, data := pipelineTestLayer(mode)
+			layers := []ocispecs.Descriptor{layer}
+			if mode == "duplicate-final" {
+				layers = append(layers, layer)
+				cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+			}
+			var fetches, streams atomic.Int64
+			ref, err := cm.ImportImage(ctx, &ImportedImage{Layers: layers}, ImportImageOpts{
+				FetchLayer: func(ctx context.Context, d ocispecs.Descriptor) error {
+					fetches.Add(1)
+					return pipelineTestWrite(ctx, cm, d, data)
+				},
+				FetchLayerWhileApplying: func(context.Context, ocispecs.Descriptor, func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+					streams.Add(1)
+					return ocispecs.Descriptor{}, errors.New("ineligible final must use complete-blob pipeline")
+				},
+			})
+			require.NoError(t, err)
+			require.NoError(t, ref.Release(ctx))
+			require.EqualValues(t, 1, fetches.Load())
+			require.Zero(t, streams.Load())
+		})
+	}
+}
+
+func TestStreamedImportConcurrentDuplicatePulls(t *testing.T) {
+	cm, _, ctx := newPipelineTestManager(t)
+	layer, data := pipelineTestLayer("concurrent-duplicate")
+	cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+	var streams, eager atomic.Int64
+	opts := ImportImageOpts{
+		FetchLayer: func(ctx context.Context, desc ocispecs.Descriptor) error {
+			eager.Add(1)
+			return pipelineTestWrite(ctx, cm, desc, data)
+		},
+		FetchLayerWhileApplying: func(ctx context.Context, desc ocispecs.Descriptor, apply func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+			streams.Add(1)
+			applied, err := apply(ctx, cm.ContentStore)
+			if err != nil {
+				return ocispecs.Descriptor{}, err
+			}
+			return applied, pipelineTestWrite(ctx, cm, desc, data)
+		},
+	}
+	start := make(chan struct{})
+	done := make(chan pipelineTestResult, 2)
+	for range 2 {
+		go func() {
+			if err := pipelineTestWait(ctx, start); err != nil {
+				done <- pipelineTestResult{err: err}
+				return
+			}
+			ref, err := cm.ImportImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{layer}}, opts)
+			done <- pipelineTestResult{ref, err}
+		}()
+	}
+	close(start)
+	first, second := pipelineTestFinish(t, ctx, done), pipelineTestFinish(t, ctx, done)
+	require.NoError(t, first.err)
+	require.NoError(t, second.err)
+	require.Equal(t, first.ref.SnapshotID(), second.ref.SnapshotID())
+	require.EqualValues(t, 1, streams.Load(), "only the locked importer may mutate a private snapshot")
+	require.EqualValues(t, 1, eager.Load(), "reused final must still acquire a verified blob")
+}
diff --git a/engine/snapshots/streamed_import_gc_test.go b/engine/snapshots/streamed_import_gc_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cf7770eb06ecff204e46e2d3ac99048dec02646c
--- /dev/null
+++ b/engine/snapshots/streamed_import_gc_test.go
@@ -0,0 +1,228 @@
+package snapshots
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/metadata"
+	"github.com/containerd/containerd/v2/core/mount"
+	ctdsnapshots "github.com/containerd/containerd/v2/core/snapshots"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	localcontent "github.com/containerd/containerd/v2/plugins/content/local"
+	"github.com/containerd/containerd/v2/plugins/snapshots/native"
+	"github.com/containerd/errdefs"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+// Real metadata DB, native snapshots, content and leases. Only the mount and
+// applier are test doubles: this validates ownership/GC at the private-stream
+// callback boundary, not real mounted streaming or engine restart behavior.
+type streamGCTestSnapshotter struct{ imageGCTestSnapshotter }
+
+func (sn streamGCTestSnapshotter) Mounts(ctx context.Context, key string) (MountableRef, error) {
+	_, err := sn.Stat(ctx, key)
+	return streamGCTestMount{}, err
+}
+
+type streamGCTestMount struct{}
+
+func (streamGCTestMount) Mount() ([]mount.Mount, func() error, error) {
+	return nil, func() error { return nil }, nil
+}
+
+func TestStreamedImportPrivateStateRealContainerdGC(t *testing.T) {
+	for _, phase := range []string{"ingest-blocked", "verified-blob-blocked"} {
+		for _, outcome := range []string{"callback-error", "caller-cancel", "success-owner-rehydrate"} {
+			t.Run(phase+"/"+outcome, func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(namespaces.WithNamespace(t.Context(), "verified-stream-gc"), 10*time.Second)
+				defer cancel()
+				store, err := localcontent.NewStore(filepath.Join(t.TempDir(), "content"))
+				require.NoError(t, err)
+				nativeSN, err := native.NewSnapshotter(filepath.Join(t.TempDir(), "native"))
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, nativeSN.Close()) })
+				boltDB, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, boltDB.Close()) })
+				mdb := metadata.NewDB(boltDB, store, map[string]ctdsnapshots.Snapshotter{"native": nativeSN})
+				require.NoError(t, mdb.Init(ctx))
+				lm := metadata.NewLeaseManager(mdb)
+				sn := streamGCTestSnapshotter{imageGCTestSnapshotter{mdb.Snapshotter("native")}}
+				cm := newApplySnapshotDiffTestManager(t)
+				cm.Snapshotter, cm.ContentStore, cm.LeaseManager = sn, mdb.ContentStore(), lm
+				cm.Applier = pipelineTestApplier(func(context.Context, ocispecs.Descriptor) error { return nil })
+				cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+				parent, parentData := pipelineTestLayer("gc-parent")
+				last, lastData := pipelineTestLayer("gc-private-last")
+				old, oldCtx, err := NewLease(ctx, lm)
+				require.NoError(t, err)
+				const parentID = "verified-stream-gc-parent"
+				require.NoError(t, sn.Prepare(oldCtx, "active-parent", ""))
+				require.NoError(t, sn.Commit(oldCtx, parentID, "active-parent"))
+				require.NoError(t, pipelineTestWrite(oldCtx, cm, parent, parentData))
+				require.NoError(t, cm.LoadPersistentMetadata(PersistentMetadataRows{
+					SnapshotContent: []SnapshotContentRow{{SnapshotID: parentID, Digest: parent.Digest}},
+					ImportedByBlob:  []ImportedLayerBlobRow{{BlobDigest: parent.Digest, SnapshotID: parentID}},
+				}))
+				operationCtx, releaseOperation, err := WithLazyLease(ctx, lm)
+				require.NoError(t, err)
+				defer releaseOperation(context.WithoutCancel(ctx))
+				operationCtx, cancelOperation := context.WithCancelCause(operationCtx)
+				defer cancelOperation(nil)
+				pull, pullCtx, err := NewLease(ctx, lm)
+				require.NoError(t, err)
+				defer func() { _ = lm.Delete(context.WithoutCancel(ctx), pull.l) }()
+				entered, proceed := make(chan struct{}), make(chan struct{})
+				done := make(chan pipelineTestResult, 1)
+				sentinel := errors.New("private callback failure after real GC")
+				go func() {
+					ref, err := cm.ImportImage(operationCtx, &ImportedImage{Layers: []ocispecs.Descriptor{parent, last}}, ImportImageOpts{
+						FetchLayer: func(_ context.Context, d ocispecs.Descriptor) error {
+							if d.Digest != parent.Digest {
+								return errors.New("final layer must not be fetched eagerly")
+							}
+							return nil
+						},
+						FetchLayerWhileApplying: func(applyCtx context.Context, desc ocispecs.Descriptor, apply func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+							applied, err := apply(applyCtx, cm.ContentStore)
+							if err != nil {
+								return ocispecs.Descriptor{}, err
+							}
+							// The resolver's ordinary pull lease protects an incomplete
+							// ingest too, not only the blob after its commit.
+							var writer content.Writer
+							if phase == "ingest-blocked" {
+								writer, err = cm.ContentStore.Writer(pullCtx, content.WithRef("stream-gc-ingest"), content.WithDescriptor(desc))
+								if err != nil {
+									return ocispecs.Descriptor{}, err
+								}
+								defer writer.Close()
+								if _, err := writer.Write(lastData[:len(lastData)/2]); err != nil {
+									return ocispecs.Descriptor{}, err
+								}
+							} else {
+								if err := pipelineTestWrite(pullCtx, cm, desc, lastData); err != nil {
+									return ocispecs.Descriptor{}, err
+								}
+							}
+							close(entered)
+							if err := pipelineTestWait(applyCtx, proceed); err != nil {
+								return ocispecs.Descriptor{}, err
+							}
+							if outcome == "callback-error" {
+								return ocispecs.Descriptor{}, sentinel
+							}
+							if writer != nil {
+								if _, err := writer.Write(lastData[len(lastData)/2:]); err != nil {
+									return ocispecs.Descriptor{}, err
+								}
+								if err := writer.Commit(pullCtx, desc.Size, desc.Digest); err != nil {
+									return ocispecs.Descriptor{}, err
+								}
+							}
+							return applied, nil
+						},
+					})
+					done <- pipelineTestResult{ref, err}
+				}()
+				require.NoError(t, pipelineTestWait(ctx, entered))
+				var privateID string
+				require.NoError(t, sn.Walk(ctx, func(_ context.Context, info ctdsnapshots.Info) error {
+					if info.Kind == ctdsnapshots.KindActive {
+						privateID = info.Name
+					}
+					return nil
+				}))
+				require.NotEmpty(t, privateID)
+				require.NoError(t, lm.Delete(ctx, old.l))
+				_, err = mdb.GarbageCollect(ctx)
+				require.NoError(t, err)
+				info, err := sn.Stat(ctx, privateID)
+				require.NoError(t, err, "operation lease must retain the active private snapshot")
+				require.Equal(t, ctdsnapshots.KindActive, info.Kind)
+				require.Equal(t, parentID, info.Parent)
+				_, err = sn.Stat(ctx, parentID)
+				require.NoError(t, err, "operation lease must retain the reused parent")
+				for _, d := range []ocispecs.Descriptor{parent, last} {
+					_, err = cm.ContentStore.Info(ctx, d.Digest)
+					if phase == "ingest-blocked" && d.Digest == last.Digest {
+						require.True(t, errdefs.IsNotFound(err), "incomplete ingest must not appear as committed content")
+						status, err := cm.ContentStore.Status(ctx, "stream-gc-ingest")
+						require.NoError(t, err, "pull lease must retain incomplete ingest across GC")
+						require.EqualValues(t, len(lastData)/2, status.Offset)
+					} else {
+						require.NoError(t, err, "operation/pull leases must retain content")
+					}
+				}
+				cm.mu.Lock()
+				privateIndexed := cm.importedLayerByBlob[ImportedLayerBlobKey{ParentSnapshotID: parentID, BlobDigest: last.Digest}]
+				cm.mu.Unlock()
+				require.Empty(t, privateIndexed, "private snapshot cannot enter reuse index before callback succeeds")
+				if outcome == "caller-cancel" {
+					cancelOperation(sentinel)
+				} else {
+					close(proceed)
+				}
+				got := pipelineTestFinish(t, ctx, done)
+				var resultID string
+				if outcome == "success-owner-rehydrate" {
+					require.NoError(t, got.err)
+					require.NotNil(t, got.ref)
+					resultID = got.ref.SnapshotID()
+					require.NoError(t, cm.AttachLease(ctx, "verified-stream-owner", resultID))
+				} else {
+					require.ErrorIs(t, got.err, sentinel)
+					require.Nil(t, got.ref)
+					cm.mu.Lock()
+					_, privateRecordExists := cm.records[privateID]
+					cm.mu.Unlock()
+					require.False(t, privateRecordExists, "failure must release Dagger mutable metadata")
+				}
+				require.NoError(t, releaseOperation(ctx))
+				require.NoError(t, lm.Delete(ctx, pull.l))
+				_, err = mdb.GarbageCollect(ctx)
+				require.NoError(t, err)
+				_, err = sn.Stat(ctx, privateID)
+				require.True(t, errdefs.IsNotFound(err), "released private state must be reclaimed by normal GC")
+				if phase == "ingest-blocked" {
+					_, err = cm.ContentStore.Status(ctx, "stream-gc-ingest")
+					require.True(t, errdefs.IsNotFound(err), "failed ingest must be reclaimed after pull lease release")
+				}
+				if outcome == "success-owner-rehydrate" {
+					// Rehydrate a fresh manager from persisted rows, not a process or
+					// engine restart. The existing owner lease must retain the closure.
+					fresh := newApplySnapshotDiffTestManager(t)
+					fresh.Snapshotter, fresh.ContentStore, fresh.LeaseManager = sn, mdb.ContentStore(), lm
+					require.NoError(t, fresh.LoadPersistentMetadata(cm.PersistentMetadataRows()))
+					ref, err := fresh.GetBySnapshotID(ctx, resultID)
+					require.NoError(t, err)
+					require.NoError(t, ref.Release(ctx))
+					_, err = sn.Stat(ctx, parentID)
+					require.NoError(t, err)
+					for _, d := range []ocispecs.Descriptor{parent, last} {
+						_, err = cm.ContentStore.Info(ctx, d.Digest)
+						require.NoError(t, err, "owner lease must retain imported content after operation exit")
+					}
+					require.NoError(t, cm.RemoveLease(ctx, "verified-stream-owner"))
+					_, err = mdb.GarbageCollect(ctx)
+					require.NoError(t, err)
+					_, err = sn.Stat(ctx, resultID)
+					require.True(t, errdefs.IsNotFound(err))
+				}
+				_, err = sn.Stat(ctx, parentID)
+				require.True(t, errdefs.IsNotFound(err))
+				for _, d := range []ocispecs.Descriptor{parent, last} {
+					_, err = cm.ContentStore.Info(ctx, d.Digest)
+					require.True(t, errdefs.IsNotFound(err), "temporary leases must not become permanent ownership")
+				}
+			})
+		}
+	}
+}
