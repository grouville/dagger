index 0000000000000000000000000000000000000000..8faa2a915a0821bfb5e569c7510d86f434b9557a
--- /dev/null
+++ b/engine/server/resolver/streamed_fetch.go
@@ -0,0 +1,257 @@
+package resolver
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/remotes"
+	"github.com/containerd/errdefs"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// This is an experimental seam wired into final-layer import. The callback may only apply into an
+// exclusively owned, uncommitted snapshot. It must not execute, publish, or
+// retain any reader or snapshot. The caller must not commit that snapshot until
+// this function AND distribution-source labeling have succeeded.
+//
+// The complete blob still goes through containerd's ordinary verified content
+// writer. The extra pipe is bounded by the producer/consumer buffers and writes
+// no second compressed file. Existing blobs and resumed ingests use the ordinary
+// complete-blob reader. Fetch and application are joined on every return path.
+//
+// The private handle exposes containerd's optional Reader() streaming contract,
+// which the current filesystem applier requests through content.NewReader.
+// ReadAt is explicitly unsupported: this is not a random-access content store.
+func fetchLayerWhileApplying(
+	ctx context.Context,
+	ingester content.Ingester,
+	verified content.Provider,
+	fetcher remotes.Fetcher,
+	desc ocispecs.Descriptor,
+	apply func(context.Context, content.Provider) (ocispecs.Descriptor, error),
+) (ocispecs.Descriptor, error) {
+	if desc.Size <= 0 || desc.Digest.Validate() != nil || apply == nil {
+		return ocispecs.Descriptor{}, fmt.Errorf("streamed layer: invalid descriptor or apply callback")
+	}
+	expectedDiff := digest.Digest(desc.Annotations["containerd.io/uncompressed"])
+	if err := expectedDiff.Validate(); err != nil {
+		return ocispecs.Descriptor{}, fmt.Errorf("streamed layer: invalid expected diffID: %w", err)
+	}
+	ctx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	pr, pw := io.Pipe()
+	defer pr.Close()
+	defer pw.Close()
+	stop := context.AfterFunc(ctx, func() {
+		cause := context.Cause(ctx)
+		_ = pr.CloseWithError(cause)
+		_ = pw.CloseWithError(cause)
+	})
+	defer stop()
+
+	type result struct {
+		desc ocispecs.Descriptor
+		err  error
+	}
+	done := make(chan result, 1)
+	runApply := func(provider content.Provider) result {
+		applied, err := apply(ctx, provider)
+		if err == nil && applied.Digest != expectedDiff {
+			err = fmt.Errorf("streamed layer: calculated diffID %s does not match %s", applied.Digest, expectedDiff)
+		}
+		if err != nil {
+			cancel(err)
+		}
+		return result{applied, err}
+	}
+	tap := &streamTapIngester{Ingester: ingester, desc: desc, pw: pw}
+	tap.start = func() {
+		go func() {
+			res := runApply(&privateSequentialProvider{desc: desc, reader: &privateStreamReader{reader: pr, size: desc.Size}})
+			// A decompressor may accept the tar end before reading all compressed
+			// bytes. Close the consumer but let the normal writer verify all bytes.
+			if res.err == nil {
+				_ = pr.CloseWithError(errPrivateConsumerFinished)
+			} else {
+				_ = pr.CloseWithError(res.err)
+			}
+			done <- res
+		}()
+	}
+
+	_, fetchErr := remotes.FetchHandler(tap, fetcher)(ctx, desc)
+	if fetchErr != nil {
+		cancel(fetchErr)
+	}
+	_ = pw.CloseWithError(fetchErr)
+	if !tap.started {
+		if fetchErr != nil {
+			return ocispecs.Descriptor{}, fetchErr
+		}
+		res := runApply(verified)
+		if err := errors.Join(res.err, context.Cause(ctx)); err != nil {
+			return ocispecs.Descriptor{}, err
+		}
+		return res.desc, nil
+	}
+	res := <-done
+	if err := errors.Join(fetchErr, res.err, context.Cause(ctx)); err != nil {
+		return ocispecs.Descriptor{}, err
+	}
+	return res.desc, nil
+}
+
+var errPrivateConsumerFinished = errors.New("private layer consumer finished")
+
+type streamTapIngester struct {
+	content.Ingester
+	desc    ocispecs.Descriptor
+	pw      *io.PipeWriter
+	start   func()
+	started bool // Writer is called only by the single synchronous FetchHandler.
+}
+
+func (s *streamTapIngester) Writer(ctx context.Context, opts ...content.WriterOpt) (content.Writer, error) {
+	w, err := s.Ingester.Writer(ctx, opts...)
+	if err != nil {
+		return nil, err
+	}
+	status, err := w.Status()
+	if err != nil {
+		_ = w.Close()
+		return nil, err
+	}
+	// Keep containerd's normal resume implementation, including range/seek
+	// behavior. A private consumer cannot start in the middle of a gzip stream.
+	if status.Offset != 0 {
+		return w, nil
+	}
+	if s.started {
+		_ = w.Close()
+		return nil, fmt.Errorf("streamed layer: second writer refused")
+	}
+	s.started = true
+	s.start()
+	return &streamTapWriter{Writer: w, pw: s.pw}, nil
+}
+
+type streamTapWriter struct {
+	content.Writer
+	pw *io.PipeWriter
+}
+
+func (w *streamTapWriter) Write(p []byte) (int, error) {
+	n, err := w.Writer.Write(p)
+	if errors.Is(err, content.ErrReset) {
+		// Replaying an ingest into an already-mutated private snapshot is not
+		// safe. Do not expose ErrReset to content.Copy's transparent replay.
+		return n, fmt.Errorf("streamed layer: writer reset requires a fresh private snapshot")
+	}
+	if n > 0 && err == nil {
+		_, pipeErr := w.pw.Write(p[:n])
+		if pipeErr != nil && !errors.Is(pipeErr, errPrivateConsumerFinished) {
+			return n, pipeErr
+		}
+	}
+	return n, err
+}
+
+func (w *streamTapWriter) Commit(ctx context.Context, size int64, expected digest.Digest, opts ...content.Opt) error {
+	err := w.Writer.Commit(ctx, size, expected, opts...)
+	if errors.Is(err, content.ErrReset) {
+		return fmt.Errorf("streamed layer: commit reset requires a fresh private snapshot")
+	}
+	return err
+}
+
+func (w *streamTapWriter) Truncate(int64) error {
+	return fmt.Errorf("streamed layer: truncate requires a fresh private snapshot")
+}
+
+type privateSequentialProvider struct {
+	desc   ocispecs.Descriptor
+	reader *privateStreamReader
+	mu     sync.Mutex
+	opened bool
+}
+
+func (p *privateSequentialProvider) ReaderAt(_ context.Context, desc ocispecs.Descriptor) (content.ReaderAt, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if desc.Digest != p.desc.Digest {
+		return nil, fmt.Errorf("private stream descriptor mismatch: %w", errdefs.ErrNotFound)
+	}
+	if p.opened {
+		return nil, fmt.Errorf("private stream permits one sequential reader")
+	}
+	p.opened = true
+	return p.reader, nil
+}
+
+type privateStreamReader struct {
+	reader io.ReadCloser
+	mu     sync.Mutex
+	opened bool
+	size   int64
+
+	readMu    sync.Mutex
+	closed    bool
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func (r *privateStreamReader) Size() int64 { return r.size }
+
+func (r *privateStreamReader) Close() error {
+	r.closeOnce.Do(func() {
+		// This reader owns the private pipe. Interrupt it before joining an
+		// active read, including when extraction fails while input is blocked.
+		// Closing private consumption is not a successful verification result:
+		// the fetcher must still verify all bytes, or fail on apply cancellation.
+		if pipe, ok := r.reader.(interface{ CloseWithError(error) error }); ok {
+			r.closeErr = pipe.CloseWithError(errPrivateConsumerFinished)
+		} else {
+			r.closeErr = r.reader.Close()
+		}
+		r.readMu.Lock()
+		r.closed = true
+		r.readMu.Unlock()
+	})
+	return r.closeErr
+}
+
+func (r *privateStreamReader) Read(p []byte) (int, error) {
+	r.readMu.Lock()
+	defer r.readMu.Unlock()
+	if r.closed {
+		return 0, io.ErrClosedPipe
+	}
+	return r.reader.Read(p)
+}
+
+// Reader is the optional streaming fast path consumed by content.NewReader.
+// Preserve the exact descriptor-size bound of its SectionReader fallback.
+func (r *privateStreamReader) Reader() io.Reader {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.opened {
+		return privateStreamReadError{fmt.Errorf("private stream permits one Reader() consumer: %w", errdefs.ErrNotImplemented)}
+	}
+	r.opened = true
+	return io.LimitReader(r, r.size)
+}
+
+func (*privateStreamReader) ReadAt([]byte, int64) (int, error) {
+	return 0, fmt.Errorf("private sequential stream does not support ReadAt; consumer must use content.NewReader: %w", errdefs.ErrNotImplemented)
+}
+
+type privateStreamReadError struct{ err error }
+
+func (r privateStreamReadError) Read([]byte) (int, error) {
+	return 0, r.err
+}
