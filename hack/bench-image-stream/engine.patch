+package resolver
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"sync/atomic"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/content"
+	localcontent "github.com/containerd/containerd/v2/plugins/content/local"
+	"github.com/containerd/errdefs"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+type streamResetIngester struct {
+	content.Ingester
+	commit bool
+	writes atomic.Int64
+}
+
+func (s *streamResetIngester) Writer(ctx context.Context, opts ...content.WriterOpt) (content.Writer, error) {
+	w, err := s.Ingester.Writer(ctx, opts...)
+	if err != nil {
+		return nil, err
+	}
+	return &streamResetWriter{Writer: w, owner: s}, nil
+}
+
+type streamResetWriter struct {
+	content.Writer
+	owner *streamResetIngester
+}
+
+func (w *streamResetWriter) Write(p []byte) (int, error) {
+	w.owner.writes.Add(1)
+	if !w.owner.commit {
+		return 0, content.ErrReset
+	}
+	return w.Writer.Write(p)
+}
+
+func (w *streamResetWriter) Commit(context.Context, int64, digest.Digest, ...content.Opt) error {
+	return content.ErrReset
+}
+
+func TestStreamedFetchResetDoesNotReplayPrivateSnapshot(t *testing.T) {
+	for _, phase := range []string{"write", "commit"} {
+		t.Run(phase, func(t *testing.T) {
+			ctx := streamTestContext(t)
+			store, err := localcontent.NewStore(t.TempDir())
+			require.NoError(t, err)
+			data := bytes.Repeat([]byte("no-private-replay"), 1024)
+			desc := streamTestDescriptor(data)
+			ingester := &streamResetIngester{Ingester: store, commit: phase == "commit"}
+			var applies atomic.Int64
+			result, err := fetchLayerWhileApplying(ctx, ingester, store, streamTestFetcher(data), desc,
+				func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+					applies.Add(1)
+					return streamTestConsume(desc)(ctx, p)
+				})
+			require.ErrorContains(t, err, "reset requires a fresh private snapshot")
+			require.False(t, errors.Is(err, content.ErrReset), "must not trigger containerd's transparent replay")
+			require.Empty(t, result.Digest)
+			require.EqualValues(t, 1, applies.Load())
+			require.EqualValues(t, 1, ingester.writes.Load())
+			_, err = store.Info(ctx, desc.Digest)
+			require.True(t, errdefs.IsNotFound(err))
+		})
+	}
+}
+
+func TestStreamedFetchUnsupportedReaderFailsAndJoins(t *testing.T) {
+	for _, mode := range []string{"seek", "repeated-reader"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := streamTestContext(t)
+			store, err := localcontent.NewStore(t.TempDir())
+			require.NoError(t, err)
+			data := bytes.Repeat([]byte("one-sequential-consumer"), 1024)
+			desc := streamTestDescriptor(data)
+			var joined atomic.Bool
+			result, err := fetchLayerWhileApplying(ctx, store, store, streamTestFetcher(data), desc,
+				func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+					defer joined.Store(true)
+					r, err := p.ReaderAt(ctx, desc)
+					if err != nil {
+						return ocispecs.Descriptor{}, err
+					}
+					defer r.Close()
+					if mode == "seek" {
+						_, err = r.ReadAt(make([]byte, 1), 1)
+					} else {
+						_, err = p.ReaderAt(ctx, desc)
+					}
+					return ocispecs.Descriptor{}, err
+				})
+			require.ErrorContains(t, err, "sequential")
+			require.Empty(t, result.Digest)
+			require.True(t, joined.Load())
+		})
+	}
+}
+
+type streamCancelledReader struct {
+	ctx     context.Context
+	entered chan struct{}
+	closed  *atomic.Bool
+}
+
+func (r *streamCancelledReader) Read([]byte) (int, error) {
+	close(r.entered)
+	<-r.ctx.Done()
+	return 0, context.Cause(r.ctx)
+}
+
+func (r *streamCancelledReader) Close() error { r.closed.Store(true); return nil }
+
+func TestStreamedFetchCallerCancellationJoinsBlockedReader(t *testing.T) {
+	deadline := streamTestContext(t)
+	ctx, cancel := context.WithCancelCause(deadline)
+	defer cancel(nil)
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	entered := make(chan struct{})
+	var fetchClosed, applyJoined atomic.Bool
+	desc := streamTestDescriptor([]byte("caller-cancel"))
+	fetcher := streamedFetchFunc(func(ctx context.Context, _ ocispecs.Descriptor) (io.ReadCloser, error) {
+		return &streamCancelledReader{ctx: ctx, entered: entered, closed: &fetchClosed}, nil
+	})
+	done := make(chan error, 1)
+	go func() {
+		_, err := fetchLayerWhileApplying(ctx, store, store, fetcher, desc,
+			func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+				defer applyJoined.Store(true)
+				return streamTestConsume(desc)(ctx, p)
+			})
+		done <- err
+	}()
+	streamTestAwait(t, deadline, entered)
+	sentinel := errors.New("caller cancelled blocked streamed download")
+	cancel(sentinel)
+	select {
+	case err := <-done:
+		require.ErrorIs(t, err, sentinel)
+	case <-deadline.Done():
+		t.Fatal("stream workers did not join after caller cancellation")
+	}
+	require.True(t, fetchClosed.Load())
+	require.True(t, applyJoined.Load())
+}
+
+func TestStreamedFetchExistingWrongDiffReturnsNoDescriptor(t *testing.T) {
+	ctx := streamTestContext(t)
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	data := []byte("verified-existing-blob")
+	desc := streamTestDescriptor(data)
+	require.NoError(t, content.WriteBlob(ctx, store, desc.Digest.String(), bytes.NewReader(data), desc))
+	desc.Annotations["containerd.io/uncompressed"] = digest.FromString("wrong expected diff").String()
+	result, err := fetchLayerWhileApplying(ctx, store, store, streamTestFetcher(data), desc, streamTestConsume(desc))
+	require.ErrorContains(t, err, "calculated diffID")
+	require.Empty(t, result.Digest, "failed eager fallback fence must not return an applied descriptor")
+}
