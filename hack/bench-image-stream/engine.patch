+package snapshots
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/leases"
+	localcontent "github.com/containerd/containerd/v2/plugins/content/local"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+// Source-only regression test for the image pipeline review. Copy into
+// engine/snapshots before running the focused package test. It intentionally
+// asserts the missing retention contract and has not been compiled or run.
+func TestImportImageLayerReusePinsOperationLease(t *testing.T) {
+	for _, lookup := range []string{"blob", "diff"} {
+		t.Run(lookup, func(t *testing.T) {
+			cm := newApplySnapshotDiffTestManager(t)
+			seedImageReuseTestContent(t, cm, "compressed-layer")
+			const snapshotID = "reusable-image-parent"
+			oldHandle := addApplySnapshotDiffTestImmutable(t, cm, snapshotID)
+			t.Cleanup(func() { require.NoError(t, oldHandle.Release(context.Background())) })
+			blob := digest.FromString("compressed-layer")
+			diffID := digest.FromString("uncompressed-layer")
+			desc := ocispecs.Descriptor{
+				Digest:      blob,
+				MediaType:   ocispecs.MediaTypeImageLayerGzip,
+				Annotations: map[string]string{"containerd.io/uncompressed": diffID.String()},
+			}
+			if lookup == "blob" {
+				cm.importedLayerByBlob[ImportedLayerBlobKey{BlobDigest: blob}] = snapshotID
+			} else {
+				cm.importedLayerByDiff[ImportedLayerDiffKey{DiffID: diffID}] = snapshotID
+			}
+			cm.snapshotContentDigests[snapshotID] = map[digest.Digest]struct{}{blob: {}}
+			const oldOwner = "dagql/result/prunable-parent/rootfs"
+			require.NoError(t, cm.AttachLease(t.Context(), oldOwner, snapshotID))
+
+			ctx, release, err := WithLazyLease(t.Context(), cm.LeaseManager, MakeTemporary)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, release(context.Background())) })
+			ref, err := cm.importImageLayer(ctx, desc, nil, ImportImageOpts{})
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, ref.Release(context.Background())) })
+			require.Equal(t, snapshotID, ref.SnapshotID())
+
+			// At this boundary the pipeline may wait for an arbitrarily slow
+			// next download. Releasing another result's owner must be safe.
+			require.NoError(t, cm.RemoveLease(t.Context(), oldOwner))
+			leaseCtx, err := EnsureLease(ctx)
+			require.NoError(t, err)
+			leaseID, ok := leases.FromContext(leaseCtx)
+			require.True(t, ok)
+			resources, err := cm.LeaseManager.ListResources(leaseCtx, leases.Lease{ID: leaseID})
+			require.NoError(t, err)
+			require.Contains(t, resources, leases.Resource{Type: "snapshots/test", ID: snapshotID},
+				"a reused parent must be pinned before the pipeline waits for its next layer")
+		})
+	}
+}
+
+// Exercise the exact ordered-import wait seam used by ImportImage. The first
+// layer is reused, the later fetch readiness is blocked by a channel, and the
+// former owner's lease is removed before a deterministic fake lease-GC pass.
+// This tests retention; it is not a real containerd GC or transfer test.
+func TestImportImageReuseSurvivesLaterFetchWait(t *testing.T) {
+	for _, lookup := range []string{"blob", "diff"} {
+		for _, leaseMode := range []string{"lazy", "materialized"} {
+			t.Run(lookup+"/"+leaseMode, func(t *testing.T) {
+				cm := newApplySnapshotDiffTestManager(t)
+				seedImageReuseTestContent(t, cm, "existing-base-blob")
+				const snapshotID = "parent-waiting-for-later-download"
+				oldHandle := addApplySnapshotDiffTestImmutable(t, cm, snapshotID)
+				t.Cleanup(func() { require.NoError(t, oldHandle.Release(context.Background())) })
+				blob := digest.FromString("existing-base-blob")
+				diffID := digest.FromString("existing-base-diff")
+				first := ocispecs.Descriptor{
+					Digest:      blob,
+					MediaType:   ocispecs.MediaTypeImageLayerGzip,
+					Annotations: map[string]string{"containerd.io/uncompressed": diffID.String()},
+				}
+				second := ocispecs.Descriptor{Digest: digest.FromString("blocked-later-download")}
+				if lookup == "blob" {
+					cm.importedLayerByBlob[ImportedLayerBlobKey{BlobDigest: blob}] = snapshotID
+				} else {
+					cm.importedLayerByDiff[ImportedLayerDiffKey{DiffID: diffID}] = snapshotID
+				}
+				cm.snapshotContentDigests[snapshotID] = map[digest.Digest]struct{}{blob: {}}
+				const oldOwner = "dagql/result/old-image/rootfs"
+				require.NoError(t, cm.AttachLease(t.Context(), oldOwner, snapshotID))
+
+				ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+				defer cancel()
+				ctx, release, err := WithLazyLease(ctx, cm.LeaseManager, func(l *leases.Lease) error {
+					if l.Labels == nil {
+						l.Labels = map[string]string{}
+					}
+					l.Labels["test.operation-label"] = "must-survive"
+					return nil
+				})
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, release(context.Background())) })
+				if leaseMode == "materialized" {
+					ctx, err = EnsureLease(ctx)
+					require.NoError(t, err)
+				}
+
+				waitingForLaterFetch := make(chan struct{})
+				finishLaterFetch := make(chan struct{})
+				fetchErr := errors.New("later fetch failed after parent retention check")
+				type result struct {
+					ref ImmutableRef
+					err error
+				}
+				done := make(chan result, 1)
+				go func() {
+					ref, err := cm.importImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{first, second}}, ImportImageOpts{},
+						func(waitCtx context.Context, desc ocispecs.Descriptor) error {
+							if desc.Digest != second.Digest {
+								return nil
+							}
+							close(waitingForLaterFetch)
+							select {
+							case <-finishLaterFetch:
+								return fetchErr
+							case <-waitCtx.Done():
+								return context.Cause(waitCtx)
+							}
+						})
+					done <- result{ref, err}
+				}()
+				select {
+				case <-waitingForLaterFetch:
+				case result := <-done:
+					t.Fatalf("import ended before the gated fetch: %v", result.err)
+				case <-ctx.Done():
+					t.Fatal(context.Cause(ctx))
+				}
+				require.NoError(t, cm.RemoveLease(ctx, oldOwner))
+				collectUnleasedImageTestSnapshots(cm)
+				_, retainedErr := cm.Snapshotter.Stat(ctx, snapshotID)
+				close(finishLaterFetch)
+				var got result
+				select {
+				case got = <-done:
+				case <-ctx.Done():
+					t.Fatal(context.Cause(ctx))
+				}
+				require.NoError(t, retainedErr, "old-owner pruning reclaimed a parent while its next fetch was blocked")
+				require.Nil(t, got.ref)
+				require.ErrorIs(t, got.err, fetchErr)
+
+				leaseCtx, err := EnsureLease(ctx)
+				require.NoError(t, err)
+				leaseID, ok := leases.FromContext(leaseCtx)
+				require.True(t, ok)
+				resources, err := cm.LeaseManager.ListResources(ctx, leases.Lease{ID: leaseID})
+				require.NoError(t, err)
+				require.Contains(t, resources, leases.Resource{ID: blob.String(), Type: "content"})
+				lm := cm.LeaseManager.(*applySnapshotDiffTestLeaseManager)
+				lm.mu.Lock()
+				labels := lm.leases[leaseID].Labels
+				lm.mu.Unlock()
+				require.Equal(t, map[string]string{"test.operation-label": "must-survive", "containerd.io/gc.expire": labels["containerd.io/gc.expire"]}, labels)
+				require.NotEmpty(t, labels["containerd.io/gc.expire"])
+				cm.mu.Lock()
+				_, ownerTracked := cm.snapshotOwnerLeases[snapshotID][leaseID]
+				cm.mu.Unlock()
+				require.False(t, ownerTracked, "operation retention must not enter result-owner bookkeeping")
+			})
+		}
+	}
+}
+
+func collectUnleasedImageTestSnapshots(cm *snapshotManager) {
+	lm := cm.LeaseManager.(*applySnapshotDiffTestLeaseManager)
+	sn := cm.Snapshotter.(*applySnapshotDiffTestSnapshotter)
+	lm.mu.Lock()
+	sn.mu.Lock()
+	defer lm.mu.Unlock()
+	defer sn.mu.Unlock()
+	retained := map[string]bool{}
+	for _, resources := range lm.resources {
+		for _, resource := range resources {
+			if resource.Type != "snapshots/"+sn.Name() {
+				continue
+			}
+			for id := resource.ID; id != "" && !retained[id]; id = sn.snapshots[id].Parent {
+				retained[id] = true
+			}
+		}
+	}
+	for id := range sn.snapshots {
+		if !retained[id] {
+			delete(sn.snapshots, id)
+		}
+	}
+}
+
+func seedImageReuseTestContent(t *testing.T, cm *snapshotManager, payload string) {
+	t.Helper()
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	cm.ContentStore = store
+	desc := ocispecs.Descriptor{Digest: digest.FromString(payload), Size: int64(len(payload))}
+	require.NoError(t, pipelineTestWrite(t.Context(), cm, desc, []byte(payload)))
+}
