new file mode 100644
index 0000000000000000000000000000000000000000..1878e4533d4d2b0735aeec3e1c5a3c46501afdf8
--- /dev/null
+++ b/engine/snapshots/pull_pipeline.go
@@ -0,0 +1,102 @@
+package snapshots
+
+import (
+	"context"
+	"errors"
+
+	"github.com/containerd/containerd/v2/core/content"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"golang.org/x/sync/errgroup"
+)
+
+// ImportImage overlaps complete, verified layer downloads with ordered layer
+// application. No fetch or snapshot work is left running after it returns.
+func (cm *snapshotManager) ImportImage(
+	ctx context.Context,
+	img *ImportedImage,
+	opts ImportImageOpts,
+) (ImmutableRef, error) {
+	if img == nil || opts.FetchLayer == nil || len(img.Layers) == 0 {
+		opts.FetchLayerWhileApplying = nil
+		return cm.importImage(ctx, img, opts, nil)
+	}
+
+	pipelineCtx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	group, fetchCtx := errgroup.WithContext(pipelineCtx)
+
+	fetchLayer := opts.FetchLayer
+	opts.FetchLayer = nil
+	// Bounded experiment: only the final layer is streamed, and only when it
+	// has a unique digest. Earlier layers retain the tested fetch pipeline.
+	// Waiting for its parent before starting this download can lose transfer
+	// concurrency. A full-flow comparison must measure that regression too.
+	last := img.Layers[len(img.Layers)-1]
+	streamFinal := opts.FetchLayerWhileApplying != nil && cm.StreamingApplier != nil
+	for _, layer := range img.Layers[:len(img.Layers)-1] {
+		if layer.Digest == last.Digest {
+			streamFinal = false
+		}
+	}
+	streamUsed := false
+	if streamFinal {
+		streamFetch := opts.FetchLayerWhileApplying
+		opts.streamLayerDigest = last.Digest
+		opts.FetchLayerWhileApplying = func(ctx context.Context, desc ocispecs.Descriptor, apply func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+			streamUsed = true // importImage invokes this synchronously in manifest order.
+			return streamFetch(ctx, desc, apply)
+		}
+	} else {
+		opts.FetchLayerWhileApplying = nil
+	}
+	ready := make(map[digest.Digest]chan struct{}, len(img.Layers))
+	for _, layer := range img.Layers {
+		if streamFinal && layer.Digest == last.Digest {
+			continue
+		}
+		if _, exists := ready[layer.Digest]; exists {
+			continue
+		}
+		done := make(chan struct{})
+		ready[layer.Digest] = done
+		group.Go(func() error {
+			if err := fetchLayer(fetchCtx, layer); err != nil {
+				return err
+			}
+			// FetchLayer only succeeds after the content store has verified and
+			// committed the complete blob and the source label is recorded.
+			close(done)
+			return nil
+		})
+	}
+	waitForLayer := func(ctx context.Context, layer ocispecs.Descriptor) error {
+		if streamFinal && layer.Digest == last.Digest {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return context.Cause(ctx)
+		case <-ready[layer.Digest]:
+			return nil
+		}
+	}
+
+	current, importErr := cm.importImage(fetchCtx, img, opts, waitForLayer)
+	if importErr == nil && streamFinal && !streamUsed {
+		// A reused final snapshot does not call the applier. Still acquire the
+		// manifest's complete verified blob under this pull's ordinary lease.
+		importErr = fetchLayer(fetchCtx, last)
+	}
+	if importErr != nil {
+		cancel(importErr)
+	}
+	fetchErr := group.Wait()
+	if importErr != nil || fetchErr != nil {
+		if current != nil {
+			_ = current.Release(context.WithoutCancel(ctx))
+		}
+		return nil, errors.Join(importErr, fetchErr)
+	}
+	return current, nil
+}
