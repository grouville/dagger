@@ -0,0 +1,69 @@
+package snapshots
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/containerd/containerd/v2/core/leases"
+	cerrdefs "github.com/containerd/errdefs"
+	digest "github.com/opencontainers/go-digest"
+)
+
+// pinImportedImageSnapshot retains a reused layer across waits for subsequent
+// downloads. ImmutableRef is a non-owning handle: reading one does not acquire
+// a containerd lease. Only add resources to the operation's existing lease;
+// result-owner lease labels and bookkeeping belong to later publication.
+func (cm *snapshotManager) pinImportedImageSnapshot(ctx context.Context, snapshotID string) error {
+	ctx, err := EnsureLease(ctx)
+	if err != nil {
+		return fmt.Errorf("ensure lease for reused image layer: %w", err)
+	}
+	leaseID, ok := leases.FromContext(ctx)
+	if !ok || leaseID == "" {
+		// Match other snapshot-manager create/content-link boundaries: callers
+		// outside an operation lease scope remain responsible for retention.
+		return nil
+	}
+	lease := leases.Lease{ID: leaseID}
+	for snapshotID != "" {
+		if err := cm.LeaseManager.AddResource(ctx, lease, leases.Resource{
+			ID: snapshotID, Type: "snapshots/" + cm.Snapshotter.Name(),
+		}); err != nil && !cerrdefs.IsAlreadyExists(err) {
+			return fmt.Errorf("pin reused image snapshot %s: %w", snapshotID, err)
+		}
+		// AddResource does not validate existence. Recheck after pinning so a
+		// snapshot removed since the index lookup takes the stale-hit fallback.
+		info, err := cm.Snapshotter.Stat(ctx, snapshotID)
+		if err != nil {
+			if cerrdefs.IsNotFound(err) {
+				return fmt.Errorf("reused image snapshot %s: %w", snapshotID, errNotFound)
+			}
+			return fmt.Errorf("stat reused image snapshot %s: %w", snapshotID, err)
+		}
+		cm.mu.Lock()
+		digests := make([]digest.Digest, 0, len(cm.snapshotContentDigests[snapshotID]))
+		for dgst := range cm.snapshotContentDigests[snapshotID] {
+			digests = append(digests, dgst)
+		}
+		cm.mu.Unlock()
+		for _, dgst := range digests {
+			if err := cm.LeaseManager.AddResource(ctx, lease, leases.Resource{
+				ID: dgst.String(), Type: "content",
+			}); err != nil && !cerrdefs.IsAlreadyExists(err) {
+				return fmt.Errorf("pin reused image content %s: %w", dgst, err)
+			}
+			// Content can have been collected before its lease edge was added,
+			// just like snapshots. A stale edge is not a retained closure.
+			if _, err := cm.ContentStore.Info(ctx, dgst); err != nil {
+				if cerrdefs.IsNotFound(err) {
+					return fmt.Errorf("reused image content %s: %w", dgst, errNotFound)
+				}
+				return fmt.Errorf("stat reused image content %s: %w", dgst, err)
+			}
+		}
+		// Also pin ancestors explicitly: inherited operation leases may be
+		// flat, and snapshot-content relationships live in Dagger metadata.
+		snapshotID = info.Parent
+	}
+	return nil
+}
