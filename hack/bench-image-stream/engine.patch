+	cerrdefs "github.com/containerd/errdefs"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+// Real metadata DB, native snapshots, content store, lease manager and GC.
+// This targets the reuse-to-next-fetch retention gap without mounting/unpacking
+// an image: the next fetch intentionally fails after the GC assertions.
+type imageGCTestSnapshotter struct{ ctdsnapshots.Snapshotter }
+
+func (sn imageGCTestSnapshotter) Name() string { return "native" }
+func (sn imageGCTestSnapshotter) Merge(context.Context, string, []Diff, ...ctdsnapshots.Opt) error {
+	return errors.New("GC reuse test must not merge")
+}
+func (sn imageGCTestSnapshotter) Prepare(ctx context.Context, key, parent string, opts ...ctdsnapshots.Opt) error {
+	_, err := sn.Snapshotter.Prepare(ctx, key, parent, opts...)
+	return err
+}
+func (sn imageGCTestSnapshotter) Mounts(context.Context, string) (MountableRef, error) {
+	return nil, errors.New("GC reuse test must not mount")
+}
+func (sn imageGCTestSnapshotter) View(context.Context, string, string, ...ctdsnapshots.Opt) (MountableRef, error) {
+	return nil, errors.New("GC reuse test must not view")
+}
+
+type imageGCTestLeaseManager struct {
+	leases.Manager
+	target   leases.Resource
+	oldLease string
+	pinned   chan struct{}
+	once     sync.Once
+}
+
+func (lm *imageGCTestLeaseManager) AddResource(ctx context.Context, l leases.Lease, r leases.Resource) error {
+	err := lm.Manager.AddResource(ctx, l, r)
+	if err == nil && l.ID != lm.oldLease && r == lm.target {
+		lm.once.Do(func() { close(lm.pinned) })
+	}
+	return err
+}
+
+func TestImportImageReuseSurvivesRealContainerdGC(t *testing.T) {
+	for _, lookup := range []string{"blob", "diff"} {
+		for _, mode := range []string{"lazy", "flat-materialized"} {
+			t.Run(lookup+"/"+mode, func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(namespaces.WithNamespace(t.Context(), "image-pipeline-gc"), 10*time.Second)
+				defer cancel()
+				store, err := localcontent.NewStore(filepath.Join(t.TempDir(), "content"))
+				require.NoError(t, err)
+				nativeSN, err := native.NewSnapshotter(filepath.Join(t.TempDir(), "native"))
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, nativeSN.Close()) })
+				boltDB, err := bolt.Open(filepath.Join(t.TempDir(), "metadata.db"), 0600, nil)
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, boltDB.Close()) })
+				mdb := metadata.NewDB(boltDB, store, map[string]ctdsnapshots.Snapshotter{"native": nativeSN})
+				require.NoError(t, mdb.Init(ctx))
+				realLM := metadata.NewLeaseManager(mdb)
+				old, oldCtx, err := NewLease(ctx, realLM)
+				require.NoError(t, err)
+				cm := newApplySnapshotDiffTestManager(t)
+				cm.Snapshotter = imageGCTestSnapshotter{mdb.Snapshotter("native")}
+				cm.ContentStore = mdb.ContentStore()
+				first, data := pipelineTestLayer("reused-base")
+				ancestor, ancestorData := pipelineTestLayer("reused-ancestor")
+				second, _ := pipelineTestLayer("blocked-next")
+				const snapshotID = "reusable-base"
+				const ancestorID = "reusable-ancestor"
+				require.NoError(t, cm.Snapshotter.Prepare(oldCtx, "active-ancestor", ""))
+				require.NoError(t, cm.Snapshotter.Commit(oldCtx, ancestorID, "active-ancestor"))
+				require.NoError(t, pipelineTestWrite(oldCtx, cm, ancestor, ancestorData))
+				require.NoError(t, cm.Snapshotter.Prepare(oldCtx, "active-base", ancestorID))
+				require.NoError(t, cm.Snapshotter.Commit(oldCtx, snapshotID, "active-base"))
+				require.NoError(t, pipelineTestWrite(oldCtx, cm, first, data))
+				rows := PersistentMetadataRows{SnapshotContent: []SnapshotContentRow{{SnapshotID: snapshotID, Digest: first.Digest}, {SnapshotID: ancestorID, Digest: ancestor.Digest}}}
+				if lookup == "blob" {
+					rows.ImportedByBlob = []ImportedLayerBlobRow{{BlobDigest: ancestor.Digest, SnapshotID: ancestorID}, {ParentSnapshotID: ancestorID, BlobDigest: first.Digest, SnapshotID: snapshotID}}
+				} else {
+					rows.ImportedByDiff = []ImportedLayerDiffRow{{DiffID: ancestor.Digest, SnapshotID: ancestorID}, {ParentSnapshotID: ancestorID, DiffID: first.Digest, SnapshotID: snapshotID}}
+				}
+				require.NoError(t, cm.LoadPersistentMetadata(rows))
+				lm := &imageGCTestLeaseManager{Manager: realLM, target: leases.Resource{Type: "content", ID: first.Digest.String()}, oldLease: old.l.ID, pinned: make(chan struct{})}
+				cm.LeaseManager = lm
+				operationCtx, release, err := WithLazyLease(ctx, lm, func(l *leases.Lease) error {
+					if mode == "flat-materialized" {
+						if l.Labels == nil {
+							l.Labels = map[string]string{}
+						}
+						l.Labels["containerd.io/gc.flat"] = time.Now().UTC().Format(time.RFC3339Nano)
+					}
+					return nil
+				})
+				require.NoError(t, err)
+				defer release(context.WithoutCancel(ctx))
+				if mode == "flat-materialized" {
+					operationCtx, err = EnsureLease(operationCtx)
+					require.NoError(t, err)
+				}
+				laterStarted, finishLater := make(chan struct{}), make(chan struct{})
+				laterErr := errors.New("expected later fetch failure after real GC")
+				done := pipelineTestStart(cm, operationCtx, &ImportedImage{Layers: []ocispecs.Descriptor{ancestor, first, second}}, func(ctx context.Context, desc ocispecs.Descriptor) error {
+					if desc.Digest != second.Digest {
+						return nil
+					}
+					close(laterStarted)
+					if err := pipelineTestWait(ctx, finishLater); err != nil {
+						return err
+					}
+					return laterErr
+				})
+				require.NoError(t, pipelineTestWait(ctx, laterStarted))
+				require.NoError(t, pipelineTestWait(ctx, lm.pinned))
+				require.NoError(t, realLM.Delete(ctx, old.l))
+				_, err = mdb.GarbageCollect(ctx)
+				require.NoError(t, err)
+				_, err = cm.Snapshotter.Stat(ctx, snapshotID)
+				require.NoError(t, err, "GC reclaimed the reused parent during a later fetch")
+				_, err = cm.ContentStore.Info(ctx, first.Digest)
+				require.NoError(t, err, "GC reclaimed the reused content closure")
+				_, err = cm.Snapshotter.Stat(ctx, ancestorID)
+				require.NoError(t, err, "GC reclaimed the reused snapshot ancestor")
+				_, err = cm.ContentStore.Info(ctx, ancestor.Digest)
+				require.NoError(t, err, "GC reclaimed the reused ancestor content")
+				close(finishLater)
+				got := pipelineTestFinish(t, ctx, done)
+				require.Nil(t, got.ref)
+				require.ErrorIs(t, got.err, laterErr)
+				require.NoError(t, release(ctx))
+				_, err = mdb.GarbageCollect(ctx)
+				require.NoError(t, err)
+				_, err = cm.Snapshotter.Stat(ctx, snapshotID)
+				require.True(t, cerrdefs.IsNotFound(err), "temporary operation lease must not become permanent ownership")
+				_, err = cm.ContentStore.Info(ctx, first.Digest)
+				require.True(t, cerrdefs.IsNotFound(err))
+				_, err = cm.Snapshotter.Stat(ctx, ancestorID)
+				require.True(t, cerrdefs.IsNotFound(err))
+				_, err = cm.ContentStore.Info(ctx, ancestor.Digest)
+				require.True(t, cerrdefs.IsNotFound(err))
+			})
+		}
+	}
+}
