+
+// The shipped igzip 2.32.1 starts with a 1 MiB fread before inflation. Keep
+// enough input available for that ordinary decoder to produce output, while
+// retaining at least as much compressed data behind the remainder gate.
+const streamRealPrefixSize = 1 << 20
+
+// Selected only by the privileged EngineSuite wrapper. No fake snapshotter,
+// mountable, filesystem applier, content store or lease manager is used here.
+// This is a correctness fixture, not a Container.from/Cargo timing benchmark.
+func TestStreamedSnapshotRealPrivate(t *testing.T) {
+	runStreamedSnapshotRealPrivate(t, 2<<20)
+}
+
+// Explicitly cross the experimental applier's 8 MiB compressed-descriptor
+// threshold so real private-snapshot ownership/GC runs with its hash worker.
+func TestStreamedSnapshotRealPrivateLarge(t *testing.T) {
+	runStreamedSnapshotRealPrivate(t, 10<<20)
+}
+
+func runStreamedSnapshotRealPrivate(t *testing.T, payloadSize int) {
+	for _, outcome := range []string{"success", "compressed-digest", "truncated", "diff-id", "source-label-error", "caller-cancel"} {
+		t.Run(outcome, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(namespaces.WithNamespace(t.Context(), "streamed-real"), 20*time.Second)
+			defer cancel()
+			ctx, cancelCause := context.WithCancelCause(ctx)
+			defer cancelCause(nil)
+			root := t.TempDir()
+			store, err := localcontent.NewStore(filepath.Join(root, "content"))
+			require.NoError(t, err)
+			nativeSN, err := native.NewSnapshotter(filepath.Join(root, "snapshots"))
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, nativeSN.Close()) })
+			boltDB, err := bolt.Open(filepath.Join(root, "metadata.db"), 0600, nil)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, boltDB.Close()) })
+			mdb := metadata.NewDB(boltDB, store, map[string]ctdsnapshots.Snapshotter{"native": nativeSN})
+			require.NoError(t, mdb.Init(ctx))
+			// Match the real engine's namespace-owning adapters. Mount release
+			// deliberately runs without a request context; raw metadata managers
+			// would reject that cleanup rather than exercise engine behavior.
+			lm := bksnapshots.NewLeaseManager(metadata.NewLeaseManager(mdb), "streamed-real")
+			cs := bkcontainerd.NewContentStore(mdb.ContentStore(), "streamed-real")
+			sn := mdb.Snapshotter("native")
+			newApplier := func(p content.Provider) diff.Applier {
+				return winlayers.NewFileSystemApplierWithWindows(p, apply.NewFileSystemApplier(p))
+			}
+			cm, err := bksnapshots.NewSnapshotManager(bksnapshots.SnapshotManagerOpt{
+				Snapshotter:  bkcontainerd.NewSnapshotter("native", sn, "streamed-real"),
+				ContentStore: cs, LeaseManager: lm, Applier: newApplier(cs), StreamingApplier: newApplier,
+				MountPoolRoot: filepath.Join(root, "mountpool"),
+			})
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, cm.Close()) })
+			operationCtx, releaseOperation, err := bksnapshots.WithLazyLease(ctx, lm)
+			require.NoError(t, err)
+			defer releaseOperation(context.WithoutCancel(ctx))
+			pull, err := lm.Create(ctx, leases.WithRandomID())
+			require.NoError(t, err)
+			defer func() { _ = lm.Delete(context.WithoutCancel(ctx), pull) }()
+			var raw, compressed bytes.Buffer
+			marker := []byte("real private streamed filesystem output\n")
+			tw := tar.NewWriter(&raw)
+			require.NoError(t, tw.WriteHeader(&tar.Header{Name: "stream-marker", Mode: 0644, Size: int64(len(marker))}))
+			_, err = tw.Write(marker)
+			require.NoError(t, err)
+			// An incompressible suffix makes the prefix gate a genuine partial
+			// transfer, after the marker file but before the layer is complete.
+			filler := make([]byte, payloadSize)
+			_, err = rand.Read(filler)
+			require.NoError(t, err)
+			require.NoError(t, tw.WriteHeader(&tar.Header{Name: "payload", Mode: 0644, Size: int64(len(filler))}))
+			_, err = tw.Write(filler)
+			require.NoError(t, err)
+			require.NoError(t, tw.Close())
+			zw := gzip.NewWriter(&compressed)
+			_, err = zw.Write(raw.Bytes())
+			require.NoError(t, err)
+			require.NoError(t, zw.Close())
+			desc := streamTestDescriptor(compressed.Bytes())
+			desc.MediaType = ocispecs.MediaTypeImageLayerGzip
+			desc.Annotations["containerd.io/uncompressed"] = digest.FromBytes(raw.Bytes()).String()
+			if payloadSize >= 8<<20 {
+				require.GreaterOrEqual(t, desc.Size, int64(8<<20), "large fixture must enter the pipelined hashing path")
+				t.Logf("hash-worker boundary: compressed-size=%d threshold=%d", desc.Size, 8<<20)
+			}
+			if outcome == "compressed-digest" {
+				desc.Digest = digest.FromString("wrong compressed layer")
+			}
+			if outcome == "diff-id" {
+				desc.Annotations["containerd.io/uncompressed"] = digest.FromString("wrong diffID").String()
+			}
+			gate := &streamCommitGate{Ingester: cs, entered: make(chan struct{}), allow: make(chan struct{})}
+			gated := outcome == "success" || outcome == "caller-cancel"
+			payload := compressed.Bytes()
+			if outcome == "truncated" {
+				payload = payload[:len(payload)-1]
+			}
+			fetcher := streamTestFetcher(payload)
+			prefixWritten, allowRemainder := make(chan struct{}), make(chan struct{})
+			if gated {
+				require.GreaterOrEqual(t, len(payload)-streamRealPrefixSize, streamRealPrefixSize,
+					"early materialization must leave at least another prefix-sized compressed remainder blocked")
+				t.Logf("partial transfer: prefix=%d remainder=%d compressed-total=%d", streamRealPrefixSize, len(payload)-streamRealPrefixSize, len(payload))
+				fetcher = streamedFetchFunc(func(ctx context.Context, _ ocispecs.Descriptor) (io.ReadCloser, error) {
+					return &streamRealGatedBlob{Reader: bytes.NewReader(payload), data: payload, ctx: ctx, written: prefixWritten, allow: allowRemainder}, nil
+				})
+			}
+			var ingester content.Ingester = cs
+			if gated {
+				ingester = gate
+			}
+			applied := make(chan struct{})
+			type result struct {
+				ref bksnapshots.ImmutableRef
+				err error
+			}
+			done := make(chan result, 1)
+			joined := make(chan struct{})
+			sentinel := errors.New("injected private import failure")
+			go func() {
+				defer close(joined)
+				ref, err := cm.ImportImage(operationCtx, &bksnapshots.ImportedImage{Layers: []ocispecs.Descriptor{desc}}, bksnapshots.ImportImageOpts{
+					FetchLayer: func(context.Context, ocispecs.Descriptor) error {
+						return errors.New("streamed miss must not use eager fetch")
+					},
+					FetchLayerWhileApplying: func(importCtx context.Context, d ocispecs.Descriptor, applyPrivate func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+						actual, err := fetchLayerWhileApplying(leases.WithLease(importCtx, pull.ID), ingester, cs, fetcher, d,
+							func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+								actual, err := applyPrivate(ctx, p)
+								if err == nil {
+									close(applied)
+								}
+								return actual, err
+							})
+						if err == nil && outcome == "source-label-error" {
+							return ocispecs.Descriptor{}, sentinel
+						}
+						return actual, err
+					},
+				})
+				done <- result{ref, err}
+			}()
+			t.Cleanup(func() {
+				cancelCause(nil)
+				select {
+				case <-joined:
+				case <-time.After(5 * time.Second):
+					t.Error("real import worker did not join before fixture cleanup")
+				}
+			})
+			var privateID string
+			if gated {
+				streamTestAwait(t, ctx, prefixWritten)
+				_, err := cs.Info(ctx, desc.Digest)
+				require.True(t, errdefs.IsNotFound(err), "partial-stream application must not publish committed content")
+				status, err := cs.Status(ctx, remotes.MakeRefKey(ctx, desc))
+				require.NoError(t, err)
+				require.EqualValues(t, streamRealPrefixSize, status.Offset, "only the prefix may have entered the real writer")
+				require.NoError(t, sn.Walk(ctx, func(_ context.Context, info ctdsnapshots.Info) error {
+					require.Equal(t, ctdsnapshots.KindActive, info.Kind, "no committed snapshot before content verification")
+					privateID = info.Name
+					return nil
+				}))
+				require.NotEmpty(t, privateID)
+				mounts, err := sn.Mounts(ctx, privateID)
+				require.NoError(t, err)
+				require.NoError(t, mount.WithTempMount(ctx, mounts, func(root string) error {
+					// Consuming the compressed prefix only proves handoff to the
+					// decompressor, which may use an asynchronous external process.
+					// Wait for actual mounted file content while the remaining
+					// compressed bytes stay blocked. Timeout does not open the gate.
+					waitCtx, stop := context.WithTimeout(ctx, 5*time.Second)
+					defer stop()
+					ticker := time.NewTicker(10 * time.Millisecond)
+					defer ticker.Stop()
+					var lastErr error
+					for {
+						data, err := os.ReadFile(filepath.Join(root, "stream-marker"))
+						if err == nil && bytes.Equal(data, marker) {
+							return nil
+						}
+						if err != nil && !os.IsNotExist(err) {
+							return err
+						}
+						lastErr = err
+						if err == nil {
+							lastErr = fmt.Errorf("incomplete marker: read %d bytes, want %d", len(data), len(marker))
+						}
+						select {
+						case got := <-done:
+							return fmt.Errorf("import completed before the gated mounted marker (ref=%t, error=%v)", got.ref != nil, got.err)
+						case <-waitCtx.Done():
+							return fmt.Errorf("mounted marker unavailable while remainder is blocked: %w", errors.Join(context.Cause(waitCtx), lastErr))
+						case <-ticker.C:
+						}
+					}
+				}))
+				_, err = mdb.GarbageCollect(ctx)
+				require.NoError(t, err)
+				_, err = sn.Stat(ctx, privateID)
+				require.NoError(t, err, "GC must retain genuinely applied private snapshot")
+				select {
+				case got := <-done:
+					t.Fatalf("import returned before content commit: %+v", got)
+				default:
+				}
+				if outcome == "caller-cancel" {
+					cancelCause(sentinel)
+				} else {
+					select {
+					case <-applied:
+						t.Fatal("applier finished before the rest of the compressed layer arrived")
+					default:
+					}
+					close(allowRemainder)
+					streamTestAwait(t, ctx, applied)
+					streamTestAwait(t, ctx, gate.entered)
+					_, err = cs.Info(ctx, desc.Digest)
+					require.True(t, errdefs.IsNotFound(err), "complete real application still must wait for external blob commit")
+					close(gate.allow)
+				}
+			}
+			var got result
+			select {
+			case got = <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("real streamed workers failed to join")
+			}
+			checkCtx := context.WithoutCancel(ctx)
+			var resultID string
+			if outcome == "success" {
+				require.NoError(t, got.err)
+				require.NotNil(t, got.ref)
+				resultID = got.ref.SnapshotID()
+				require.NoError(t, cm.AttachLease(checkCtx, "streamed-real-owner", resultID))
+				mountable, err := got.ref.Mount(checkCtx, true)
+				require.NoError(t, err)
+				mounts, release, err := mountable.Mount()
+				require.NoError(t, err)
+				require.NoError(t, mount.WithTempMount(checkCtx, mounts, func(root string) error {
+					data, err := os.ReadFile(filepath.Join(root, "stream-marker"))
+					if err != nil {
+						return err
+					}
+					require.Equal(t, marker, data)
+					return nil
+				}))
+				require.NoError(t, release())
+				require.NoError(t, got.ref.Release(checkCtx))
+			} else {
+				require.Error(t, got.err)
+				require.Nil(t, got.ref)
+				if outcome == "caller-cancel" || outcome == "source-label-error" {
+					require.ErrorIs(t, got.err, sentinel)
+				}
+				if outcome == "diff-id" {
+					require.ErrorContains(t, got.err, "calculated diffID")
+				}
+				require.NoError(t, sn.Walk(checkCtx, func(_ context.Context, info ctdsnapshots.Info) error {
+					require.NotEqual(t, ctdsnapshots.KindCommitted, info.Kind, "failed verification must not commit real snapshot")
+					return nil
+				}))
+			}
+			require.NoError(t, releaseOperation(checkCtx))
+			require.NoError(t, lm.Delete(checkCtx, pull))
+			_, err = mdb.GarbageCollect(checkCtx)
+			require.NoError(t, err)
+			if outcome == "success" {
+				_, err = sn.Stat(checkCtx, resultID)
+				require.NoError(t, err, "normal result owner must retain real snapshot")
+				_, err = cs.Info(checkCtx, desc.Digest)
+				require.NoError(t, err)
+				require.NoError(t, cm.RemoveLease(checkCtx, "streamed-real-owner"))
+				_, err = mdb.GarbageCollect(checkCtx)
+				require.NoError(t, err)
+			}
+			var remaining int
+			require.NoError(t, sn.Walk(checkCtx, func(context.Context, ctdsnapshots.Info) error { remaining++; return nil }))
+			require.Zero(t, remaining, "normal GC must reclaim real snapshot state after all owners release")
+			_, err = cs.Info(checkCtx, desc.Digest)
+			require.True(t, errdefs.IsNotFound(err))
+		})
+	}
+}
+
+// WriterTo is intentionally supported by containerd.content.Copy: it lets this
+// fixture stop after a known compressed prefix without its normal 1 MiB buffer
+// moving the synchronization point. Every byte still enters the real writer.
+type streamRealGatedBlob struct {
+	*bytes.Reader
+	data    []byte
+	ctx     context.Context
+	written chan struct{}
+	allow   chan struct{}
+}
+
+func (r *streamRealGatedBlob) Close() error { return nil }
+
+func (r *streamRealGatedBlob) WriteTo(w io.Writer) (int64, error) {
+	n, err := w.Write(r.data[:streamRealPrefixSize])
+	if err != nil {
+		return int64(n), err
+	}
+	close(r.written)
+	select {
+	case <-r.allow:
+	case <-r.ctx.Done():
+		return int64(n), context.Cause(r.ctx)
+	}
+	m, err := w.Write(r.data[streamRealPrefixSize:])
+	return int64(n + m), err
+}
