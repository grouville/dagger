+// These tests use the actual snapshot-manager commit/index/publication order
+// with the existing fake mount/snapshotter. They are NOT real containerd GC or
+// mounted snapshot evidence; the resolver suite separately uses a real writer.
+func TestStreamedImportNoSnapshotCommitBeforeVerification(t *testing.T) {
+	cm, sn, ctx := newPipelineTestManager(t)
+	desc, data := pipelineTestLayer("streamed-private")
+	cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+	entered := make(chan struct{})
+	allow := make(chan struct{})
+	var commits atomic.Int64
+	sn.onCommit = func(string) { commits.Add(1) }
+	done := make(chan pipelineTestResult, 1)
+	go func() {
+		ref, err := cm.ImportImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{desc}}, ImportImageOpts{
+			FetchLayer: func(context.Context, ocispecs.Descriptor) error {
+				return errors.New("eager fetch must not run for streamed miss")
+			},
+			FetchLayerWhileApplying: func(ctx context.Context, desc ocispecs.Descriptor, apply func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+				applied, err := apply(ctx, cm.ContentStore)
+				if err != nil {
+					return ocispecs.Descriptor{}, err
+				}
+				close(entered)
+				if err := pipelineTestWait(ctx, allow); err != nil {
+					return ocispecs.Descriptor{}, err
+				}
+				return applied, pipelineTestWrite(ctx, cm, desc, data)
+			},
+		})
+		done <- pipelineTestResult{ref, err}
+	}()
+	require.NoError(t, pipelineTestWait(ctx, entered))
+	require.Zero(t, commits.Load())
+	cm.mu.Lock()
+	blobEntries, diffEntries := len(cm.importedLayerByBlob), len(cm.importedLayerByDiff)
+	allPrivate := true
+	for _, record := range cm.records {
+		allPrivate = allPrivate && record.mutable && record.locked
+	}
+	cm.mu.Unlock()
+	require.Zero(t, blobEntries)
+	require.Zero(t, diffEntries)
+	require.True(t, allPrivate)
+	select {
+	case result := <-done:
+		t.Fatalf("private snapshot returned before verification: %+v", result)
+	default:
+	}
+	close(allow)
+	result := pipelineTestFinish(t, ctx, done)
+	require.NoError(t, result.err)
+	require.NotNil(t, result.ref)
+	require.EqualValues(t, 1, commits.Load())
+	require.NoError(t, result.ref.Release(context.Background()))
+}
+
+func TestStreamedImportRejectsBeforeCommitAndCleansPrivateState(t *testing.T) {
+	for _, mode := range []string{"missing-content", "wrong-diff", "callback-error"} {
+		t.Run(mode, func(t *testing.T) {
+			cm, sn, ctx := newPipelineTestManager(t)
+			desc, data := pipelineTestLayer(mode)
+			cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+			var commits atomic.Int64
+			sn.onCommit = func(string) { commits.Add(1) }
+			ref, err := cm.ImportImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{desc}}, ImportImageOpts{
+				FetchLayer: func(context.Context, ocispecs.Descriptor) error { return errors.New("unexpected eager fetch") },
+				FetchLayerWhileApplying: func(ctx context.Context, desc ocispecs.Descriptor, apply func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+					applied, err := apply(ctx, cm.ContentStore)
+					if err != nil {
+						return ocispecs.Descriptor{}, err
+					}
+					if mode != "missing-content" {
+						if err := pipelineTestWrite(ctx, cm, desc, data); err != nil {
+							return ocispecs.Descriptor{}, err
+						}
+					}
+					if mode == "wrong-diff" {
+						applied.Digest = digest.FromString("wrong diff")
+					}
+					if mode == "callback-error" {
+						return applied, errors.New("source label failed")
+					}
+					return applied, nil
+				},
+			})
+			require.Error(t, err)
+			require.Nil(t, ref)
+			require.Zero(t, commits.Load())
+			cm.mu.Lock()
+			blobEntries, diffEntries, records := len(cm.importedLayerByBlob), len(cm.importedLayerByDiff), len(cm.records)
+			cm.mu.Unlock()
+			require.Zero(t, blobEntries)
+			require.Zero(t, diffEntries)
+			require.Zero(t, records, "private mutable ref must be released on fence failure")
+		})
+	}
+}
