+)
+
+type streamedFetchFunc func(context.Context, ocispecs.Descriptor) (io.ReadCloser, error)
+
+func (f streamedFetchFunc) Fetch(ctx context.Context, d ocispecs.Descriptor) (io.ReadCloser, error) {
+	return f(ctx, d)
+}
+
+type streamCommitGate struct {
+	content.Ingester
+	entered chan struct{}
+	allow   chan struct{}
+}
+
+func (g *streamCommitGate) Writer(ctx context.Context, opts ...content.WriterOpt) (content.Writer, error) {
+	w, err := g.Ingester.Writer(ctx, opts...)
+	if err != nil {
+		return nil, err
+	}
+	return &streamCommitGateWriter{Writer: w, gate: g}, nil
+}
+
+type streamCommitGateWriter struct {
+	content.Writer
+	gate *streamCommitGate
+}
+
+func (w *streamCommitGateWriter) Commit(ctx context.Context, size int64, expected digest.Digest, opts ...content.Opt) error {
+	close(w.gate.entered)
+	select {
+	case <-w.gate.allow:
+		return w.Writer.Commit(ctx, size, expected, opts...)
+	case <-ctx.Done():
+		return context.Cause(ctx)
+	}
+}
+
+func streamTestDescriptor(data []byte) ocispecs.Descriptor {
+	return ocispecs.Descriptor{MediaType: ocispecs.MediaTypeImageLayer, Digest: digest.FromBytes(data), Size: int64(len(data)),
+		Annotations: map[string]string{"containerd.io/uncompressed": digest.FromBytes(data).String()}}
+}
+
+func streamTestFetcher(data []byte) remotes.Fetcher {
+	return streamedFetchFunc(func(context.Context, ocispecs.Descriptor) (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader(data)), nil
+	})
+}
+
+func streamTestConsume(desc ocispecs.Descriptor) func(context.Context, content.Provider) (ocispecs.Descriptor, error) {
+	return func(ctx context.Context, provider content.Provider) (ocispecs.Descriptor, error) {
+		r, err := provider.ReaderAt(ctx, desc)
+		if err != nil {
+			return ocispecs.Descriptor{}, err
+		}
+		defer r.Close()
+		h := digest.Canonical.Digester()
+		n, err := io.Copy(h.Hash(), content.NewReader(r))
+		return ocispecs.Descriptor{Digest: h.Digest(), Size: n, MediaType: ocispecs.MediaTypeImageLayer}, err
+	}
+}
+
+func streamTestContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+func streamTestAwait(t *testing.T, ctx context.Context, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-ctx.Done():
+		t.Fatal(context.Cause(ctx))
+	}
+}
+
+func TestStreamedFetchWaitsForExternalCommit(t *testing.T) {
+	ctx := streamTestContext(t)
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	data := bytes.Repeat([]byte("verified-stream"), 16384)
+	desc := streamTestDescriptor(data)
+	gate := &streamCommitGate{Ingester: store, entered: make(chan struct{}), allow: make(chan struct{})}
+	applied := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		_, err := fetchLayerWhileApplying(ctx, gate, store, streamTestFetcher(data), desc,
+			func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+				result, err := streamTestConsume(desc)(ctx, p)
+				close(applied)
+				return result, err
+			})
+		done <- err
+	}()
+	streamTestAwait(t, ctx, applied)
+	streamTestAwait(t, ctx, gate.entered)
+	_, err = store.Info(ctx, desc.Digest)
+	require.True(t, errdefs.IsNotFound(err), "consumer completed before external content commit")
+	select {
+	case err := <-done:
+		t.Fatalf("publication fence returned before content commit: %v", err)
+	default:
+	}
+	close(gate.allow)
+	require.NoError(t, <-done)
+	_, err = store.Info(ctx, desc.Digest)
+	require.NoError(t, err)
+}
+
+func TestStreamedFetchRejectsIntegrityFailures(t *testing.T) {
+	for _, mode := range []string{"compressed-digest", "truncated", "diff-id"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := streamTestContext(t)
+			store, err := localcontent.NewStore(t.TempDir())
+			require.NoError(t, err)
+			data := bytes.Repeat([]byte("no-unverified-publication"), 1024)
+			desc := streamTestDescriptor(data)
+			payload := bytes.Clone(data)
+			switch mode {
+			case "compressed-digest":
+				desc.Digest = digest.FromString("not the delivered blob")
+			case "truncated":
+				payload = payload[:len(payload)-1]
+			case "diff-id":
+				desc.Annotations["containerd.io/uncompressed"] = digest.FromString("not the applied tar").String()
+			}
+			result, err := fetchLayerWhileApplying(ctx, store, store, streamTestFetcher(payload), desc, streamTestConsume(desc))
+			require.Error(t, err)
+			require.Empty(t, result.Digest, "failed fence must not return a publishable applied descriptor")
+			if mode == "diff-id" {
+				require.ErrorContains(t, err, "calculated diffID")
+			} else {
+				_, err = store.Info(ctx, desc.Digest)
+				require.True(t, errdefs.IsNotFound(err))
+			}
+		})
+	}
+}
+
+func TestStreamedFetchApplyErrorCancelsAndJoinsFetch(t *testing.T) {
+	ctx := streamTestContext(t)
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	sentinel := errors.New("deliberate private apply failure")
+	var fetchJoined atomic.Bool
+	fetcher := streamedFetchFunc(func(ctx context.Context, _ ocispecs.Descriptor) (io.ReadCloser, error) {
+		defer fetchJoined.Store(true)
+		<-ctx.Done()
+		return nil, context.Cause(ctx)
+	})
+	desc := streamTestDescriptor([]byte("cancel-me"))
+	result, err := fetchLayerWhileApplying(ctx, store, store, fetcher, desc,
+		func(context.Context, content.Provider) (ocispecs.Descriptor, error) {
+			return ocispecs.Descriptor{}, sentinel
+		})
+	require.ErrorIs(t, err, sentinel)
+	require.True(t, fetchJoined.Load())
+	require.Empty(t, result.Digest)
+}
+
+func TestStreamedFetchFetchErrorCancelsAndJoinsApply(t *testing.T) {
+	ctx := streamTestContext(t)
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	sentinel := errors.New("deliberate fetch failure")
+	var applyJoined atomic.Bool
+	fetcher := streamedFetchFunc(func(context.Context, ocispecs.Descriptor) (io.ReadCloser, error) {
+		return nil, sentinel
+	})
+	desc := streamTestDescriptor([]byte("cancel-me"))
+	_, err = fetchLayerWhileApplying(ctx, store, store, fetcher, desc,
+		func(ctx context.Context, _ content.Provider) (ocispecs.Descriptor, error) {
+			defer applyJoined.Store(true)
+			<-ctx.Done()
+			return ocispecs.Descriptor{}, context.Cause(ctx)
+		})
+	require.ErrorIs(t, err, sentinel)
+	require.True(t, applyJoined.Load())
+}
+
+func TestStreamedFetchExistingAndResumedStayEager(t *testing.T) {
+	for _, mode := range []string{"existing", "resumed"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := streamTestContext(t)
+			store, err := localcontent.NewStore(t.TempDir())
+			require.NoError(t, err)
+			data := bytes.Repeat([]byte("ordinary-complete-reader"), 1024)
+			desc := streamTestDescriptor(data)
+			if mode == "existing" {
+				require.NoError(t, content.WriteBlob(ctx, store, remotes.MakeRefKey(ctx, desc), bytes.NewReader(data), desc))
+			} else {
+				w, err := store.Writer(ctx, content.WithRef(remotes.MakeRefKey(ctx, desc)), content.WithDescriptor(desc))
+				require.NoError(t, err)
+				_, err = w.Write(data[:len(data)/2])
+				require.NoError(t, err)
+				require.NoError(t, w.Close())
+			}
+			_, err = fetchLayerWhileApplying(ctx, store, store, streamTestFetcher(data), desc,
+				func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+					_, err := store.Info(ctx, desc.Digest)
+					if err != nil {
+						return ocispecs.Descriptor{}, err
+					}
+					return streamTestConsume(desc)(ctx, p)
+				})
+			require.NoError(t, err)
+		})
+	}
+}
+
+func TestStreamedFetchStandardGzipApplier(t *testing.T) {
+	ctx := streamTestContext(t)
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	var raw, compressed bytes.Buffer
+	tw := tar.NewWriter(&raw)
+	text := []byte("the toolchain is complete only after the fence\n")
+	require.NoError(t, tw.WriteHeader(&tar.Header{Name: "toolchain-marker", Mode: 0644, Size: int64(len(text))}))
+	_, err = tw.Write(text)
+	require.NoError(t, err)
+	require.NoError(t, tw.Close())
+	gw := gzip.NewWriter(&compressed)
+	_, err = gw.Write(raw.Bytes())
+	require.NoError(t, err)
+	require.NoError(t, gw.Close())
+	desc := streamTestDescriptor(compressed.Bytes())
+	desc.MediaType = ocispecs.MediaTypeImageLayerGzip
+	desc.Annotations["containerd.io/uncompressed"] = digest.FromBytes(raw.Bytes()).String()
+	root := t.TempDir()
+	// Exercise the actual filesystem applier through an owned bind mount in
+	// the supported privileged integration runner. This does not rely on the
+	// overlay shortcut being enabled outside a user namespace. The separate
+	// real-snapshot fixture covers snapshot-manager ownership and GC.
+	mounts := []mount.Mount{{Type: "bind", Source: root, Options: []string{"rbind", "rw"}}}
+	var readerCalls, readAtCalls atomic.Int64
+	result, err := fetchLayerWhileApplying(ctx, store, store, streamTestFetcher(compressed.Bytes()), desc,
+		func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+			p = streamOptionalTrackingProvider{Provider: p, readerCalls: &readerCalls, readAtCalls: &readAtCalls}
+			return apply.NewFileSystemApplier(p).Apply(ctx, desc, mounts, diff.WithSyncFs(false))
+		})
+	require.NoError(t, err)
+	require.Equal(t, digest.FromBytes(raw.Bytes()), result.Digest)
+	actual, err := os.ReadFile(filepath.Join(root, "toolchain-marker"))
+	require.NoError(t, err)
+	require.Equal(t, text, actual)
+	require.EqualValues(t, 1, readerCalls.Load(), "actual stock applier must call optional Reader()")
+	require.Zero(t, readAtCalls.Load(), "actual stock applier must not rely on ReadAt support")
+}
