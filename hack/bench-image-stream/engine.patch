+func TestStreamedImportReusedFinalSnapshotStillFetchesVerifiedBlob(t *testing.T) {
+	cm, _, ctx := newPipelineTestManager(t)
+	desc, data := pipelineTestLayer("reused-final")
+	require.NoError(t, pipelineTestWrite(ctx, cm, desc, data))
+	first, err := cm.ImportImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{desc}}, ImportImageOpts{})
+	require.NoError(t, err)
+	defer first.Release(context.Background())
+	cm.StreamingApplier = func(content.Provider) diff.Applier { return cm.Applier }
+	var fetches, streams atomic.Int64
+	second, err := cm.ImportImage(ctx, &ImportedImage{Layers: []ocispecs.Descriptor{desc}}, ImportImageOpts{
+		FetchLayer: func(ctx context.Context, desc ocispecs.Descriptor) error {
+			fetches.Add(1)
+			return pipelineTestWrite(ctx, cm, desc, data)
+		},
+		FetchLayerWhileApplying: func(context.Context, ocispecs.Descriptor, func(context.Context, content.Provider) (ocispecs.Descriptor, error)) (ocispecs.Descriptor, error) {
+			streams.Add(1)
+			return ocispecs.Descriptor{}, errors.New("reused snapshot must not stream")
+		},
+	})
+	require.NoError(t, err)
+	defer second.Release(context.Background())
+	require.Equal(t, first.SnapshotID(), second.SnapshotID())
+	require.EqualValues(t, 1, fetches.Load())
+	require.Zero(t, streams.Load())
+}
