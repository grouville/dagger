@@ -0,0 +1,84 @@
+package resolver
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/diff/apply"
+	"github.com/containerd/containerd/v2/core/mount"
+	localcontent "github.com/containerd/containerd/v2/plugins/content/local"
+	"github.com/containerd/errdefs"
+	"github.com/klauspost/compress/zstd"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+)
+
+// The ordinary asynchronous Zstd decoder must be joined after a tar error,
+// even when its next input read cannot finish. Caller cancellation is only
+// fixture cleanup: it must not be what makes the production call return.
+// Run in the same source-built privileged integration runner as the real
+// snapshot fixtures; no decoder concurrency/implementation override.
+func TestStreamedFetchZstdEarlyError(t *testing.T) {
+	ctx, cancel := context.WithCancel(streamTestContext(t))
+	defer cancel()
+	store, err := localcontent.NewStore(t.TempDir())
+	require.NoError(t, err)
+	// A random first tar block has an invalid header/checksum; the suffix is
+	// incompressible so the source has a substantial blocked remainder.
+	raw := make([]byte, 3<<20)
+	_, err = rand.Read(raw)
+	require.NoError(t, err)
+	copy(raw[:16], []byte("invalid tar data"))
+	var compressed bytes.Buffer
+	zw, err := zstd.NewWriter(&compressed)
+	require.NoError(t, err)
+	_, err = zw.Write(raw)
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	payload := compressed.Bytes()
+	require.Greater(t, len(payload), 2*streamRealPrefixSize)
+	desc := streamTestDescriptor(payload)
+	desc.MediaType = ocispecs.MediaTypeImageLayerZstd
+	desc.Annotations["containerd.io/uncompressed"] = digest.FromBytes(raw).String()
+	prefixWritten, allowRemainder := make(chan struct{}), make(chan struct{})
+	fetcher := streamedFetchFunc(func(ctx context.Context, _ ocispecs.Descriptor) (io.ReadCloser, error) {
+		return &streamRealGatedBlob{Reader: bytes.NewReader(payload), data: payload, ctx: ctx, written: prefixWritten, allow: allowRemainder}, nil
+	})
+	mounts := []mount.Mount{{Type: "bind", Source: t.TempDir(), Options: []string{"rbind", "rw"}}}
+	done := make(chan error, 1)
+	go func() {
+		result, err := fetchLayerWhileApplying(ctx, store, store, fetcher, desc,
+			func(ctx context.Context, p content.Provider) (ocispecs.Descriptor, error) {
+				return apply.NewFileSystemApplier(p).Apply(ctx, desc, mounts, diff.WithSyncFs(false))
+			})
+		if result.Digest != "" {
+			done <- io.ErrNoProgress
+			return
+		}
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		require.NoError(t, ctx.Err(), "caller must remain live")
+		require.ErrorContains(t, err, "invalid tar header")
+	case <-time.After(5 * time.Second):
+		// Join before local store/mount cleanup, retaining the failure rather
+		// than accepting the successful cancellation as the tested outcome.
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(5 * time.Second):
+			t.Error("stream workers did not join even after fixture cancellation")
+		}
+		t.Fatal("early extraction error waited for blocked decoder input")
+	}
+	_, err = store.Info(ctx, desc.Digest)
+	require.True(t, errdefs.IsNotFound(err), "partial failed input must not be committed")
+}
