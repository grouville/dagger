+// exportOneOrigin serializes once, with target-owned row headers and immutable
+// blobs. Origin/ancestry were validated for this entire batch before entry.
+func (exp sessionSpanExporter) exportOneOrigin(ctx context.Context, spans []sdktrace.ReadOnlySpan, route []string) error {
+	start := time.Now()
+	rows := make([]clientdb.Span, 0, len(spans))
+	for _, span := range spans {
+		if row, ok := spanRecordRow(withoutSpanOrigin(span)); ok {
+			rows = append(rows, row)
+		}
+	}
+	write := func(target string, targetRows []clientdb.Span) error {
+		writer := clientSpans{PubSub: exp.ps, clientID: target}
+		if err := writer.exportSpanRows(ctx, targetRows, start); err != nil {
+			return fmt.Errorf("export spans to %s: %w", target, err)
+		}
+		return nil
+	}
+	if len(route) == 1 {
+		return write(route[0], rows)
+	}
+	var eg errgroup.Group
+	for i, target := range route {
+		targetRows := rows
+		if i != len(route)-1 {
+			targetRows = slices.Clone(rows)
+		}
+		// The original headers are handed to the last writer only after every
+		// clone is complete. Append may mutate IDs immediately in each goroutine.
+		eg.Go(func() error { return write(target, targetRows) })
+	}
+	return eg.Wait()
+}
