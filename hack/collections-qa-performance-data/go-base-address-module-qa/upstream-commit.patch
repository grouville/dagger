+  """
+  Failure witness: discovery must never consume a deferred base address.
+  """
+  addressFailureBase: Container! {
+    raise "base-address producer sentinel"
+  }
+
+  """
+  A custom base carrying environment, files and a real HTTP service. The marker
+  comes from the caller Workspace so an edit has to change the resulting base.
+  """
+  addressBase(ws: Workspace!): Container! {
+    let marker = ws.file(baseFixturePath + "/base-marker.txt").contents
+    let service = container
+      .from("busybox:1.37@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e")
+      .withNewFile("/www/value", marker)
+      .withExposedPort(8080)
+      .asService(args: ["httpd", "-f", "-p", "8080", "-h", "/www"])
+    base
+      .withNewFile("/address-marker", marker)
+      .withServiceBinding("base-address-service", service)
+  }
+
+  """
+  Module/test discovery leaves an Address unconsumed, while version/warning
+  rules and the existing Container constructor remain compatible.
+  """
+  baseAddressDiscoveryCheck(ws: Workspace!): Void @check {
+    let address = ws.resolve("dag://go-dev/address-failure-base")
+    let tool = go(baseAddress: address)
+    assert(containsPath(tool.modules(ws).keys, baseFixturePath), "deferred base hid a module")
+    let mod = tool.module(ws, baseFixturePath)
+    assert(mod.tests(ws).keys == ["TestBase"], "deferred base changed test discovery")
+    assert(mod.version(ws) == null, "deferred custom base exposed inferred Go version")
+    let ignored = go(version: "1.26.1", baseAddress: address)
+    assert(ignored.version == null, "version not ignored beside baseAddress")
+    assert(ignored.warnings.join(";").contains("baseAddress was set"), "missing ignored-version warning")
+    let failed = { mod.base(ws).envVariable("DAGGER_GO_CUSTOM_BASE"); "missing failure" } rescue {
+      err: Error => err.message
+    }
+    assert(failed.contains("base-address producer sentinel"), "consuming base did not propagate producer error")
+    let conflict = { go(base: base, baseAddress: address).version ?? "missing rejection" } rescue {
+      err: Error => err.message
+    }
+    assert(conflict.contains("cannot both be set"), "ambiguous custom bases were accepted")
+    null
+  }
+
+  """
+  A deferred base supplies the same required custom environment/file to tests
+  and generation, and keeps a live service binding. None of these checks skip.
+  """
+  baseAddressExecutionCheck(ws: Workspace!): Void @check {
+    let marker = ws.file(baseFixturePath + "/base-marker.txt").contents
+    let tool = go(baseAddress: ws.resolve("dag://go-dev/address-base"))
+    let mod = tool.module(ws, baseFixturePath)
+    let ctr = mod.base(ws)
+    assert(ctr.envVariable("DAGGER_GO_CUSTOM_BASE") == "yes", "custom base environment lost")
+    assert(ctr.file("/custom-go-base").contents == "yes\n", "custom base file lost")
+    assert(ctr.file("/address-marker").contents == marker, "address source edit was stale")
+    assert(
+      ctr.withExec(["wget", "-qO-", "http://base-address-service:8080/value"]).stdout == marker,
+      "custom base service binding or current marker was lost",
+    )
+    # TestBase fails when the environment or required file is absent.
+    mod.test(ws)
+    let changes = mod.generate(ws)
+    assert(containsPath(changes.addedPaths, baseGeneratedFilePath), "custom base generate omitted output")
+    assert(
+      changes.layer.file(baseGeneratedFilePath).contents.contains("GeneratedFromBase"),
+      "custom base generate lost environment",
+    )
+    null
+  }
+
