+
+// artifactIncludedModuleNames is a conservative static-tree prefilter. Keep the
+// ordinary matcher for patterns, unknown prefixes and entrypoint aliases. The
+// module load phase and final per-node filtering still run unchanged.
+func artifactIncludedModuleNames(names, include []string) map[string]struct{} {
+	for _, pattern := range include {
+		if strings.ContainsAny(pattern, "*?[]{}\\") {
+			return nil
+		}
+	}
+	return overlayIncludedModuleNames(names, include)
+}
+
+func artifactIncludesModule(included map[string]struct{}, name string, entrypoint bool) bool {
+	if included == nil || entrypoint {
+		return true
+	}
+	_, ok := included[canonicalOverlayModuleName(name)]
+	return ok
