--- /dev/null
+++ b/pkg/archive/consecutive_parent_test.go
@@ -0,0 +1,95 @@
+package archive
+
+import (
+	"archive/tar"
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestConsecutiveParentTransitions(t *testing.T) {
+	type entry struct {
+		name, target, contents string
+		kind                   byte
+	}
+	cases := []struct {
+		name      string
+		entries   []entry
+		files     map[string]string
+		wantError bool
+	}{
+		{name: "siblings", entries: []entry{{name: "a/b/one", contents: "1"}, {name: "a/b/two", contents: "2"}, {name: "a/b/three", contents: "3"}}, files: map[string]string{"a/b/one": "1", "a/b/two": "2", "a/b/three": "3"}},
+		{name: "parent replaced then recreated", entries: []entry{{name: "a/one", contents: "1"}, {name: "a", contents: "file"}, {name: "a", kind: tar.TypeDir}, {name: "a/two", contents: "2"}}, files: map[string]string{"a/two": "2"}},
+		{name: "parent replaced with file", entries: []entry{{name: "a/one", contents: "1"}, {name: "a", contents: "file"}, {name: "a/two", contents: "2"}}, wantError: true},
+		{name: "parent replaced with symlink", entries: []entry{{name: "a/one", contents: "1"}, {name: "b", kind: tar.TypeDir}, {name: "a", kind: tar.TypeSymlink, target: "b"}, {name: "a/two", contents: "2"}, {name: "a/three", contents: "3"}}, files: map[string]string{"b/two": "2", "b/three": "3"}},
+		{name: "alias replaces its own ancestor", entries: []entry{{name: "a", kind: tar.TypeDir}, {name: "a/l", kind: tar.TypeSymlink, target: ".."}, {name: "a/l/a", contents: "file"}, {name: "a/l/b", contents: "2"}}, wantError: true},
+		{name: "whiteout then recreate", entries: []entry{{name: "a/one", contents: "1"}, {name: ".wh.a"}, {name: "a/two", contents: "2"}, {name: "a/three", contents: "3"}}, files: map[string]string{"a/two": "2", "a/three": "3"}},
+		{name: "hardlink transition", entries: []entry{{name: "a/one", contents: "1"}, {name: "a/link", kind: tar.TypeLink, target: "a/one"}, {name: "a/two", contents: "2"}}, files: map[string]string{"a/link": "1", "a/two": "2"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var data bytes.Buffer
+			tw := tar.NewWriter(&data)
+			for _, e := range tc.entries {
+				kind := e.kind
+				if kind == 0 {
+					kind = tar.TypeReg
+				}
+				h := &tar.Header{Name: e.name, Linkname: e.target, Typeflag: kind, Mode: 0755}
+				if kind == tar.TypeReg {
+					h.Size = int64(len(e.contents))
+				}
+				require.NoError(t, tw.WriteHeader(h))
+				if h.Size > 0 {
+					_, err := tw.Write([]byte(e.contents))
+					require.NoError(t, err)
+				}
+			}
+			require.NoError(t, tw.Close())
+			root := t.TempDir()
+			_, err := Apply(context.Background(), root, bytes.NewReader(data.Bytes()), WithNoSameOwner())
+			if tc.wantError {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			for path, want := range tc.files {
+				got, err := os.ReadFile(filepath.Join(root, path))
+				require.NoError(t, err)
+				require.Equal(t, want, string(got))
+			}
+		})
+	}
+}
+
+func TestConsecutiveParentCustomCallbacks(t *testing.T) {
+	// A custom filter deliberately changes an existing parent. Default Apply
+	// must not reuse a parent across an arbitrary callback.
+	root := t.TempDir()
+	var data bytes.Buffer
+	tw := tar.NewWriter(&data)
+	for _, name := range []string{"a/one", "a/two"} {
+		require.NoError(t, tw.WriteHeader(&tar.Header{Name: name, Mode: 0644, Size: 1}))
+		_, err := tw.Write([]byte("x"))
+		require.NoError(t, err)
+	}
+	require.NoError(t, tw.Close())
+	filter := func(h *tar.Header) (bool, error) {
+		if strings.HasSuffix(h.Name, "two") {
+			require.NoError(t, os.RemoveAll(filepath.Join(root, "a")))
+			require.NoError(t, os.Mkdir(filepath.Join(root, "b"), 0755))
+			require.NoError(t, os.Symlink("b", filepath.Join(root, "a")))
+		}
+		return true, nil
+	}
+	_, err := Apply(context.Background(), root, bytes.NewReader(data.Bytes()), WithFilter(filter), WithNoSameOwner())
+	require.NoError(t, err)
+	got, err := os.ReadFile(filepath.Join(root, "b/two"))
+	require.NoError(t, err)
+	require.Equal(t, "x", string(got))
+}
