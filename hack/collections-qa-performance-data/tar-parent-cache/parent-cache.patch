+// WithConsecutiveParentCache reuses a verified, non-aliased parent directory
+// between consecutive regular-file entries. Callbacks must not mutate parent
+// paths for ordinary files. The cache is local to one Apply invocation.
+// Experimental: used by the standard overlay converter only in this prototype.
+func WithConsecutiveParentCache() ApplyOpt {
+	return func(options *ApplyOptions) error {
+		options.cacheConsecutiveParents = true
