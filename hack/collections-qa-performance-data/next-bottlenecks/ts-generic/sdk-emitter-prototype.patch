+package templates
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// RenderDangTypeDefinitions emits the body of ModuleEntrypoint.types from the
+// same analyzer model as the TypeScript registration entrypoint. It performs no
+// source scanning, runtime execution or caching. The SDK's shared entrypoint
+// owns the call() implementation; this function only emits static metadata.
+func RenderDangTypeDefinitions(module *TypedefModule) (string, error) {
+	if module == nil {
+		return "", fmt.Errorf("missing typedef module")
+	}
+	c := &dangMetadataEmitter{defaults: &entrypointFuncCtx{module: module}}
+	var body strings.Builder
+	var defs []string
+	for i, key := range sortedObjectKeys(module.Objects) {
+		obj := module.Objects[key]
+		if obj == nil {
+			return "", fmt.Errorf("nil object %q", key)
+		}
+		name := fmt.Sprintf("obj%d", i)
+		expr := "typeDef.withObject(" + jsString(obj.Name) + dangDescription(obj.Description) + dangOption("deprecated", obj.Deprecated) + dangLocation(obj.Location) + ")"
+		if obj.IsCollection {
+			expr += ".withCollection"
+		}
+		for _, key := range sortedFunctionKeys(obj.Methods) {
+			fn := obj.Methods[key]
+			if fn == nil {
+				return "", fmt.Errorf("nil function %q", key)
+			}
+			if fn.IsCollectionGet {
+				n := fn.Name
+				if fn.Alias != "" {
+					n = fn.Alias
+				}
+				expr += ".withCollectionGet(" + jsString(n) + ")"
+			}
+		}
+		fmt.Fprintf(&body, "let %s = %s\n", name, expr)
+		for _, key := range sortedFunctionKeys(obj.Methods) {
+			fn, err := c.function(obj.Methods[key])
+			if err != nil {
+				return "", err
+			}
+			fmt.Fprintf(&body, "  .withFunction(%s)\n", fn)
+		}
+		for _, key := range sortedPropertyKeys(obj.Properties) {
+			p := obj.Properties[key]
+			if p == nil {
+				return "", fmt.Errorf("nil property %q", key)
+			}
+			if !p.IsExposed {
+				continue
+			}
+			t, err := c.typeDef(p.Type)
+			if err != nil {
+				return "", err
+			}
+			fmt.Fprintf(&body, "  .withField(%s, %s%s%s%s)\n", jsString(propFieldName(p)), t, dangDescription(p.Description), dangOption("deprecated", p.Deprecated), dangLocation(p.Location))
+			if p.IsCollectionKeys {
+				fmt.Fprintf(&body, "  .withCollectionKeys(%s)\n", jsString(propFieldName(p)))
+			}
+			if p.IsCollectionDelta {
+				fmt.Fprintf(&body, "  .withCollectionDelta(%s)\n", jsString(propFieldName(p)))
+			}
+		}
+		if obj.Constructor != nil {
+			ctor := "function(\"\", " + name + ")"
+			for _, a := range obj.Constructor.Arguments {
+				v, err := c.arg(a)
+				if err != nil {
+					return "", err
+				}
+				ctor += v
+			}
+			fmt.Fprintf(&body, "let %sWithConstructor = %s.withConstructor(%s)\n", name, name, ctor)
+			name += "WithConstructor"
+		}
+		defs = append(defs, name)
+	}
+	for i, key := range sortedEnumKeys(module.Enums) {
+		e := module.Enums[key]
+		if e == nil {
+			return "", fmt.Errorf("nil enum %q", key)
+		}
+		name := fmt.Sprintf("enum%d", i)
+		fmt.Fprintf(&body, "let %s = typeDef.withEnum(%s%s%s)\n", name, jsString(e.Name), dangDescription(e.Description), dangLocation(e.Location))
+		for _, key := range sortedEnumValueKeys(e.Values) {
+			v := e.Values[key]
+			if v == nil {
+				return "", fmt.Errorf("nil enum value %q", key)
+			}
+			fmt.Fprintf(&body, "  .withEnumMember(%s, value: %s%s%s%s)\n", jsString(v.Name), jsString(v.Value), dangDescription(v.Description), dangOption("deprecated", v.Deprecated), dangLocation(v.Location))
+		}
+		defs = append(defs, name)
+	}
+	for i, key := range sortedInterfaceKeys(module.Interfaces) {
+		it := module.Interfaces[key]
+		if it == nil {
+			return "", fmt.Errorf("nil interface %q", key)
+		}
+		name := fmt.Sprintf("iface%d", i)
+		fmt.Fprintf(&body, "let %s = typeDef.withInterface(%s%s%s)\n", name, jsString(it.Name), dangDescription(it.Description), dangLocation(it.Location))
+		for _, key := range sortedFunctionKeys(it.Functions) {
+			v, err := c.function(it.Functions[key])
+			if err != nil {
+				return "", err
+			}
+			fmt.Fprintf(&body, "  .withFunction(%s)\n", v)
+		}
+		defs = append(defs, name)
+	}
+	fmt.Fprintf(&body, "[%s]\n", strings.Join(defs, ", "))
+	return body.String(), nil
+}
+
+type dangMetadataEmitter struct{ defaults *entrypointFuncCtx }
+
+func dangOption(key, value string) string {
+	if value == "" {
+		return ""
+	}
+	return ", " + key + ": " + jsString(value)
+}
+func dangDescription(value string) string { return dangOption("description", value) }
+func dangSourceMap(loc *TypedefLocation) string {
+	return fmt.Sprintf("sourceMap(%s, %d, %d)", jsString(loc.Filepath), loc.Line, loc.Column)
+}
+func dangLocation(loc *TypedefLocation) string {
+	if loc == nil {
+		return ""
+	}
+	return ", sourceMap: " + dangSourceMap(loc)
+}
+
+func (c *dangMetadataEmitter) typeDef(t *TypedefType) (string, error) {
+	if t == nil {
+		return "typeDef", nil
+	}
+	switch t.Kind {
+	case KindScalar:
+		return "typeDef.withScalar(" + jsString(t.Name) + ")", nil
+	case KindObject:
+		return "typeDef.withObject(" + jsString(t.Name) + ")", nil
+	case KindEnum:
+		return "typeDef.withEnum(" + jsString(t.Name) + ")", nil
+	case KindInterface:
+		return "typeDef.withInterface(" + jsString(t.Name) + ")", nil
+	case KindList:
+		e, err := c.typeDef(t.TypeDef)
+		if err != nil {
+			return "", err
+		}
+		return "typeDef.withListOf(" + e + ")", nil
+	case KindVoid:
+		return "typeDef.withKind(TypeDefKind.VOID_KIND).withOptional(true)", nil
+	case KindString, KindInteger, KindFloat, KindBoolean:
+		return "typeDef.withKind(TypeDefKind." + t.Kind + ")", nil
+	default:
+		return "", fmt.Errorf("unsupported TypeDef kind %q", t.Kind)
+	}
+}
+
+func (c *dangMetadataEmitter) arg(a *TypedefArgument) (string, error) {
+	if a == nil {
+		return "", fmt.Errorf("nil argument")
+	}
+	t, err := c.typeDef(a.Type)
+	if err != nil {
+		return "", err
+	}
+	if a.IsOptional {
+		t += ".withOptional(true)"
+	}
+	opts := dangDescription(a.Description) + dangOption("deprecated", a.Deprecated) + dangOption("defaultPath", a.DefaultPath) + dangOption("defaultAddress", a.DefaultAddress) + dangLocation(a.Location)
+	if len(a.Ignore) > 0 {
+		parts := make([]string, len(a.Ignore))
+		for i, p := range a.Ignore {
+			parts[i] = jsString(p)
+		}
+		opts += ", ignore: [" + strings.Join(parts, ", ") + "]"
+	}
+	if len(a.DefaultValue) > 0 {
+		// Share the existing TS emitter's enum/default normalization. The JSON
+		// scalar receives serialized JSON bytes, not an enum's runtime value.
+		value, ok := c.defaults.resolveDefaultValue(a)
+		if !ok {
+			if !a.IsOptional {
+				t += ".withOptional(true)"
+			}
+		} else {
+			b, err := json.Marshal(value)
+			if err != nil {
+				return "", err
+			}
+			opts += ", defaultValue: (" + jsString(string(b)) + " :: Dagger.JSON!)"
+		}
+	}
+	return ".withArg(" + jsString(a.Name) + ", " + t + opts + ")", nil
+}
+
+func (c *dangMetadataEmitter) function(f *TypedefFunction) (string, error) {
+	if f == nil {
+		return "", fmt.Errorf("nil function")
+	}
+	name := f.Name
+	if f.Alias != "" {
+		name = f.Alias
+	}
+	t, err := c.typeDef(f.ReturnType)
+	if err != nil {
+		return "", err
+	}
+	out := "function(" + jsString(name) + ", " + t + ")"
+	if f.Description != "" {
+		out += ".withDescription(" + jsString(f.Description) + ")"
+	}
+	if f.Location != nil {
+		out += ".withSourceMap(" + dangSourceMap(f.Location) + ")"
+	}
+	for _, a := range f.Arguments {
+		v, err := c.arg(a)
+		if err != nil {
+			return "", err
+		}
+		out += v
+	}
+	switch f.Cache {
+	case "", "default":
+	case "never":
+		out += ".withCachePolicy(FunctionCachePolicy.Never)"
+	case "session":
+		out += ".withCachePolicy(FunctionCachePolicy.PerSession)"
+	default:
+		out += ".withCachePolicy(FunctionCachePolicy.Default, timeToLive: " + jsString(f.Cache) + ")"
+	}
+	if f.Deprecated != "" {
+		out += ".withDeprecated(reason: " + jsString(f.Deprecated) + ")"
+	}
+	if f.IsCheck {
+		out += ".withCheck"
+	}
+	if f.IsGenerator {
+		out += ".withGenerator"
+	}
+	if f.IsUp {
+		out += ".withUp"
+	}
+	if f.IsAgent {
+		out += ".withAgent"
+	}
+	return out, nil
+}
+
+// RenderDangTypesEntrypoint wraps generated metadata for the existing engine's
+// ModuleEntrypoint.types driver. SDK runtime calls still use the generated TS
+// dispatch file; the engine overlay deliberately invokes this for types only.
+// The final upstream shared-entrypoint adapter must own its real call method.
+func RenderDangTypesEntrypoint(module *TypedefModule) (string, error) {
+	body, err := RenderDangTypeDefinitions(module)
+	if err != nil {
+		return "", err
+	}
+	return "# Generated from the same analyzer model as __dagger.entrypoint.ts.\n" +
+		"type Entrypoint implements ModuleEntrypoint {\n" +
+		"  pub types(workspace: Workspace!): [TypeDef!]! {\n" + body + "  }\n" +
+		"  pub call(workspace: Workspace!, receiverType: String!, receiverValue: JSON, fnName: String!, fnArgs: JSON!): JSON! {\n" +
+		"    raise \"metadata-only adapter: calls must use the TypeScript runtime\"\n  }\n}\n", nil
+}
