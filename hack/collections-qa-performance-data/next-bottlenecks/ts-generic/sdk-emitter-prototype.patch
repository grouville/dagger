+package templates
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/vito/dang/v2/pkg/dang"
+)
+
+// These models use the real analyzer JSON contract. They exercise metadata
+// emission independently of the engine; analyzer round-trip and engine schema
+// equivalence remain integration checks, not assertions of this unit suite.
+func staticFixture(t *testing.T, name string) *TypedefModule {
+	t.Helper()
+	var m TypedefModule
+	if err := json.Unmarshal([]byte(staticFixtures[name]), &m); err != nil {
+		t.Fatal(err)
+	}
+	return &m
+}
+
+func TestDangStaticMetadataFixtureContracts(t *testing.T) {
+	tests := []struct {
+		name         string
+		want, absent []string
+	}{
+		{"catalog", []string{
+			`withEnum("Mode"`, `withEnumMember("FAST", value: "fast"`,
+			`withInterface("Reporter"`, `withArg("reporter", typeDef.withInterface("Reporter").withOptional(true)`,
+			`defaultValue: ("\"FAST\"" :: Dagger.JSON!)`, `defaultValue: ("null" :: Dagger.JSON!)`,
+			`defaultPath: "/project"`, `defaultAddress: "dag://tool/source"`, `ignore: [".git", "dist/**"]`,
+			`withListOf(typeDef.withKind(TypeDefKind.STRING_KIND))`,
+			`.withCheck`, `.withGenerator`, `.withUp`, `.withAgent`,
+			`.withCachePolicy(FunctionCachePolicy.PerSession)`,
+			`.withCachePolicy(FunctionCachePolicy.Default, timeToLive: "5m")`,
+			`sourceMap("src/index.ts", 7, 1)`, `.withDeprecated(reason: "use lint")`,
+			`function("", obj0)`, `.withField("source"`,
+		}, []string{`.withField("secret"`, `function("lintImpl"`, `defaultValue: ("\"fast\""`}},
+		{"catalog-items", []string{
+			`withObject("CatalogItems").withCollection.withCollectionGet("lookup")`,
+			`withField("names", typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND)))`,
+			`.withCollectionKeys("names")`, `.withCollectionDelta("selection")`,
+			`function("lookup", typeDef.withObject("Entry"))`,
+			`.withCachePolicy(FunctionCachePolicy.Never)`,
+			`typeDef.withKind(TypeDefKind.VOID_KIND).withOptional(true)`,
+			`typeDef.withScalar("JSON")`,
+		}, nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			m := staticFixture(t, tt.name)
+			before, _ := json.Marshal(m)
+			source, err := RenderDangTypesEntrypoint(m)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := dang.Parse(tt.name+".dang", []byte(source)); err != nil {
+				t.Fatalf("invalid emitted Dang: %v\n%s", err, source)
+			}
+			for _, want := range tt.want {
+				if !strings.Contains(source, want) {
+					t.Errorf("missing %q\n%s", want, source)
+				}
+			}
+			for _, bad := range tt.absent {
+				if strings.Contains(source, bad) {
+					t.Errorf("unexpected %q", bad)
+				}
+			}
+			again, err := RenderDangTypesEntrypoint(m)
+			if err != nil || again != source {
+				t.Fatal("nondeterministic emission", err)
+			}
+			after, _ := json.Marshal(m)
+			if string(before) != string(after) {
+				t.Fatal("emitter mutated analyzer output")
+			}
+		})
+	}
+}
+
+func TestDangStaticMetadataAPIEditChangesOutput(t *testing.T) {
+	m := staticFixture(t, "catalog")
+	before, err := RenderDangTypesEntrypoint(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.Objects["Catalog"].Methods["lintImpl"].Alias = "validate"
+	after, err := RenderDangTypesEntrypoint(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if before == after || !strings.Contains(after, `function("validate"`) || strings.Contains(after, `function("lint"`) {
+		t.Fatal("API alias edit not reflected")
+	}
+}
+
+func TestDangStaticMetadataRejectsUnrepresentableTypes(t *testing.T) {
+	m := staticFixture(t, "catalog")
+	m.Objects["Catalog"].Methods["lintImpl"].ReturnType = &TypedefType{Kind: KindInput}
+	if _, err := RenderDangTypesEntrypoint(m); err == nil {
+		t.Fatal("input object silently dropped")
+	}
+	if _, err := RenderDangTypesEntrypoint(nil); err == nil {
+		t.Fatal("nil module accepted")
+	}
+}
+
+func TestDangStaticMetadataUnresolvedDefaultMatchesDispatch(t *testing.T) {
+	m := staticFixture(t, "catalog")
+	a := &TypedefArgument{Name: "build", Type: &TypedefType{Kind: KindObject, Name: "Container"}, DefaultValue: json.RawMessage(`"dag.container()"`)}
+	old := (&entrypointFuncCtx{module: m}).renderArgCall(a)
+	got, err := (&dangMetadataEmitter{defaults: &entrypointFuncCtx{module: m}}).arg(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(old, "withOptional(true)") || !strings.Contains(got, "withOptional(true)") || strings.Contains(got, "defaultValue:") {
+		t.Fatalf("runtime default contract differs: %s / %s", old, got)
+	}
+}
