+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"typescript-sdk/internal/dagger"
+)
+
+// Seal only during generation, after dispatch, client bindings and compiler
+// configuration have all been overlaid. Source/dispatch/metadata must be one
+// generation transaction; calling this on a subsequently edited tree would
+// incorrectly bless an old dispatch contract.
+func sealStaticMetadata(ctx context.Context, generated *dagger.Directory) (*dagger.Directory, error) {
+	const metadataDir = ".dagger-static-types"
+	infoText, err := generated.File(metadataDir + "/module.json").Contents(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var info struct {
+		Name        string `json:"name"`
+		Description string `json:"description"`
+	}
+	if err := json.Unmarshal([]byte(infoText), &info); err != nil {
+		return nil, err
+	}
+	inputs := map[string]string{}
+	paths, err := generated.Glob(ctx, "**/*")
+	if err != nil {
+		return nil, err
+	}
+	for _, path := range paths {
+		if strings.HasSuffix(path, "/") || strings.HasPrefix(path, metadataDir+"/") || strings.HasPrefix(path, "node_modules/") || strings.HasPrefix(path, ".git/") {
+			continue
+		}
+		digest, err := generated.File(path).Digest(ctx, dagger.FileDigestOpts{ExcludeMetadata: true})
+		if err != nil {
+			return nil, fmt.Errorf("input %s: %w", path, err)
+		}
+		inputs[path] = digest
+	}
+	entrypoint, err := generated.File(metadataDir + "/main.dang").Contents(ctx)
+	if err != nil {
+		return nil, err
+	}
+	manifest, err := json.Marshal(struct {
+		Version          string            `json:"version"`
+		ModuleName       string            `json:"moduleName"`
+		Description      string            `json:"description"`
+		Inputs           map[string]string `json:"inputs"`
+		EntrypointSHA256 string            `json:"entrypointSHA256"`
+	}{"ts-static-metadata-v1", info.Name, info.Description, inputs, fmt.Sprintf("%x", sha256.Sum256([]byte(entrypoint)))})
+	if err != nil {
+		return nil, err
+	}
+	return generated.WithNewFile(metadataDir+"/manifest.json", string(manifest)), nil
+}
