+  "constructor":{"name":"Catalog","arguments":[{"name":"source","type":{"kind":"OBJECT_KIND","name":"Directory"},"defaultPath":"/project","ignore":[".git","dist/**"]}]},
+  "properties":{"source":{"name":"source","isExposed":true,"type":{"kind":"OBJECT_KIND","name":"Directory"}},"secret":{"name":"secret","isExposed":false,"type":{"kind":"STRING_KIND"}}},
+  "methods":{
