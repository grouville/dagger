+func TestSparseExportIndependentPermissions(t *testing.T) {
+	root := t.TempDir()
+	forbidden := filepath.Join(root, "unrelated")
+	if err := os.Mkdir(forbidden, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(forbidden, "private"), []byte("not part of transfer"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(forbidden, 0); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(forbidden, 0755) })
+	dw, err := NewDiskWriter(t.Context(), root, DiskWriterOpt{SyncDataCb: func(_ context.Context, _ string, w io.WriteCloser) error {
+		_, err := io.WriteString(w, "expected generated output")
+		return err
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	st := &types.Stat{Mode: 0644, ModTime: time.Unix(1700000000, 0).UnixNano(), Uid: uint32(os.Getuid()), Gid: uint32(os.Getgid())}
+	if err := dw.HandleChange(ChangeKindAdd, "generated.txt", &StatInfo{st}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if err := dw.Wait(t.Context()); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(root, "generated.txt"))
+	if err != nil || string(data) != "expected generated output" {
+		t.Fatalf("bad exported bytes: %v", err)
+	}
+}
