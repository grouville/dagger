+func TestSparseReceiveMergePreservesUnchangedAndNonMergeDeletes(t *testing.T) {
+	for _, merge := range []bool{true, false} {
+		t.Run(map[bool]string{true: "merge", false: "replace"}[merge], func(t *testing.T) {
+			source, dest := t.TempDir(), t.TempDir()
+			require.NoError(t, os.Mkdir(filepath.Join(source, "generated"), 0755))
+			require.NoError(t, os.WriteFile(filepath.Join(source, "generated", "file"), []byte("new"), 0755))
+			require.NoError(t, os.Symlink("file", filepath.Join(source, "generated", "link")))
+			require.NoError(t, os.Link(filepath.Join(source, "generated", "file"), filepath.Join(source, "generated", "hardlink")))
+			require.NoError(t, os.WriteFile(filepath.Join(dest, "untouched"), []byte("user edit"), 0644))
+			require.NoError(t, os.Mkdir(filepath.Join(dest, "generated"), 0755))
+			require.NoError(t, os.WriteFile(filepath.Join(dest, "generated", "file"), []byte("old"), 0644))
+			fs, err := NewFS(source)
+			require.NoError(t, err)
+			ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+			defer cancel()
+			toSender, toReceiver := make(chan []byte, 128), make(chan []byte, 128)
+			sent := make(chan error, 1)
+			go func() { sent <- Send(ctx, sparsePacketStream{ctx, toSender, toReceiver}, fs, nil); close(toReceiver) }()
+			err = Receive(ctx, sparsePacketStream{ctx, toReceiver, toSender}, dest, ReceiveOpt{Merge: merge})
+			require.NoError(t, err)
+			require.NoError(t, <-sent)
+			data, err := os.ReadFile(filepath.Join(dest, "generated", "file"))
+			require.NoError(t, err)
+			require.Equal(t, "new", string(data))
+			data, err = os.ReadFile(filepath.Join(dest, "generated", "link"))
+			require.NoError(t, err)
+			require.Equal(t, "new", string(data))
+			first, err := os.Stat(filepath.Join(dest, "generated", "file"))
+			require.NoError(t, err)
+			second, err := os.Stat(filepath.Join(dest, "generated", "hardlink"))
+			require.NoError(t, err)
+			require.True(t, os.SameFile(first, second))
+			data, err = os.ReadFile(filepath.Join(dest, "untouched"))
+			if merge {
+				require.NoError(t, err)
+				require.Equal(t, "user edit", string(data))
+			} else {
+				require.ErrorIs(t, err, os.ErrNotExist)
+			}
+		})
+	}
+}
