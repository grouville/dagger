+func TestSparseDirectoryTimesWindowsRootSpelling(t *testing.T) {
+	if runtime.GOOS != "windows" {
+		t.Skip("Windows path and volume semantics")
+	}
+	const root = `C:\root`
+	const recorded = `c:\root\child`
+	var visited, updated []string
+	err := restoreDirectoryTimes(root, map[string]int64{recorded: 9}, func(p string) (os.FileInfo, error) {
+		visited = append(visited, p)
+		return &StatInfo{&types.Stat{Mode: uint32(os.ModeDir | 0755)}}, nil
+	}, func(p string, _ int64) error { updated = append(updated, p); return nil })
+	require.NoError(t, err)
+	require.Equal(t, []string{root, root + `\child`}, visited)
+	require.Equal(t, []string{recorded}, updated)
+	require.Error(t, restoreDirectoryTimes(root, map[string]int64{`D:\elsewhere`: 9},
+		func(string) (os.FileInfo, error) { t.Fatal("read a different volume"); return nil, nil }, chtimes))
+}
