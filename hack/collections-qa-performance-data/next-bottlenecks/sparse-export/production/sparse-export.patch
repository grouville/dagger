+func TestSparseDiskWriterWaitsForDataAndRestoresDirectoryTimes(t *testing.T) {
+	root := t.TempDir()
+	started, release := make(chan struct{}), make(chan struct{})
+	dw, err := NewDiskWriter(t.Context(), root, DiskWriterOpt{AsyncDataCb: func(_ context.Context, _ string, w io.WriteCloser) error {
+		close(started)
+		<-release
+		_, err := io.WriteString(w, "generated data")
+		closeErr := w.Close()
+		return errors.Join(err, closeErr)
+	}})
+	require.NoError(t, err)
+	timestamp := time.Unix(1700000000, 123456700)
+	for _, p := range []string{"parent", "parent/child"} {
+		st := &types.Stat{Path: p, Mode: uint32(os.ModeDir | 0755), ModTime: timestamp.UnixNano(), Uid: uint32(os.Getuid()), Gid: uint32(os.Getgid())}
+		require.NoError(t, dw.HandleChange(ChangeKindAdd, filepath.FromSlash(p), &StatInfo{st}, nil))
+	}
+	st := &types.Stat{Path: "parent/child/file", Mode: 0755, ModTime: timestamp.UnixNano(), Uid: uint32(os.Getuid()), Gid: uint32(os.Getgid())}
+	require.NoError(t, dw.HandleChange(ChangeKindAdd, filepath.FromSlash(st.Path), &StatInfo{st}, nil))
+	<-started
+	done := make(chan error, 1)
+	go func() { done <- dw.Wait(t.Context()) }()
+	select {
+	case err := <-done:
+		t.Fatalf("returned before data completion: %v", err)
+	default:
+	}
+	close(release)
+	require.NoError(t, <-done)
+	data, err := os.ReadFile(filepath.Join(root, "parent", "child", "file"))
+	require.NoError(t, err)
+	require.Equal(t, "generated data", string(data))
+	for _, p := range []string{"parent", "parent/child", "parent/child/file"} {
+		fi, err := os.Stat(filepath.Join(root, filepath.FromSlash(p)))
+		require.NoError(t, err)
+		require.Equal(t, timestamp.UnixNano(), fi.ModTime().UnixNano(), p)
+		if runtime.GOOS != "windows" {
+			require.Equal(t, os.FileMode(0755), fi.Mode().Perm(), p)
+		}
+	}
+}
+
+type sparsePacketStream struct {
+	ctx context.Context
+	in  <-chan []byte
+	out chan<- []byte
+}
+
+func (s sparsePacketStream) Context() context.Context { return s.ctx }
+func (s sparsePacketStream) SendMsg(m interface{}) error {
+	data, err := m.(*types.Packet).Marshal()
+	if err != nil {
+		return err
+	}
+	select {
+	case s.out <- data:
+		return nil
+	case <-s.ctx.Done():
+		return s.ctx.Err()
+	}
+}
+func (s sparsePacketStream) RecvMsg(m interface{}) error {
+	select {
+	case data, ok := <-s.in:
+		if !ok {
+			return io.EOF
+		}
+		return m.(*types.Packet).Unmarshal(data)
+	case <-s.ctx.Done():
+		return s.ctx.Err()
+	}
+}
