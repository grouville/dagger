+func TestSparseDirectoryTimesOnlyVisitsRecordedAncestors(t *testing.T) {
+	root := t.TempDir()
+	changed := filepath.Join(root, "generated", "nested")
+	require.NoError(t, os.MkdirAll(changed, 0755))
+	unrelated := filepath.Join(root, "unrelated", "deep", "unreadable")
+	require.NoError(t, os.MkdirAll(unrelated, 0755))
+	require.NoError(t, os.Chmod(filepath.Join(root, "unrelated"), 0))
+	t.Cleanup(func() { _ = os.Chmod(filepath.Join(root, "unrelated"), 0755) })
+	var visited, updated []string
+	// The seam asserts the scope even when tests run as root and mode 000 is
+	// readable. Any access outside these three paths fails this test.
+	permitted := map[string]bool{root: true, filepath.Dir(changed): true, changed: true}
+	err := restoreDirectoryTimes(root, map[string]int64{changed: 123}, func(p string) (os.FileInfo, error) {
+		require.True(t, permitted[p], "unrelated path visited: %s", p)
+		visited = append(visited, p)
+		return os.Lstat(p)
+	}, func(p string, _ int64) error { updated = append(updated, p); return nil })
+	require.NoError(t, err)
+	require.Equal(t, []string{root, filepath.Dir(changed), changed}, visited)
+	require.Equal(t, []string{changed}, updated)
+	// A transfer that creates no directories needs no final filesystem work.
+	require.NoError(t, restoreDirectoryTimes(root, nil, func(p string) (os.FileInfo, error) {
+		t.Fatalf("empty finalization visited %q", p)
+		return nil, nil
+	}, nil))
+}
+
+func TestSparseDirectoryTimesSkipsDeletedAndReplacedSubtrees(t *testing.T) {
+	for _, replacement := range []string{"deleted", "file", "symlink"} {
+		t.Run(replacement, func(t *testing.T) {
+			root, outside := t.TempDir(), t.TempDir()
+			parent := filepath.Join(root, "parent")
+			nested := filepath.Join(parent, "nested")
+			require.NoError(t, os.MkdirAll(nested, 0755))
+			outsideChild := filepath.Join(outside, "nested")
+			require.NoError(t, os.MkdirAll(outsideChild, 0755))
+			marker := time.Unix(1234, 0)
+			require.NoError(t, os.Chtimes(outsideChild, marker, marker))
+			require.NoError(t, os.RemoveAll(parent))
+			switch replacement {
+			case "file":
+				require.NoError(t, os.WriteFile(parent, []byte("independent"), 0644))
+			case "symlink":
+				require.NoError(t, os.Symlink(outside, parent))
+			}
+			var visited []string
+			err := restoreDirectoryTimes(root, map[string]int64{parent: 7, nested: 8}, func(p string) (os.FileInfo, error) {
+				visited = append(visited, p)
+				return os.Lstat(p)
+			}, func(p string, _ int64) error { t.Fatalf("updated replaced path %q", p); return nil })
+			require.NoError(t, err)
+			require.Equal(t, []string{root, parent}, visited)
+			got, err := os.Stat(outsideChild)
+			require.NoError(t, err)
+			require.Equal(t, marker, got.ModTime())
+		})
+	}
+}
+
+func TestSparseDirectoryTimesRootSymlinkAndRelevantErrors(t *testing.T) {
+	root, outside := t.TempDir(), t.TempDir()
+	link := filepath.Join(root, "link")
+	require.NoError(t, os.Symlink(outside, link))
+	require.NoError(t, restoreDirectoryTimes(link, map[string]int64{filepath.Join(link, "child"): 9}, os.Lstat,
+		func(p string, _ int64) error { t.Fatalf("followed root symlink %q", p); return nil }))
+	expected := &os.PathError{Op: "lstat", Path: filepath.Join(root, "relevant"), Err: os.ErrPermission}
+	err := restoreDirectoryTimes(root, map[string]int64{expected.Path: 9}, func(p string) (os.FileInfo, error) {
+		if p == expected.Path {
+			return nil, expected
+		}
+		return os.Lstat(p)
+	}, chtimes)
+	require.ErrorIs(t, err, os.ErrPermission)
+	require.True(t, errors.Is(err, expected))
+	require.ErrorIs(t, restoreDirectoryTimes(root, map[string]int64{root: 9}, os.Lstat,
+		func(string, int64) error { return os.ErrPermission }), os.ErrPermission)
+	for _, p := range []string{root + "-prefix-collision", filepath.Join(root, "..", "outside")} {
+		require.Error(t, restoreDirectoryTimes(root, map[string]int64{p: 9},
+			func(string) (os.FileInfo, error) { t.Fatal("read escaped path"); return nil, nil }, chtimes))
+	}
+}
+
+func TestSparseDirectoryTimesPreservesWalkOrderAndSharedAncestors(t *testing.T) {
+	root := t.TempDir()
+	names := []string{"a", "a/z", "a-/b", "a-/c", "b"}
+	times := make(map[string]int64)
+	for _, name := range names {
+		p := filepath.Join(root, filepath.FromSlash(name))
+		require.NoError(t, os.MkdirAll(p, 0755))
+		times[p] = 9
+	}
+	var updated []string
+	visited := make(map[string]int)
+	require.NoError(t, restoreDirectoryTimes(root, times, func(p string) (os.FileInfo, error) {
+		visited[p]++
+		return os.Lstat(p)
+	}, func(p string, _ int64) error {
+		rel, err := filepath.Rel(root, p)
+		require.NoError(t, err)
+		updated = append(updated, filepath.ToSlash(rel))
+		return nil
+	}))
+	require.Equal(t, names, updated)
+	for p, count := range visited {
+		require.Equal(t, 1, count, p)
+	}
+	// Relative destination spelling remains supported without absolute-path conversion.
+	workdir, err := os.Getwd()
+	require.NoError(t, err)
+	relroot, err := filepath.Rel(workdir, root)
+	require.NoError(t, err)
+	p := filepath.Join(relroot, "a")
+	require.NoError(t, restoreDirectoryTimes(relroot, map[string]int64{p: 9}, os.Lstat, chtimes))
+}
