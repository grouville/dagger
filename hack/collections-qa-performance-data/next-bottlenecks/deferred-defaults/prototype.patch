+func TestPreparedContainerPreflightRejectsUnsupportedDefaultsWithoutResolving(t *testing.T) {
+	objectType := func(name string) dagql.ObjectResult[*TypeDef] {
+		return defaultTestObject(t, &TypeDef{Kind: TypeDefKindObject, AsObject: dagql.NonNull(defaultTestObject(t, &ObjectTypeDef{Name: name, OriginalName: name}))})
+	}
+	mod := &Module{NameField: "producer", OriginalName: "Producer", WorkspaceConfig: map[string]any{"file": "dag://expensive/file"}}
+	plan := PreparedContainerDefault{Module: defaultTestObject(t, mod)}
+	obj := &ObjectTypeDef{Name: "Producer", OriginalName: "Producer"}
+	// No query/cache/server: rejecting configured object defaults must be a
+	// metadata decision, before address resolution or runtime invocation.
+	for _, tc := range []struct {
+		name string
+		arg  *FunctionArg
+		want bool
+	}{
+		{"directory defaultPath", &FunctionArg{Name: "source", OriginalName: "source", TypeDef: objectType("Directory"), DefaultPath: "/"}, true},
+		{"file defaultPath", &FunctionArg{Name: "source", OriginalName: "source", TypeDef: objectType("File"), DefaultPath: "/x"}, false},
+		{"workspace", &FunctionArg{Name: "ws", OriginalName: "ws", TypeDef: objectType("Workspace")}, false},
+		{"configured object", &FunctionArg{Name: "file", OriginalName: "file", TypeDef: objectType("File")}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fn := &Function{Args: dagql.ObjectResultArray[*FunctionArg]{defaultTestObject(t, tc.arg)}}
+			ok, err := plan.canPrepareArguments(t.Context(), obj, fn)
+			require.NoError(t, err)
+			require.Equal(t, tc.want, ok)
+		})
+	}
+}
