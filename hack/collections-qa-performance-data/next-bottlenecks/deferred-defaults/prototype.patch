+func TestPreparedContainerRestoredOwner(t *testing.T) {
+	lazy := &ContainerDeferredDefaultLazy{LazyState: NewLazyState()}
+	ctr := NewContainer(Platform{})
+	ctr.Lazy = &ContainerRestoreLazy{LazyState: &lazy.LazyState, recipe: lazy}
