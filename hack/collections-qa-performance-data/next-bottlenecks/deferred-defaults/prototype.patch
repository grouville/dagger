+func TestPreparedContainerRejectsDifferentSessionBeforeResolvingWorkspace(t *testing.T) {
+	bindings := frozenContainerArguments{SessionID: "owner-session"}
+	raw, err := json.Marshal(bindings)
+	require.NoError(t, err)
+	plan := PreparedContainerDefault{Bindings: raw}
+	// There is deliberately no workspace, module, query or client transport.
+	// A cross-session force must be rejected before touching any of them.
+	ctx := engine.ContextWithClientMetadata(t.Context(), &engine.ClientMetadata{ClientID: "other-client", SessionID: "other-session"})
+	_, err = plan.Evaluate(ctx)
+	require.ErrorContains(t, err, "different session")
+	nested := engine.ContextWithClientMetadata(t.Context(), &engine.ClientMetadata{ClientID: "nested-module", SessionID: "owner-session"})
+	require.NoError(t, bindings.checkSession(nested), "an authorized nested SDK caller stays in the same session")
+	require.Error(t, bindings.checkSession(t.Context()))
+}
