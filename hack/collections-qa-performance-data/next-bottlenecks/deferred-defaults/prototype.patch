+func deferredDefaultContainer(ctx context.Context, address dagql.ObjectResult[*core.Address], _ struct{}) (dagql.ObjectResult[*core.Container], error) {
+	var result dagql.ObjectResult[*core.Container]
+	addr := address.Self()
+	ws := addr.BoundWorkspace
+	if !dagaddress.IsAddress(addr.Value) {
+		return (&addressSchema{}).container(ctx, address, struct{}{})
+	}
+	if ws.Self() == nil {
+		return result, fmt.Errorf("resolve %q: a DAG address needs a workspace; use Workspace.resolve", addr.Value)
+	}
+	parsed, err := dagaddress.Parse(addr.Value)
+	if err != nil {
+		return result, err
+	}
+	ctx, err = withWorkspaceClientContext(ctx, ws.Self())
+	if err != nil {
+		return result, err
+	}
+	ctx = core.WorkspaceToContext(ctx, ws)
+	artifact, err := resolveWorkspaceArtifact(ctx, ws, parsed, addr.Value)
+	if err != nil {
+		return result, err
+	}
+	if err := artifact.AssertType(parsed.Types); err != nil {
+		return result, fmt.Errorf("resolve %q: %w", addr.Value, err)
+	}
+	if artifact.TypeName != "Container" {
+		return result, fmt.Errorf("resolve %q: artifact is a %s, not a Container", addr.Value, artifact.TypeName)
+	}
+	normalized, err := artifact.URI(core.ArtifactURIOpts{DimensionKeys: true})
+	if err != nil {
+		return result, err
+	}
+	chain, _ := ctx.Value(moduleRefCycleKey{}).([]string)
+	if slices.Contains(chain, normalized) {
+		return result, fmt.Errorf("module reference cycle detected: %s -> %s", strings.Join(chain, " -> "), normalized)
+	}
+	newChain := append(slices.Clone(chain), normalized)
+	ctx = context.WithValue(ctx, moduleRefCycleKey{}, newChain)
+	plan, supported, err := core.PrepareContainerDefault(ctx, artifact)
+	if err != nil {
+		return result, fmt.Errorf("prepare %q: %w", addr.Value, err)
+	}
+	if !supported {
+		err := artifact.Evaluate(ctx, &result)
+		if err != nil {
+			return result, fmt.Errorf("resolve %q: %w", addr.Value, err)
+		}
+		return result, nil
+	}
+	modID, err := plan.Module.ID()
+	if err != nil {
+		return result, err
+	}
+	wsID, err := plan.Workspace.ID()
+	if err != nil {
+		return result, err
+	}
+	refs := make(dagql.ArrayInput[dagql.AnyID], 0, len(plan.References))
+	for _, ref := range plan.References {
+		id, err := ref.ID()
+		if err != nil {
+			return result, err
+		}
+		refs = append(refs, dagql.NewAnyID(id))
+	}
+	srv, err := core.CurrentDagqlServer(ctx)
+	if err != nil {
+		return result, err
+	}
+	srv = srv.Canonical()
+	err = srv.Select(ctx, srv.Root(), &result, dagql.Selector{Field: "__preparedDefaultContainer", Args: []dagql.NamedInput{
+		{Name: "module", Value: dagql.NewID[*core.Module](modID)},
+		{Name: "workspace", Value: dagql.NewID[*core.Workspace](wsID)},
+		{Name: "function", Value: dagql.String(plan.Function)},
+		{Name: "bindings", Value: plan.Bindings},
+		{Name: "references", Value: refs},
+	}})
+	return result, err
+}
