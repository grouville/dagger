+
+type preparedDefaultContainerArgs struct {
+	Module     dagql.ID[*core.Module]
+	Workspace  dagql.ID[*core.Workspace]
+	Function   string
+	Bindings   core.JSON
+	References dagql.ArrayInput[dagql.AnyID]
+}
+
+func installDeferredContainerDefault(srv *dagql.Server) {
+	field := dagql.FuncWithDynamicInputs("__preparedDefaultContainer", preparedDefaultContainer, func(ctx context.Context, _ dagql.ObjectResult[*core.Query], args preparedDefaultContainerArgs, req *dagql.CallRequest) error {
+		// Conservatively keep scoped plans session-local; normal call identity still
+		// retains the same explicit scope value in the frozen argument recipe.
+		var bindings struct {
+			CacheScope []string `json:"cacheScope"`
+			SessionID  string   `json:"sessionID"`
+		}
+		if err := json.Unmarshal(args.Bindings, &bindings); err != nil {
+			return err
+		}
+		// A live workspace contains an originating client ID, not a portable
+		// authority grant. Pending plans may persist only when all context is
+		// engine-owned; wider persistence needs an explicit rebinding design.
+		srv, err := core.CurrentDagqlServer(ctx)
+		if err != nil {
+			return err
+		}
+		ws, err := args.Workspace.Load(ctx, srv)
+		if err != nil {
+			return err
+		}
+		if bindings.SessionID != "" {
+			md, err := engine.ClientMetadataFromContext(ctx)
+			if err != nil {
+				return err
+			}
+			if md.SessionID != bindings.SessionID {
+				return fmt.Errorf("prepared container belongs to a different session")
+			}
+		} else if !ws.Self().IsValueWorkspace() {
+			return fmt.Errorf("live workspace prepared container is missing its session scope")
+		}
+		req.IsPersistable = bindings.SessionID == "" && len(bindings.CacheScope) == 0 && ws.Self().IsValueWorkspace()
+		return nil
+	}).WithInput(dagql.ImplicitInput{
+		Name: dagql.PerSessionInput.Name,
+		Resolver: func(ctx context.Context, args map[string]dagql.Input) (dagql.Input, error) {
+			var bindings struct {
+				SessionID string `json:"sessionID"`
+			}
+			raw, ok := args["bindings"].(core.JSON)
+			if !ok {
+				return nil, fmt.Errorf("missing prepared container bindings")
+			}
+			if err := json.Unmarshal(raw, &bindings); err != nil {
+				return nil, err
+			}
+			if bindings.SessionID == "" {
+				return dagql.String(""), nil
+			}
+			return dagql.PerSessionInput.Resolver(ctx, args)
+		},
+	}).
+		NotReplayable("Prepared contextual defaults retain the original workspace authority").
+		Args(dagql.Arg("module").Internal(), dagql.Arg("workspace").Internal(), dagql.Arg("function").Internal(), dagql.Arg("bindings").Internal().Sensitive(), dagql.Arg("references").Internal().Sensitive())
+	field.Spec.TTL = core.MaxFunctionCacheTTLSeconds
+	dagql.Fields[*core.Query]{field}.Install(srv)
+	dagql.Fields[*core.Address]{dagql.NodeFunc("__deferredContainer", deferredDefaultContainer).WithInput(dagql.PerCallInput)}.Install(srv)
+}
+
+func preparedDefaultContainer(ctx context.Context, query *core.Query, args preparedDefaultContainerArgs) (*core.Container, error) {
+	srv, err := core.CurrentDagqlServer(ctx)
+	if err != nil {
+		return nil, err
+	}
+	mod, err := args.Module.Load(ctx, srv)
+	if err != nil {
+		return nil, err
+	}
+	ws, err := args.Workspace.Load(ctx, srv)
+	if err != nil {
+		return nil, err
+	}
+	plan := core.PreparedContainerDefault{Module: mod, Workspace: ws, Function: args.Function, Bindings: args.Bindings}
+	for _, id := range args.References {
+		raw, err := id.ID()
+		if err != nil {
+			return nil, err
+		}
+		ref, err := srv.Load(ctx, raw)
+		if err != nil {
+			return nil, err
+		}
+		plan.References = append(plan.References, ref)
+	}
+	return core.NewPreparedDefaultContainer(plan, query.Platform()), nil
+}
