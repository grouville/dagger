+func TestPreparedContainerRetainsReferencesWithoutEvaluation(t *testing.T) {
+	env := newPersistedFamiliesTestEnv(t, "prepared-persist")
+	ctx, cache, srv := env.open(t)
+	module := env.attach(t, ctx, cache, srv, "producer", &Module{NameField: "producer", OriginalName: "Producer", Deps: NewSchemaBuilder(nil, nil)}).(dagql.ObjectResult[*Module])
+	source := env.directory(t, ctx, cache, srv, "source", "source-snapshot")
+	ws := env.attach(t, ctx, cache, srv, "workspace", &Workspace{rootfs: source, Address: "file:///ws", Cwd: "/"}).(dagql.ObjectResult[*Workspace])
+	plan := PreparedContainerDefault{Module: module, Workspace: ws, Function: "missingSentinel", Bindings: JSON(`{"constructor":{"source":{"ref":0}},"function":{}}`), References: []dagql.AnyResult{source}}
+	ctr := NewPreparedDefaultContainer(plan, Platform{OS: "linux", Architecture: "amd64"})
+	require.False(t, ctr.CanUseFromContentDigest(), "unknown deferred state is not scratch")
+	attached := env.attach(t, ctx, cache, srv, "__preparedDefaultContainer", ctr)
+	lazy := ctr.Lazy.(*ContainerDeferredDefaultLazy)
+	require.NotNil(t, lazy.owner)
+	require.False(t, lazy.GroupConsumed(ContainerLazyGroupMetadata))
+	require.True(t, dagql.HasPendingLazyEvaluation(attached))
+	// The deliberately missing module function makes eager body evaluation fail;
+	// publishing/capturing/relocating an unused prepared value must not invoke it.
+	rec, err := cache.CapturePersistedRecord(ctx, attached)
+	require.NoError(t, err)
+	require.False(t, lazy.GroupConsumed(ContainerLazyGroupMetadata))
+	var payload persistedContainerPayload
+	require.NoError(t, json.Unmarshal(rec.Envelope.ObjectJSON, &payload))
+	require.False(t, payload.Metadata.Consumed)
+	moduleID := persistedRowID(t, cache, module)
+	sourceRow := persistedRowID(t, cache, source)
+	wsID := persistedRowID(t, cache, ws)
+	reloc := &relocationVisitor{mapping: map[uint64]uint64{rec.ResultID: rec.ResultID, moduleID: moduleID + 10000, sourceRow: sourceRow + 10000, wsID: wsID + 10000}}
+	moved, err := dagql.VisitEncodedReferences(rec, reloc.visit)
+	require.NoError(t, err)
+	var movedPayload persistedContainerPayload
+	require.NoError(t, json.Unmarshal(moved.Envelope.ObjectJSON, &movedPayload))
+	var recipe persistedContainerDefault
+	require.NoError(t, json.Unmarshal(movedPayload.LazyJSON, &recipe))
+	require.Equal(t, moduleID+10000, recipe.Module)
+	require.Equal(t, wsID+10000, recipe.Workspace)
+	require.Equal(t, []uint64{sourceRow + 10000}, recipe.References)
+	require.JSONEq(t, string(plan.Bindings), string(recipe.Bindings), "slot binding JSON contains no relocatable runtime handles")
+	expected := map[string]uint64{"objectJSON.lazyJSON.moduleResultID": moduleID, "objectJSON.lazyJSON.workspaceResultID": wsID, "objectJSON.lazyJSON.referenceResultIDs[0]": sourceRow}
+	for path, row := range reloc.childIDs() {
+		if strings.HasPrefix(path, "objectJSON.lazyJSON.") {
+			require.Equal(t, expected[path], row)
+			delete(expected, path)
+		}
+	}
+	require.Empty(t, expected)
+	ctx, cache, srv = env.restart(t, ctx, cache)
+	loaded, err := cache.LoadResultByResultID(ctx, env.session, srv, rec.ResultID)
+	require.NoError(t, err)
+	restored, ok := dagql.UnwrapAs[*Container](loaded)
+	require.True(t, ok)
+	restoredLazy, ok := restored.Lazy.(*ContainerDeferredDefaultLazy)
+	require.True(t, ok)
+	require.NotNil(t, restoredLazy.owner, "pending recipe must reconnect its published owner after cache restart")
+	require.False(t, restoredLazy.GroupConsumed(ContainerLazyGroupMetadata))
+	require.Len(t, restoredLazy.Plan.References, 1)
+	require.False(t, restored.CanUseFromContentDigest())
+}
