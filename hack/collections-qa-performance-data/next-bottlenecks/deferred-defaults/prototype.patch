+package core
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/dagger/dagger/dagql"
+	"github.com/dagger/dagger/engine"
+	telemetry "github.com/dagger/otel-go"
+	"go.opentelemetry.io/otel/attribute"
+)
+
+var errUnsealedPreparedFilesystemInput = errors.New("prepared filesystem input has no content identity")
+var errLivePreparedWorkspaceInput = errors.New("prepared function reads a live workspace")
+
+// PreparedContainerDefault freezes contextual argument objects before any module
+// constructor/body runs. References are separate graph edges, never path strings
+// or opaque engine IDs embedded in JSON. This prototype supports direct fields.
+type PreparedContainerDefault struct {
+	Module     dagql.ObjectResult[*Module]
+	Workspace  dagql.ObjectResult[*Workspace]
+	Function   string
+	Bindings   JSON
+	References []dagql.AnyResult
+}
+
+type frozenContainerArguments struct {
+	Constructor map[string]any `json:"constructor"`
+	Function    map[string]any `json:"function"`
+	CacheScope  []string       `json:"cacheScope,omitempty"`
+	SessionID   string         `json:"sessionID,omitempty"`
+}
+
+func PrepareContainerDefault(ctx context.Context, artifact *Artifact) (_ *PreparedContainerDefault, supported bool, rerr error) {
+	node := artifact.Node
+	if artifact.Workspace.Self() == nil {
+		return nil, false, nil
+	}
+	if node == nil || node.Parent == nil || node.CollectionDimension != nil || node.RootValue != nil {
+		return nil, false, nil
+	}
+	root := node.Parent
+	if root.RootValue != nil || root.Module.Self() == nil {
+		return nil, false, nil
+	}
+	if parent := root.Parent; parent != nil && (parent.Module.Self() != nil || parent.RootValue != nil || parent.Type.Self() != nil) {
+		return nil, false, nil
+	}
+	obj := root.ObjectType()
+	if obj == nil {
+		return nil, false, nil
+	}
+	function, ok := obj.FunctionByName(node.Name)
+	if !ok || function == nil || artifact.TypeName != "Container" {
+		return nil, false, nil
+	}
+	// TTL would require a bounded lifetime on the prepared shell itself. Keep
+	// that case eager until an expiry-preserving plan representation is tested.
+	if function.CacheTTLSeconds.Valid {
+		return nil, false, nil
+	}
+	ctx, span := Tracer(ctx).Start(ctx, "prepare configured Container default", telemetry.Internal())
+	defer func() {
+		span.SetAttributes(attribute.Bool("dagger.prepared_container.supported", supported))
+		telemetry.EndWithCause(span, &rerr)
+	}()
+	p := &PreparedContainerDefault{Module: root.Module, Workspace: artifact.Workspace, Function: node.Name}
+	var ctor *Function
+	if obj.Constructor.Valid {
+		ctor = obj.Constructor.Value.Self()
+		if ctor.CacheTTLSeconds.Valid {
+			return nil, false, nil
+		}
+	}
+	// Decide before resolving any defaults. Otherwise an unsupported later
+	// argument could cause an earlier Never-cache object default to execute once
+	// during preparation and again in the ordinary eager fallback.
+	for _, candidate := range []*Function{ctor, function} {
+		supported, err := p.canPrepareArguments(ctx, obj, candidate)
+		if err != nil {
+			return nil, true, err
+		}
+		if !supported {
+			return nil, false, nil
+		}
+	}
+	bindings := frozenContainerArguments{}
+	srv, err := dagqlServerForModule(ctx, p.Module)
+	if err != nil {
+		return nil, true, err
+	}
+	bindings.Constructor, err = p.freezeArguments(ctx, srv, obj, ctor, &bindings.CacheScope)
+	if err != nil {
+		if errors.Is(err, errUnsealedPreparedFilesystemInput) || errors.Is(err, errLivePreparedWorkspaceInput) {
+			return nil, false, nil
+		}
+		return nil, true, err
+	}
+	bindings.Function, err = p.freezeArguments(ctx, srv, obj, function, &bindings.CacheScope)
+	if err != nil {
+		if errors.Is(err, errUnsealedPreparedFilesystemInput) || errors.Is(err, errLivePreparedWorkspaceInput) {
+			return nil, false, nil
+		}
+		return nil, true, err
+	}
+	if !p.Workspace.Self().IsValueWorkspace() || len(bindings.CacheScope) > 0 {
+		md, err := engine.ClientMetadataFromContext(ctx)
+		if err != nil {
+			return nil, true, err
+		}
+		if md.SessionID == "" {
+			return nil, true, fmt.Errorf("prepared container requires a session scope")
+		}
+		bindings.SessionID = md.SessionID
+	}
+	raw, err := json.Marshal(bindings)
+	p.Bindings = JSON(raw)
+	return p, true, err
+}
+
+func (p *PreparedContainerDefault) canPrepareArguments(ctx context.Context, obj *ObjectTypeDef, metadata *Function) (bool, error) {
+	if metadata == nil {
+		return true, nil
+	}
+	// UserDefault only reads these metadata fields; it does not need runtime
+	// argument converters or a served schema.
+	fn := &ModuleFunction{mod: p.Module, objDef: obj, metadata: metadata}
+	for _, result := range metadata.Args {
+		arg := result.Self()
+		typ := arg.TypeDef.Self()
+		element := typ
+		for element.Kind == TypeDefKindList {
+			element = element.AsList.Value.Self().ElementTypeDef.Self()
+		}
+		if element.Kind != TypeDefKindObject && element.Kind != TypeDefKindInterface {
+			continue
+		}
+		_, configured, err := fn.UserDefault(ctx, arg.Name)
+		if err != nil {
+			return false, err
+		}
+		if configured || arg.IsWorkspace() || arg.DefaultValue != nil {
+			return false, nil
+		}
+		if arg.isContextual() {
+			if typ.Kind != TypeDefKindObject || typ.AsObject.Value.Self().Name != "Directory" || arg.DefaultPath == "" {
+				return false, nil
+			}
+		}
+	}
+	return true, nil
+}
+
+func (p *PreparedContainerDefault) freezeArguments(ctx context.Context, srv *dagql.Server, obj *ObjectTypeDef, metadata *Function, scope *[]string) (map[string]any, error) {
+	values := map[string]any{}
+	if metadata == nil {
+		return values, nil
+	}
+	fn, err := NewModFunction(ctx, p.Module, obj, metadata)
+	if err != nil {
+		return nil, err
+	}
+	inputArgs := map[string]dagql.Input{}
+	req := &dagql.CallRequest{ResultCall: &dagql.ResultCall{}}
+	initial, err := boundWorkspaceArgs(ctx, srv, metadata)
+	if err != nil {
+		return nil, err
+	}
+	for _, arg := range initial {
+		inputArgs[arg.Name] = arg.Value
+		if err := req.SetArgInput(ctx, arg.Name, arg.Value, false); err != nil {
+			return nil, err
+		}
+	}
+	if err := fn.DynamicInputsForCall(ctx, nil, inputArgs, srv.View, req); err != nil {
+		return nil, err
+	}
+	// Primitive workspace/.env overrides must be frozen too; module authored
+	// defaults remain in immutable function metadata and follow the normal SDK path.
+	for _, argRes := range metadata.Args {
+		arg := argRes.Self()
+		if _, set := inputArgs[arg.Name]; set {
+			continue
+		}
+		ud, exists, err := fn.UserDefault(ctx, arg.Name)
+		if err != nil {
+			return nil, err
+		}
+		if !exists && arg.isContextual() && arg.TypeDef.Self().Optional {
+			value, err := arg.TypeDef.Self().ToInput().Decoder().DecodeInput(nil)
+			if err != nil {
+				return nil, err
+			}
+			inputArgs[arg.Name] = value
+			continue
+		}
+		if exists {
+			if ud.IsObject() {
+				return nil, fmt.Errorf("unbound object default %q", arg.Name)
+			}
+			value, err := ud.UserDefaultPrimitive.DagqlInput()
+			if err != nil {
+				return nil, err
+			}
+			inputArgs[arg.Name] = value
+		}
+	}
+	names := make([]string, 0, len(inputArgs))
+	for name := range inputArgs {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		arg, ok := metadata.LookupArg(name)
+		if !ok {
+			return nil, fmt.Errorf("unknown prepared argument %q", name)
+		}
+		raw := inputArgs[name].ToLiteral().ToInput()
+		v, err := p.freezeValue(ctx, srv, arg.Self().TypeDef.Self(), raw)
+		if err != nil {
+			return nil, err
+		}
+		values[name] = v
+	}
+	for _, implicit := range fn.cacheImplicitInputs() {
+		v, err := implicit.Resolver(ctx, inputArgs)
+		if err != nil {
+			return nil, err
+		}
+		*scope = append(*scope, implicit.Name+":"+fmt.Sprint(v.ToLiteral().ToInput()))
+	}
+	return values, nil
+}
+
+func (p *PreparedContainerDefault) freezeValue(ctx context.Context, srv *dagql.Server, typ *TypeDef, raw any) (any, error) {
+	if raw == nil {
+		return nil, nil
+	}
+	if typ.Kind == TypeDefKindList {
+		items, ok := raw.([]any)
+		if !ok {
+			return nil, fmt.Errorf("prepared list is %T", raw)
+		}
+		out := make([]any, len(items))
+		for i, item := range items {
+			v, err := p.freezeValue(ctx, srv, typ.AsList.Value.Self().ElementTypeDef.Self(), item)
+			if err != nil {
+				return nil, err
+			}
+			out[i] = v
+		}
+		return out, nil
+	}
+	if typ.Kind != TypeDefKindObject && typ.Kind != TypeDefKindInterface {
+		return raw, nil
+	}
+	input, err := (dagql.AnyID{}).DecodeInput(raw)
+	if err != nil {
+		return nil, err
+	}
+	id, err := input.(dagql.IDType).ID()
+	if err != nil {
+		return nil, err
+	}
+	value, err := srv.Load(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	// Preserve ordinary laziness for filesystem recipes. A handle alone is
+	// insufficient to freeze a live source, while forcing arbitrary recipes here
+	// could run a container just to prepare an unused input. Narrow this prototype
+	// to filesystem values whose content identity was already resolved by the
+	// ordinary argument loader (notably Directory defaultPath).
+	switch object := value.(type) {
+	case dagql.ObjectResult[*Workspace]:
+		if !object.Self().IsValueWorkspace() {
+			return nil, errLivePreparedWorkspaceInput
+		}
+	case dagql.ObjectResult[*Directory], dagql.ObjectResult[*File]:
+		frame, err := value.ResultCall()
+		if err != nil {
+			return nil, err
+		}
+		if frame.ContentDigest() == "" {
+			return nil, errUnsealedPreparedFilesystemInput
+		}
+	}
+
+	index := len(p.References)
+	p.References = append(p.References, value)
+	return map[string]any{"ref": index}, nil
+}
+
+// ContainerDeferredDefaultLazy is an ordinary lazy Container. Its metadata
+// operation runs the frozen module path; each snapshot part delegates separately.
+// Merely passing its ID to an SDK does not execute either module function.
+type ContainerDeferredDefaultLazy struct {
+	LazyState
+	Plan     PreparedContainerDefault
+	parentMu sync.RWMutex
+	Parent   dagql.ObjectResult[*Container]
+	owner    dagql.AnyResult
+}
+
+func NewPreparedDefaultContainer(plan PreparedContainerDefault, platform Platform) *Container {
+	ctr := NewContainer(platform)
+	// A proxy may carry env, mounts and service bindings; it is never a scratch
+	// container whose state can be discarded when applying From.
+	ctr.fromContentDigestSafe = false
+	ctr.Lazy = &ContainerDeferredDefaultLazy{LazyState: NewLazyState(), Plan: plan}
+	return ctr
+}
+func (container *Container) InitializeResultReference(self dagql.AnyResult) {
+	operation := container.lazyOpForRouting()
+	if restore, ok := operation.(*ContainerRestoreLazy); ok {
+		operation = restore.recipe
+	}
+	if lazy, ok := operation.(*ContainerDeferredDefaultLazy); ok {
+		lazy.parentMu.Lock()
+		if lazy.owner == nil {
+			lazy.owner = self
+		}
+		lazy.parentMu.Unlock()
+	}
+}
+func (lazy *ContainerDeferredDefaultLazy) ContainerLazyParent() dagql.ObjectResult[*Container] {
+	lazy.parentMu.RLock()
+	defer lazy.parentMu.RUnlock()
+	return lazy.Parent
+}
+func (lazy *ContainerDeferredDefaultLazy) ContainerLazyGroups(_ context.Context, ctr *Container, parts []dagql.PartKey) ([]dagql.LazyGroupKey, error) {
+	return templateAContainerGroups(ctr, parts)
+}
+func (lazy *ContainerDeferredDefaultLazy) Evaluate(ctx context.Context, ctr *Container) error {
+	return ctr.evaluateAllLazyGroups(ctx, lazy)
+}
+func (lazy *ContainerDeferredDefaultLazy) EvaluateContainerGroup(ctx context.Context, ctr *Container, group dagql.LazyGroupKey) error {
+	return lazy.EvaluateGroup(ctx, "Container.deferredDefault", group, func(ctx context.Context) error {
+		if group != ContainerLazyGroupMetadata {
+			return delegateContainerPart(ctx, ctr, lazy.ContainerLazyParent(), dagql.PartKey(group))
+		}
+		parent, err := lazy.Plan.Evaluate(ctx)
+		if err != nil {
+			return err
+		}
+		cache, err := dagql.EngineCache(ctx)
+		if err != nil {
+			return err
+		}
+		lazy.parentMu.RLock()
+		owner := lazy.owner
+		lazy.parentMu.RUnlock()
+		if owner == nil {
+			return fmt.Errorf("deferred container has no published owner")
+		}
+		if err := cache.AddExplicitDependency(ctx, owner, parent, "deferred container target"); err != nil {
+			return err
+		}
+		if err := materializeContainerMetadataFromParent(ctx, ctr, parent); err != nil {
+			return err
+		}
+		lazy.parentMu.Lock()
+		lazy.Parent = parent
+		lazy.parentMu.Unlock()
+		return nil
+	})
+}
+
+func (p *PreparedContainerDefault) Evaluate(ctx context.Context) (dagql.ObjectResult[*Container], error) {
+	var result dagql.ObjectResult[*Container]
+	bindings, err := decodeFrozenContainerArguments(p.Bindings)
+	if err != nil {
+		return result, err
+	}
+	if err := bindings.checkSession(ctx); err != nil {
+		return result, err
+	}
+	if !p.Workspace.Self().IsValueWorkspace() && bindings.SessionID == "" {
+		return result, fmt.Errorf("live workspace prepared container is missing its session scope")
+	}
+	ctx, err = WorkspaceClientContext(ctx, p.Workspace.Self())
+	if err != nil {
+		return result, err
+	}
+	ctx = WorkspaceToContext(ctx, p.Workspace)
+	srv, err := dagqlServerForModule(ctx, p.Module)
+	if err != nil {
+		return result, err
+	}
+	objRes, ok := p.Module.Self().mainObjectTypeDefResult()
+	if !ok {
+		return result, fmt.Errorf("prepared module has no main object")
+	}
+	obj := objRes.Self().AsObject.Value.Self()
+	var ctor *Function
+	if obj.Constructor.Valid {
+		ctor = obj.Constructor.Value.Self()
+	}
+	constructorArgs, err := p.thawArguments(ctor, bindings.Constructor)
+	if err != nil {
+		return result, err
+	}
+	function, ok := obj.FunctionByName(p.Function)
+	if !ok {
+		return result, fmt.Errorf("prepared function %q is missing", p.Function)
+	}
+	functionArgs, err := p.thawArguments(function, bindings.Function)
+	if err != nil {
+		return result, err
+	}
+	err = srv.Select(ctx, srv.Root(), &result, dagql.Selector{Field: gqlFieldName(p.Module.Self().Name()), Args: constructorArgs}, dagql.Selector{Field: p.Function, Args: functionArgs})
+	return result, err
+}
+func (p *PreparedContainerDefault) thawArguments(fn *Function, values map[string]any) ([]dagql.NamedInput, error) {
+	names := make([]string, 0, len(values))
+	for name := range values {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var inputs []dagql.NamedInput
+	for _, name := range names {
+		arg, ok := fn.LookupArg(name)
+		if !ok {
+			return nil, fmt.Errorf("prepared argument %q is missing", name)
+		}
+		raw, err := p.thawValue(arg.Self().TypeDef.Self(), values[name])
+		if err != nil {
+			return nil, err
+		}
+		value, err := arg.Self().TypeDef.Self().ToInput().Decoder().DecodeInput(raw)
+		if err != nil {
+			return nil, err
+		}
+		inputs = append(inputs, dagql.NamedInput{Name: name, Value: value})
+	}
+	return inputs, nil
+}
+func (p *PreparedContainerDefault) thawValue(typ *TypeDef, raw any) (any, error) {
+	if raw == nil {
+		return nil, nil
+	}
+	if typ.Kind == TypeDefKindList {
+		items, ok := raw.([]any)
+		if !ok {
+			return nil, fmt.Errorf("prepared list is %T", raw)
+		}
+		for i, v := range items {
+			decoded, err := p.thawValue(typ.AsList.Value.Self().ElementTypeDef.Self(), v)
+			if err != nil {
+				return nil, err
+			}
+			items[i] = decoded
+		}
+		return items, nil
+	}
+	if typ.Kind != TypeDefKindObject && typ.Kind != TypeDefKindInterface {
+		return raw, nil
+	}
+	ref, ok := raw.(map[string]any)
+	if !ok {
+		return nil, fmt.Errorf("prepared object reference is %T", raw)
+	}
+	n, ok := ref["ref"].(json.Number)
+	if !ok {
+		return nil, fmt.Errorf("invalid prepared object reference")
+	}
+	index, err := n.Int64()
+	if err != nil || index < 0 || index >= int64(len(p.References)) {
+		return nil, fmt.Errorf("invalid prepared object reference")
+	}
+	id, err := p.References[index].ID()
+	if err != nil {
+		return nil, err
+	}
+	return id.Encode()
+}
+
+func (lazy *ContainerDeferredDefaultLazy) AttachDependencies(ctx context.Context, attach func(dagql.AnyResult) (dagql.AnyResult, error)) ([]dagql.AnyResult, error) {
+	var deps []dagql.AnyResult
+	mod, err := attach(lazy.Plan.Module)
+	if err != nil {
+		return nil, err
+	}
+	lazy.Plan.Module = mod.(dagql.ObjectResult[*Module])
+	deps = append(deps, mod)
+	ws, err := attach(lazy.Plan.Workspace)
+	if err != nil {
+		return nil, err
+	}
+	lazy.Plan.Workspace = ws.(dagql.ObjectResult[*Workspace])
+	deps = append(deps, ws)
+	for i, ref := range lazy.Plan.References {
+		attached, err := attach(ref)
+		if err != nil {
+			return nil, err
+		}
+		lazy.Plan.References[i] = attached
+		deps = append(deps, attached)
+	}
+	lazy.parentMu.Lock()
+	defer lazy.parentMu.Unlock()
+	if lazy.Parent.Self() != nil {
+		parent, err := attach(lazy.Parent)
+		if err != nil {
+			return nil, err
+		}
+		lazy.Parent = parent.(dagql.ObjectResult[*Container])
+		deps = append(deps, parent)
+	}
+	return deps, nil
+}
+
+type persistedContainerDefault struct {
+	Module     uint64   `json:"moduleResultID"`
+	Workspace  uint64   `json:"workspaceResultID"`
+	Parent     uint64   `json:"parentResultID,omitempty"`
+	Function   string   `json:"function"`
+	Bindings   JSON     `json:"bindings"`
+	References []uint64 `json:"referenceResultIDs,omitempty"`
+}
+
+func (lazy *ContainerDeferredDefaultLazy) EncodePersisted(ctx context.Context, enc *dagql.PersistEncodeContext) (json.RawMessage, error) {
+	p := persistedContainerDefault{Function: lazy.Plan.Function, Bindings: lazy.Plan.Bindings}
+	var err error
+	p.Module, err = encodePersistedObjectRef(enc, lazy.Plan.Module, "deferred module")
+	if err != nil {
+		return nil, err
+	}
+	p.Workspace, err = encodePersistedObjectRef(enc, lazy.Plan.Workspace, "deferred workspace")
+	if err != nil {
+		return nil, err
+	}
+	for _, r := range lazy.Plan.References {
+		id, err := encodePersistedObjectRef(enc, r, "deferred input")
+		if err != nil {
+			return nil, err
+		}
+		p.References = append(p.References, id)
+	}
+	parent := lazy.ContainerLazyParent()
+	if parent.Self() != nil {
+		p.Parent, err = encodePersistedObjectRef(enc, parent, "deferred target")
+		if err != nil {
+			return nil, err
+		}
+	}
+	return json.Marshal(p)
+}
+func decodeContainerDefault(ctx context.Context, dec *dagql.PersistDecodeContext, raw json.RawMessage) (Lazy[*Container], error) {
+	var p persistedContainerDefault
+	if err := json.Unmarshal(raw, &p); err != nil {
+		return nil, err
+	}
+	if p.Module == 0 || p.Workspace == 0 || p.Function == "" {
+		return nil, fmt.Errorf("incomplete prepared container recipe")
+	}
+	if _, err := decodeFrozenContainerArguments(p.Bindings); err != nil {
+		return nil, fmt.Errorf("decode prepared argument bindings: %w", err)
+	}
+	lazy := &ContainerDeferredDefaultLazy{LazyState: NewLazyState(), Plan: PreparedContainerDefault{Function: p.Function, Bindings: p.Bindings}}
+	var err error
+	lazy.Plan.Module, err = loadPersistedObjectResultByResultID[*Module](ctx, dec, p.Module, "deferred module")
+	if err != nil {
+		return nil, err
+	}
+	lazy.Plan.Workspace, err = loadPersistedObjectResultByResultID[*Workspace](ctx, dec, p.Workspace, "deferred workspace")
+	if err != nil {
+		return nil, err
+	}
+	lazy.Parent, err = loadPersistedObjectResultByResultID[*Container](ctx, dec, p.Parent, "deferred target")
+	if err != nil {
+		return nil, err
+	}
+	for _, id := range p.References {
+		r, err := loadPersistedResultByResultID(ctx, dec, id, "deferred input")
+		if err != nil {
+			return nil, err
+		}
+		lazy.Plan.References = append(lazy.Plan.References, r)
+	}
+	return lazy, nil
+}
+
+func decodeFrozenContainerArguments(raw JSON) (frozenContainerArguments, error) {
+	var value frozenContainerArguments
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	err := dec.Decode(&value)
+	return value, err
+}
+
+var _ LazyContainerParts = (*ContainerDeferredDefaultLazy)(nil)
+
+func (bindings frozenContainerArguments) checkSession(ctx context.Context) error {
+	if bindings.SessionID == "" {
+		return nil
+	}
+	md, err := engine.ClientMetadataFromContext(ctx)
+	if err != nil {
+		return err
+	}
+	if md.SessionID != bindings.SessionID {
+		return fmt.Errorf("prepared container belongs to a different session")
+	}
+	return nil
+}
