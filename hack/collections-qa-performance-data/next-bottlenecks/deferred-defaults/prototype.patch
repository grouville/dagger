+func TestPreparedContainerReferencesAndNumbers(t *testing.T) {
+	env := newPersistedFamiliesTestEnv(t, "prepared-inputs")
+	ctx, cache, srv := env.open(t)
+	source := env.directory(t, ctx, cache, srv, "input", "input-snapshot")
+	source, err := source.WithContentDigest(ctx, digest.FromString("frozen-input"))
+	require.NoError(t, err)
+	sourceID, err := source.ID()
+	require.NoError(t, err)
+	object := &TypeDef{Kind: TypeDefKindObject}
+	list := &TypeDef{Kind: TypeDefKindList, AsList: dagql.NonNull(defaultTestObject(t, &ListTypeDef{ElementTypeDef: defaultTestObject(t, object)}))}
+	p := &PreparedContainerDefault{}
+	frozen, err := p.freezeValue(ctx, srv, list, []any{dagql.NewID[*Directory](sourceID).ToLiteral().ToInput(), nil})
+	require.NoError(t, err)
+	raw, err := json.Marshal(frozenContainerArguments{Constructor: map[string]any{"sources": frozen, "count": json.Number("9007199254740993")}})
+	require.NoError(t, err)
+	encodedID, err := sourceID.Encode()
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), encodedID, "runtime handles must be explicit dependency edges, not hidden JSON")
+	require.Len(t, p.References, 1)
+	decoded, err := decodeFrozenContainerArguments(raw)
+	require.NoError(t, err)
+	require.Equal(t, json.Number("9007199254740993"), decoded.Constructor["count"], "JSON roundtrip must not round large integer arguments")
+	thawed, err := p.thawValue(list, decoded.Constructor["sources"])
+	require.NoError(t, err)
+	require.Equal(t, []any{encodedID, nil}, thawed)
+	for _, bad := range []string{`null`, `-1`, `1`, `0.5`, `"0"`, `9007199254740993`} {
+		t.Run(bad, func(t *testing.T) {
+			data, err := decodeFrozenContainerArguments(JSON(`{"constructor":{"x":{"ref":` + bad + `}}}`))
+			require.NoError(t, err)
+			_, err = p.thawValue(object, data.Constructor["x"])
+			require.ErrorContains(t, err, "invalid prepared object reference")
+		})
+	}
+}
