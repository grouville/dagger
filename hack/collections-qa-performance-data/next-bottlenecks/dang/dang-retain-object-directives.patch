+func TestDirectoryObjectDirectivesRetained(t *testing.T) {
+	for name, run := range map[string]func(context.Context, string, bool) (ValueScope, error){"declare": DeclareDir, "run": RunDir} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			require.NoError(t, os.WriteFile(filepath.Join(dir, "main.dang"), []byte(`
+directive @collection(key: String!) on OBJECT
+@collection(key: "name")
+type Inventory { value: String! = "one" }
+`), 0600))
+			first, err := run(t.Context(), dir, false)
+			require.NoError(t, err)
+			value, found := requireEvalGet(t, first, "Inventory")
+			require.True(t, found)
+			typ := value.(*ConstructorFunction).ObjectType
+			dirs := typ.GetDirectives("")
+			require.Len(t, dirs, 1)
+			require.Equal(t, "collection", dirs[0].Name)
+			require.Equal(t, "key", dirs[0].Args[0].Key)
+			second, err := run(t.Context(), dir, false)
+			require.NoError(t, err)
+			value2, found := requireEvalGet(t, second, "Inventory")
+			require.True(t, found)
+			typ2 := value2.(*ConstructorFunction).ObjectType
+			require.NotSame(t, typ, typ2)
+			require.NotSame(t, dirs[0], typ2.GetDirectives("")[0])
+			typ.SetDirectives("", nil)
+			require.Len(t, typ2.GetDirectives(""), 1)
+		})
+	}
+}
