+func TestObjectDirectivesDoNotMutatePrelude(t *testing.T) {
+	before := ErrorType.GetDirectives("")
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "main.dang"), []byte(`
+directive @marker on OBJECT
+@marker
+type Error { message: String! = "local" }
+`), 0600))
+	for _, run := range []func(context.Context, string, bool) (ValueScope, error){DeclareDir, RunDir} {
+		env, err := run(t.Context(), dir, false)
+		require.NoError(t, err)
+		value, found := requireEvalGet(t, env, "Error")
+		require.True(t, found)
+		typ := value.(*ConstructorFunction).ObjectType
+		require.NotSame(t, ErrorType, typ)
+		require.Len(t, typ.GetDirectives(""), 1)
+		require.Equal(t, before, ErrorType.GetDirectives(""))
+	}
+}
