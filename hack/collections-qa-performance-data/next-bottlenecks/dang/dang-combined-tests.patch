+func TestPopulateSchemaFunctionsPreservesAllEntryKinds(t *testing.T) {
+	stringRef := &introspection.TypeRef{Kind: introspection.TypeKindScalar, Name: "String"}
+	schema := &introspection.Schema{Types: introspection.Types{
+		&introspection.Type{Name: "String", Kind: introspection.TypeKindScalar},
+		&introspection.Type{Name: "Query", Kind: introspection.TypeKindObject, Fields: []*introspection.Field{{Name: "thing", TypeRef: &introspection.TypeRef{Kind: introspection.TypeKindObject, Name: "Thing"}}}},
+		&introspection.Type{Name: "Thing", Kind: introspection.TypeKindObject, Fields: []*introspection.Field{{Name: "label", TypeRef: stringRef, Args: introspection.InputValues{{Name: "format", TypeRef: stringRef}}}}},
+		&introspection.Type{Name: "Mutation", Kind: introspection.TypeKindObject, Fields: []*introspection.Field{{Name: "rename", TypeRef: stringRef}}},
+		&introspection.Type{Name: "Choice", Kind: introspection.TypeKindEnum, EnumValues: []introspection.EnumValue{{Name: "ONE"}}},
+	}}
+	schema.QueryType.Name = "Query"
+	schema.MutationType = &struct {
+		Name string `json:"name,omitempty"`
+	}{Name: "Mutation"}
+	typ := TypeScopeFromSchema("Dagger", schema)
+	env := ValueScopeFromSchema(typ, nil, schema)
+	value, found := requireEvalGet(t, env, "thing")
+	require.True(t, found)
+	require.Equal(t, "Query", value.(GraphQLFunction).TypeName)
+	_, found = requireEvalGet(t, env, "label")
+	require.False(t, found, "object fields must never become top-level functions")
+	object := GraphQLValue{TypeName: "Thing", Schema: schema, TypeScope: typ}
+	method, err := object.SelectField(t.Context(), "label")
+	require.NoError(t, err)
+	require.Equal(t, []string{"format"}, method.(GraphQLFunction).ParameterNames())
+	mutation, found := requireEvalGet(t, env, "Mutation")
+	require.True(t, found)
+	rename, found := requireEvalGet(t, mutation.(*Object), "rename")
+	require.True(t, found)
+	require.True(t, rename.(GraphQLFunction).IsMutation)
+	choice, found := requireEvalGet(t, env, "Choice")
+	require.True(t, found)
+	_, found = requireEvalGet(t, choice.(*Object), "ONE")
+	require.True(t, found)
+}
