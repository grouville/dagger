+package core
+
+import (
+	"fmt"
+	"math/rand"
+	"testing"
+
+	"github.com/dagger/dagger/dagql"
+)
+
+func bulkTestFunction(t testing.TB, name, original string) dagql.ObjectResult[*Function] {
+	t.Helper()
+	fn := &Function{Name: name, OriginalName: original, Description: "preserved metadata"}
+	r, err := dagql.NewResultForCall(fn, &dagql.ResultCall{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return dagql.ObjectResult[*Function]{Result: r}
+}
+func sameBulkFunctions(t testing.TB, a, b dagql.ObjectResultArray[*Function]) {
+	t.Helper()
+	if len(a) != len(b) {
+		t.Fatalf("different lengths %d/%d", len(a), len(b))
+	}
+	for i := range a {
+		if a[i].Self() != b[i].Self() {
+			t.Fatalf("different member at %d: %v/%v", i, a[i].Self(), b[i].Self())
+		}
+	}
+}
+func TestBulkTypeDefFunctionsReplacementAndOwnership(t *testing.T) {
+	original := &ObjectTypeDef{Functions: dagql.ObjectResultArray[*Function]{bulkTestFunction(t, "alpha", "A"), bulkTestFunction(t, "beta", "B")}}
+	saved := append(dagql.ObjectResultArray[*Function](nil), original.Functions...)
+	// First replacement creates a duplicate normalized name at an earlier slot.
+	// The next must choose that earlier slot even when OriginalName matches later.
+	additions := dagql.ObjectResultArray[*Function]{bulkTestFunction(t, "beta", "A"), bulkTestFunction(t, "beta", "B"), {}, bulkTestFunction(t, "alpha", "B"), bulkTestFunction(t, "beta", "A")}
+	expected := original
+	for _, fn := range additions {
+		expected = expected.WithFunction(fn)
+	}
+	got := original.WithFunctions(additions)
+	sameBulkFunctions(t, expected.Functions, got.Functions)
+	sameBulkFunctions(t, saved, original.Functions)
+	if got == original {
+		t.Fatal("mutated original object")
+	}
+	ifc := &InterfaceTypeDef{Functions: saved}
+	wantIface := ifc
+	for _, fn := range additions {
+		wantIface = wantIface.WithFunction(fn)
+	}
+	sameBulkFunctions(t, wantIface.Functions, ifc.WithFunctions(additions).Functions)
+	sameBulkFunctions(t, saved, ifc.Functions)
+}
+func TestBulkTypeDefFunctionsRandomizedSequentialEquivalence(t *testing.T) {
+	rng := rand.New(rand.NewSource(741))
+	for trial := 0; trial < 250; trial++ {
+		base := &ObjectTypeDef{}
+		// Existing duplicated slots are legal input and deliberately exercised.
+		for i := 0; i < 10; i++ {
+			base.Functions = append(base.Functions, bulkTestFunction(t, fmt.Sprint(rng.Intn(8)), fmt.Sprint(rng.Intn(8))))
+		}
+		additions := make(dagql.ObjectResultArray[*Function], 100)
+		for i := range additions {
+			if rng.Intn(12) != 0 {
+				original := fmt.Sprint(rng.Intn(12))
+				if rng.Intn(7) == 0 {
+					original = ""
+				}
+				additions[i] = bulkTestFunction(t, fmt.Sprint(rng.Intn(12)), original)
+			}
+		}
+		want := base
+		for _, fn := range additions {
+			want = want.WithFunction(fn)
+		}
+		sameBulkFunctions(t, want.Functions, base.WithFunctions(additions).Functions)
+	}
+}
+
+var bulkTypeDefSink *ObjectTypeDef
+
+func BenchmarkBulkTypeDefFunctions(b *testing.B) {
+	for _, n := range []int{1, 10, 100, 1000} {
+		inputs := make(dagql.ObjectResultArray[*Function], n)
+		for i := range inputs {
+			inputs[i] = bulkTestFunction(b, fmt.Sprintf("f%d", i), fmt.Sprintf("Original%d", i))
+		}
+		b.Run(fmt.Sprintf("sequential/%d", n), func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				obj := &ObjectTypeDef{}
+				for _, fn := range inputs {
+					obj = obj.WithFunction(fn)
+				}
+				bulkTypeDefSink = obj
+			}
+		})
+		b.Run(fmt.Sprintf("bulk/%d", n), func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				bulkTypeDefSink = (&ObjectTypeDef{}).WithFunctions(inputs)
+			}
+		})
+	}
+}
