diff --git a/engine/client/drivers/container_state_test.go b/engine/client/drivers/container_state_test.go
new file mode 100644
index 000000000..3662dec75
--- /dev/null
+++ b/engine/client/drivers/container_state_test.go
@@ -0,0 +1,200 @@
+package drivers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type stateContainerBackend struct {
+	captureContainerBackend
+	listed   []listedContainer
+	starts   []string
+	removed  []string
+	startErr error
+}
+
+// stoppedDuringListBackend models a stop after the daemon took its list
+// snapshot but before the response reaches the caller. No timing sleeps or
+// real runtime resources are needed to reproduce that ordering.
+type stoppedDuringListBackend struct {
+	stateContainerBackend
+	running bool
+}
+
+func (b *stoppedDuringListBackend) ContainerLs(context.Context) ([]listedContainer, error) {
+	snapshot := []listedContainer{{name: "engine", running: b.running}}
+	b.running = false
+	return snapshot, nil
+}
+
+func (b *stoppedDuringListBackend) ContainerStart(ctx context.Context, name string) error {
+	if err := b.stateContainerBackend.ContainerStart(ctx, name); err != nil {
+		return err
+	}
+	b.running = true
+	return nil
+}
+
+func TestImageDriverCreateRecoversStopDuringListing(t *testing.T) {
+	t.Parallel()
+	backend := &stoppedDuringListBackend{running: true}
+	driver := &imageDriver{backend: backend}
+	_, err := driver.create(t.Context(), containerCreateOpts{containerName: "engine"}, &DriverOpts{})
+	require.NoError(t, err)
+	require.True(t, backend.running, "the existing unconditional start recovers this stop-before-start ordering")
+}
+
+func (b *stateContainerBackend) ContainerLs(context.Context) ([]listedContainer, error) {
+	return b.listed, nil
+}
+
+func (b *stateContainerBackend) ContainerStart(_ context.Context, name string) error {
+	b.starts = append(b.starts, name)
+	return b.startErr
+}
+
+func (b *stateContainerBackend) ContainerRemove(_ context.Context, name string) error {
+	b.removed = append(b.removed, name)
+	return nil
+}
+
+func TestImageDriverCreateUsesListedRunningState(t *testing.T) {
+	t.Parallel()
+	for _, custom := range []bool{false, true} {
+		for _, cleanup := range []bool{false, true} {
+			for _, running := range []bool{false, true} {
+				t.Run(fmt.Sprintf("custom=%v/cleanup=%v/running=%v", custom, cleanup, running), func(t *testing.T) {
+					t.Parallel()
+					targetName := "dagger-engine-v1.0.0"
+					opts := containerCreateOpts{imageRef: "registry.example.com/engine:v1.0.0", cleanup: cleanup}
+					if custom {
+						targetName = "explicit-engine"
+						opts.containerName = targetName
+					}
+					backend := &stateContainerBackend{listed: []listedContainer{
+						{name: targetName, running: running},
+						{name: "unrelated-container", running: true},
+						{name: "dagger-engine-old-running", running: true},
+						{name: "dagger-engine-old-stopped"},
+					}}
+					driver := &imageDriver{backend: backend}
+					target, err := driver.create(t.Context(), opts, &DriverOpts{})
+					require.NoError(t, err)
+					require.Equal(t, targetName, target.Host)
+					require.Empty(t, backend.runName, "must not recreate an existing container")
+					if running {
+						require.Empty(t, backend.starts)
+					} else {
+						require.Equal(t, []string{targetName}, backend.starts)
+					}
+					if cleanup {
+						require.Equal(t, []string{"dagger-engine-old-running", "dagger-engine-old-stopped"}, backend.removed)
+					} else {
+						require.Empty(t, backend.removed)
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestImageDriverCreateKeepsStartErrors(t *testing.T) {
+	t.Parallel()
+	wantErr := errors.New("start failed")
+	backend := &stateContainerBackend{
+		listed:   []listedContainer{{name: "engine"}, {name: "dagger-engine-old"}},
+		startErr: wantErr,
+	}
+	driver := &imageDriver{backend: backend}
+	target, err := driver.create(t.Context(), containerCreateOpts{containerName: "engine", cleanup: true}, &DriverOpts{})
+	require.Nil(t, target)
+	require.ErrorIs(t, err, wantErr)
+	require.Equal(t, []string{"engine"}, backend.starts)
+	require.Empty(t, backend.removed, "failed start must not reach cleanup")
+}
+
+func TestImageDriverCreateRunningStillHonorsCancellation(t *testing.T) {
+	t.Parallel()
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	backend := &stateContainerBackend{listed: []listedContainer{{name: "engine", running: true}}}
+	driver := &imageDriver{backend: backend}
+	target, err := driver.create(ctx, containerCreateOpts{containerName: "engine"}, &DriverOpts{})
+	require.Nil(t, target)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Empty(t, backend.starts)
+	require.Empty(t, backend.runName)
+}
+
+func TestImageDriverCreateDoesNotRetainState(t *testing.T) {
+	t.Parallel()
+	backend := &stateContainerBackend{listed: []listedContainer{{name: "engine", running: true}}}
+	driver := &imageDriver{backend: backend}
+	opts := containerCreateOpts{containerName: "engine"}
+	_, err := driver.create(t.Context(), opts, &DriverOpts{})
+	require.NoError(t, err)
+	require.Empty(t, backend.starts)
+	backend.listed[0].running = false
+	_, err = driver.create(t.Context(), opts, &DriverOpts{})
+	require.NoError(t, err)
+	require.Equal(t, []string{"engine"}, backend.starts)
+}
+
+func TestGarbageCollectEnginesKeepsPreservedNames(t *testing.T) {
+	t.Parallel()
+	backend := &stateContainerBackend{}
+	driver := &imageDriver{backend: backend}
+	driver.garbageCollectEngines(t.Context(), true, []string{"keep"}, []listedContainer{
+		{name: ""}, {name: "keep", running: true}, {name: "remove", running: true},
+	})
+	require.Equal(t, []string{"remove"}, backend.removed)
+}
+
+func TestDockerListIncludesRunningState(t *testing.T) {
+	dir := runtimeTestPath(t)
+	writeRuntimeCommand(t, dir, "docker", `
+test "$#" = 4 || exit 2
+test "$1" = ps && test "$2" = -a && test "$3" = --format || exit 3
+test "$4" = '{{.Names}}	{{.State}}' || exit 4
+printf 'running-engine\trunning\nexited-engine\texited\npaused-engine\tpaused\nrestarting-engine\trestarting\nunknown-engine\tfuture-state\nmissing-state\n'
+`)
+	got, err := (docker{cmd: "docker"}).ContainerLs(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, []listedContainer{
+		{name: "running-engine", running: true}, {name: "exited-engine"},
+		{name: "paused-engine"}, {name: "restarting-engine"},
+		{name: "unknown-engine"}, {name: "missing-state"},
+	}, got)
+}
+
+func TestDockerCompatibleListsKeepUnknownState(t *testing.T) {
+	for _, command := range []string{"podman", "nerdctl", "finch"} {
+		t.Run(command, func(t *testing.T) {
+			dir := runtimeTestPath(t)
+			writeRuntimeCommand(t, dir, command, `
+test "$#" = 4 || exit 2
+test "$1" = ps && test "$2" = -a && test "$3" = --format || exit 3
+test "$4" = '{{.Names}}' || exit 4
+printf 'one\ntwo\n'
+`)
+			got, err := (docker{cmd: command}).ContainerLs(t.Context())
+			require.NoError(t, err)
+			require.Equal(t, []listedContainer{{name: "one"}, {name: "two"}}, got)
+		})
+	}
+}
+
+func TestAppleListPreservesPreStartSafeguard(t *testing.T) {
+	dir := runtimeTestPath(t)
+	writeRuntimeCommand(t, dir, "container", `
+test "$*" = 'ls -a --format json' || exit 2
+printf '[{"status":"running","configuration":{"id":"one"}}]\n'
+`)
+	got, err := (apple{}).ContainerLs(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, []listedContainer{{name: "one"}}, got, "Apple still uses its separate pre-start check")
+}
