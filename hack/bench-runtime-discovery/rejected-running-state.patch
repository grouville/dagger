diff --git a/engine/client/drivers/docker.go b/engine/client/drivers/docker.go
index 6e2b2eec3..711de722e 100644
--- a/engine/client/drivers/docker.go
+++ b/engine/client/drivers/docker.go
@@ -135,8 +135,14 @@ func (d docker) ContainerExists(ctx context.Context, name string) (bool, error)
 	return false, err
 }
 
-func (d docker) ContainerLs(ctx context.Context) ([]string, error) {
-	cmd := exec.CommandContext(ctx, d.cmd, "ps", "-a", "--format", "{{.Names}}")
+func (d docker) ContainerLs(ctx context.Context) ([]listedContainer, error) {
+	format := "{{.Names}}"
+	// Docker exposes its current state in the same list response. Preserve
+	// other compatible CLIs' format and start behavior until verified there.
+	if d.cmd == "docker" {
+		format += "\t{{.State}}"
+	}
+	cmd := exec.CommandContext(ctx, d.cmd, "ps", "-a", "--format", format)
 	stdout, _, err := traceexec.ExecOutput(ctx, cmd)
 	if err != nil {
 		return nil, err
@@ -144,7 +150,16 @@ func (d docker) ContainerLs(ctx context.Context) ([]string, error) {
 	if stdout == "" {
 		return nil, err
 	}
-	return strings.Split(stdout, "\n"), nil
+	var containers []listedContainer
+	for _, line := range strings.Split(stdout, "\n") {
+		listed := listedContainer{name: line}
+		if d.cmd == "docker" {
+			name, state, _ := strings.Cut(line, "\t")
+			listed = listedContainer{name: name, running: state == "running"}
+		}
+		containers = append(containers, listed)
+	}
+	return containers, nil
 }
 
 func isContainerAlreadyInUseOutput(output string) bool {
