@@ -0,0 +1,105 @@
+package dangv2
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/dagger/dagger/core"
+	"github.com/stretchr/testify/require"
+	"github.com/vito/dang/v2/pkg/dang"
+	"github.com/vito/dang/v2/pkg/introspection"
+)
+
+func parsedSelfTypeFixture(t *testing.T, source string) *dang.FileBlock {
+	t.Helper()
+	root, err := dang.Parse("fixture.dang", []byte(source))
+	require.NoError(t, err)
+	return root.(*dang.FileBlock)
+}
+
+func TestModuleDeclaredTypeNamesFromParsedFiles(t *testing.T) {
+	first := parsedSelfTypeFixture(t, `type Original {
+  pub text: String! { "type NotADeclaration {}" }
+  pub nested: String! { type Nested {}; "ok" }
+}
+type Widget {}
+`)
+	second := parsedSelfTypeFixture(t, `interface UnusedInterface { pub value: String! }
+enum UnusedEnum { ONE TWO }
+scalar UnusedScalar
+type Widget {}
+`)
+	second.Forms = append(second.Forms, &dang.ObjectDecl{
+		Name: &dang.Symbol{Name: "Private"}, Visibility: dang.PrivateVisibility,
+	})
+	require.Equal(t, []string{"Renamed", "Original", "Widget", "UnusedInterface", "UnusedEnum", "UnusedScalar"},
+		moduleDeclaredTypeNames([]*dang.FileBlock{first, second}, "renamed"))
+	require.Equal(t, []string{"Renamed"}, moduleDeclaredTypeNames(nil, "renamed"))
+}
+
+func TestPreparedSelfTypesPreserveExistingAndRenamedTypes(t *testing.T) {
+	files := []*dang.FileBlock{parsedSelfTypeFixture(t, "type Original {}\ntype Widget {}\nscalar UnusedScalar\n")}
+	existing := &introspection.Type{Kind: introspection.TypeKindScalar, Name: "RenamedWidget"}
+	schema := &introspection.Schema{Types: introspection.Types{existing}}
+	src := &core.ModuleSource{ModuleName: "renamed", ModuleOriginalName: "original"}
+	ensureModuleSelfTypes(schema, src, files)
+	require.Same(t, existing, schema.Types.Get("RenamedWidget"))
+	require.NotNil(t, schema.Types.Get("Renamed"))
+	// Preserve the existing seed behavior for installed/renamed modules: the
+	// final-name seed is namespaced independently of the original declaration.
+	require.NotNil(t, schema.Types.Get("RenamedRenamed"))
+	require.NotNil(t, schema.Types.Get("RenamedUnusedScalar"))
+	require.Nil(t, schema.Types.Get("Original"))
+	require.Len(t, schema.Types, 4)
+	ensureModuleSelfTypes(schema, src, files)
+	require.Len(t, schema.Types, 4, "existing types are not appended twice")
+
+	// Uninstalled source names retain the original-name fallback.
+	fallback := &introspection.Schema{}
+	ensureModuleSelfTypes(fallback, &core.ModuleSource{ModuleOriginalName: "original"}, files)
+	require.NotNil(t, fallback.Types.Get("Original"))
+	require.NotNil(t, fallback.Types.Get("OriginalWidget"))
+	ensureModuleSelfTypes(nil, src, files)
+	ensureModuleSelfTypes(fallback, nil, files)
+}
+
+func TestPreparedSelfTypesBeforeDeclarationAndRuntime(t *testing.T) {
+	for _, mode := range []string{"declare", "run"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			require.NoError(t, os.WriteFile(filepath.Join(dir, "main.dang"), []byte(`type Original {
+  pub identity(value: Dagger.Renamed!): Dagger.Renamed! { value }
+  pub sibling(value: Dagger.RenamedUnused!): Dagger.RenamedUnused! { value }
+}
+`), 0600))
+			require.NoError(t, os.WriteFile(filepath.Join(dir, "sibling.dang"), []byte("type Unused {}\nscalar Extra\n"), 0600))
+			schema, err := dang.SchemaFromSDL("type Query { ping: String! }", "dagger.graphql")
+			require.NoError(t, err)
+			baseContext := dang.ContextWithProjectConfig(context.Background(), filepath.Join(dir, "dang.toml"), &dang.ProjectConfig{})
+			ctx := dang.ContextWithImportConfigs(baseContext, dang.ImportConfig{
+				Name: "Dagger", Schema: schema, AutoImport: true,
+			})
+			calls := 0
+			prepare := func(_ context.Context, files []*dang.FileBlock) error {
+				calls++
+				ensureModuleSelfTypes(schema, &core.ModuleSource{ModuleName: "renamed", ModuleOriginalName: "original"}, files)
+				return nil
+			}
+			var env dang.ValueScope
+			if mode == "declare" {
+				env, err = runDangDirForModuleTypes(ctx, dir, prepare)
+			} else {
+				env, err = dang.RunDirWithPreparation(ctx, dir, false, prepare)
+			}
+			require.NoError(t, err)
+			require.Equal(t, 1, calls)
+			_, found, err := env.Lookup(ctx, "Original")
+			require.NoError(t, err)
+			require.True(t, found)
+			require.NotNil(t, schema.Types.Get("RenamedUnused"))
+			require.NotNil(t, schema.Types.Get("RenamedExtra"), "unused public scalar is not omitted")
+		})
+	}
+}
