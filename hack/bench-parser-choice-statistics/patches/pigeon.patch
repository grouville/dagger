+package json
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestChoiceStatisticsDefault(t *testing.T) {
+	p := newParser("default", []byte(`{"value": [1, true, null]}`))
+	if p.Stats == nil || p.ChoiceAltCnt != nil {
+		t.Fatal("default statistics must retain expression counting without choice counters")
+	}
+	if _, err := p.parse(g); err != nil {
+		t.Fatal(err)
+	}
+	if p.ExprCnt == 0 || p.ChoiceAltCnt != nil {
+		t.Fatal("parsing must count expressions without implicitly enabling choice statistics")
+	}
+}
+
+func TestChoiceStatisticsRestore(t *testing.T) {
+	p := newParser("restore", []byte(`{"value": 12}`))
+	initial := p.Stats
+	var first, second Stats
+	undo := Statistics(&first, "first-no-match")(p)
+	if p.Stats != &first || p.ChoiceAltCnt == nil || p.choiceNoMatch != "first-no-match" {
+		t.Fatal("explicit statistics not enabled")
+	}
+	redo := undo(p)
+	if p.Stats != initial || p.ChoiceAltCnt != nil || p.choiceNoMatch != "" {
+		t.Fatal("undo must restore the exact disabled state, without initializing its map")
+	}
+	undoAgain := redo(p)
+	if p.Stats != &first || p.choiceNoMatch != "first-no-match" {
+		t.Fatal("redo did not restore caller-owned statistics")
+	}
+	restoreFirst := Statistics(&second, "second-no-match")(p)
+	if p.Stats != &second || p.choiceNoMatch != "second-no-match" {
+		t.Fatal("switch to second statistics failed")
+	}
+	restoreFirst(p)
+	if p.Stats != &first || p.choiceNoMatch != "first-no-match" {
+		t.Fatal("switch undo did not preserve statistics identity and label")
+	}
+	undoAgain(p)
+	if p.Stats != initial || p.ChoiceAltCnt != nil || p.choiceNoMatch != "" {
+		t.Fatal("redo's undo did not restore the original disabled state")
+	}
+}
+
+func TestChoiceStatisticsAccumulate(t *testing.T) {
+	input := []byte(`{"string": "string", "number": 123}`)
+	stats := Stats{ChoiceAltCnt: map[string]map[string]int{"sentinel": {"kept": 17}}}
+	if _, err := Parse("accumulate", input, Statistics(&stats, "custom-no-match")); err != nil {
+		t.Fatal(err)
+	}
+	firstExpressions := stats.ExprCnt
+	first := make(map[string]map[string]int)
+	foundCustom := false
+	for rule, counts := range stats.ChoiceAltCnt {
+		first[rule] = make(map[string]int)
+		for alternative, count := range counts {
+			first[rule][alternative] = count
+			foundCustom = foundCustom || alternative == "custom-no-match"
+		}
+	}
+	if firstExpressions == 0 || !foundCustom {
+		t.Fatal("missing expression count or custom no-match label")
+	}
+	if _, err := Parse("accumulate", input, Statistics(&stats, "custom-no-match")); err != nil {
+		t.Fatal(err)
+	}
+	if stats.ExprCnt != 2*firstExpressions || len(stats.ChoiceAltCnt) != len(first) {
+		t.Fatal("statistics did not accumulate in the existing map")
+	}
+	for rule, counts := range first {
+		for alternative, count := range counts {
+			want := count * 2
+			if rule == "sentinel" {
+				want = count
+			}
+			if got := stats.ChoiceAltCnt[rule][alternative]; got != want {
+				t.Fatalf("%s/%s: got %d, want %d", rule, alternative, got, want)
+			}
+		}
+	}
+}
+
+func TestChoiceStatisticsParseParity(t *testing.T) {
+	for _, memoize := range []bool{false, true} {
+		for _, input := range []string{`{"value": [1, true, null]}`, `{"broken": [}`, "\"\xff\""} {
+			for _, maxExpr := range []uint64{0, 1, 30} {
+				var stats Stats
+				plain, plainErr := Parse("parity", []byte(input), Memoize(memoize), MaxExpressions(maxExpr))
+				counted, countedErr := Parse("parity", []byte(input), Memoize(memoize), MaxExpressions(maxExpr), Statistics(&stats, "no match"))
+				if !reflect.DeepEqual(plain, counted) || fmt.Sprint(plainErr) != fmt.Sprint(countedErr) {
+					t.Fatalf("memo=%t max=%d input=%q: output or error changed: %v != %v", memoize, maxExpr, input, plainErr, countedErr)
+				}
+				if maxExpr == 1 && (plainErr == nil || !strings.Contains(plainErr.Error(), "max number of expressions")) {
+					t.Fatal("expression limit no longer enforced without choice statistics")
+				}
+			}
+		}
+	}
+}
