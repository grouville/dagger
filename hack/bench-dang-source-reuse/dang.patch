+package dang
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/vito/dang/v2/pkg/introspection"
+)
+
+var directoryPreparationRunners = map[string]func(context.Context, string, bool, DirectoryOptions) (ValueScope, error){
+	"declare": DeclareDirWithOptions,
+	"run":     RunDirWithOptions,
+}
+
+func TestDirectoryPreparationUsesParsedSource(t *testing.T) {
+	for name, run := range directoryPreparationRunners {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			a := filepath.Join(dir, "a.dang")
+			z := filepath.Join(dir, "z.dang")
+			require.NoError(t, os.WriteFile(z, []byte("type Z {}"), 0o600))
+			require.NoError(t, os.WriteFile(a, []byte("type A {}"), 0o600))
+			calls := 0
+			env, err := run(context.Background(), dir, false, DirectoryOptions{
+				BeforeInference: func(ctx context.Context, files []*FileBlock) error {
+					calls++
+					require.NotNil(t, servicesFromContext(ctx))
+					require.Len(t, files, 2)
+					require.Equal(t, "A", files[0].Forms[0].(*ObjectDecl).Name.Name)
+					require.Equal(t, "Z", files[1].Forms[0].(*ObjectDecl).Name.Name)
+					require.Nil(t, files[0].Forms[0].GetInferredType())
+					// Test-only mutation of files, not ASTs: successful execution
+					// must use the parsed forms, not read/parse the directory again.
+					require.NoError(t, os.WriteFile(a, []byte("type BROKEN {"), 0o600))
+					return nil
+				},
+			})
+			require.NoError(t, err)
+			require.Equal(t, 1, calls)
+			_, found := requireEvalGet(t, env, "A")
+			require.True(t, found)
+		})
+	}
+}
+
+func TestDirectoryPreparationBeforeInference(t *testing.T) {
+	for name, run := range directoryPreparationRunners {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			require.NoError(t, os.WriteFile(filepath.Join(dir, "main.dang"), []byte(`
+type Test {
+  pub echo(value: Dagger.Prepared!): Dagger.Prepared! { value }
+}
+`), 0o600))
+			schema := schemaWithCoreShadowTypes()
+			ctx := ContextWithImportConfigs(context.Background(), ImportConfig{Name: "Dagger", Schema: schema, AutoImport: true})
+			_, err := run(ctx, dir, false, DirectoryOptions{})
+			require.Error(t, err, "signature must require the prepared schema type")
+			// ContextWithImportConfigs owns a name-keyed schema-module cache.
+			// A fresh invocation must not reuse the baseline's initialized
+			// type scope when preparing a different schema.
+			schema = schemaWithCoreShadowTypes()
+			ctx = ContextWithImportConfigs(context.Background(), ImportConfig{Name: "Dagger", Schema: schema, AutoImport: true})
+			calls := 0
+			_, err = run(ctx, dir, false, DirectoryOptions{BeforeInference: func(_ context.Context, _ []*FileBlock) error {
+				calls++
+				schema.Types = append(schema.Types, &introspection.Type{Kind: introspection.TypeKindScalar, Name: "Prepared"})
+				return nil
+			}})
+			require.NoError(t, err)
+			require.Equal(t, 1, calls)
+		})
+	}
+}
+
+func TestDirectoryPreparationErrorAndServiceOwnership(t *testing.T) {
+	for name, run := range directoryPreparationRunners {
+		for _, inherited := range []bool{false, true} {
+			t.Run(name+map[bool]string{true: "/inherited", false: "/owned"}[inherited], func(t *testing.T) {
+				dir := t.TempDir()
+				require.NoError(t, os.WriteFile(filepath.Join(dir, "main.dang"), []byte("type Test {}"), 0o600))
+				ctx := context.Background()
+				var registry *ServiceRegistry
+				if inherited {
+					registry = &ServiceRegistry{}
+					ctx = ContextWithServices(ctx, registry)
+				}
+				_, err := run(ctx, dir, false, DirectoryOptions{BeforeInference: func(ctx context.Context, _ []*FileBlock) error {
+					actual := servicesFromContext(ctx)
+					require.NotNil(t, actual)
+					if inherited {
+						require.Same(t, registry, actual)
+					}
+					registry = actual
+					// No real process is needed to check which invocation owns
+					// cleanup of the registry. StopAll must clear owned entries.
+					registry.register(&exec.Cmd{})
+					return context.Canceled
+				}})
+				require.ErrorIs(t, err, context.Canceled)
+				if inherited {
+					require.Len(t, registry.procs, 1)
+					registry.StopAll()
+				} else {
+					require.Empty(t, registry.procs)
+				}
+			})
+		}
+	}
+}
+
+func TestDirectoryPreparationParseErrorAndEmpty(t *testing.T) {
+	for name, run := range directoryPreparationRunners {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			calls := 0
+			options := DirectoryOptions{BeforeInference: func(_ context.Context, files []*FileBlock) error {
+				calls++
+				require.Empty(t, files)
+				return nil
+			}}
+			_, err := run(context.Background(), dir, false, options)
+			if name == "declare" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, "no .dang files")
+			}
+			require.Equal(t, 1, calls)
+			path := filepath.Join(dir, "bad.dang")
+			require.NoError(t, os.WriteFile(path, []byte("type Broken {"), 0o600))
+			_, baseline := run(context.Background(), dir, false, DirectoryOptions{})
+			_, err = run(context.Background(), dir, false, options)
+			require.Error(t, baseline)
+			require.EqualError(t, err, baseline.Error())
+			require.Equal(t, 1, calls, "parse errors must prevent preparation")
+		})
+	}
+}
+
+func TestDirectoryPreparationFreshInvocation(t *testing.T) {
+	for name, run := range directoryPreparationRunners {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, "main.dang")
+			for _, localName := range []string{"First", "Second"} {
+				require.NoError(t, os.WriteFile(path, []byte("import Dagger\ntype "+localName+" {}"), 0o600))
+				schema := schemaWithCoreShadowTypes()
+				ctx := ContextWithImportConfigs(context.Background(), ImportConfig{Name: "Dagger", Schema: schema})
+				_, err := run(ctx, dir, false, DirectoryOptions{BeforeInference: func(ctx context.Context, files []*FileBlock) error {
+					require.Len(t, files, 1)
+					imp := files[0].Forms[0].(*ImportDecl)
+					require.Nil(t, imp.client)
+					require.Nil(t, imp.schema)
+					require.Nil(t, imp.inferred)
+					require.Equal(t, localName, files[0].Forms[1].(*ObjectDecl).Name.Name)
+					require.Same(t, schema, importConfigsFromContext(ctx)[0].Schema)
+					return nil
+				}})
+				require.NoError(t, err)
+			}
+		})
+	}
+}
