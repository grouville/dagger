+// DirectoryOptions configures preparation of a single directory evaluation.
+// Parsed forms belong to this invocation: inference and evaluation mutate them,
+// so they must not be retained, reused, or evaluated concurrently.
+type DirectoryOptions struct {
+	// BeforeInference runs once after all files parse successfully, in stable
+	// filename order, before imports and declarations are inferred. Embedders
+	// can inspect declarations to prepare their supplied import schemas without
+	// reparsing source. Import schemas must not already have been initialized
+	// in this context's schema-module cache; use a fresh import context when
+	// preparing new schemas. This option does not clear or bypass that cache.
+	// The callback runs inside the invocation's service
+	// lifetime. The forms are inspection-only: do not mutate or retain them.
+	// It is called with an empty slice for an empty directory and is not called
+	// if any file fails to parse. A callback error aborts before inference.
+	BeforeInference func(context.Context, []*FileBlock) error
+}
