@@ -0,0 +1,85 @@
+package dangv2
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/dagger/dagger/core"
+	"github.com/stretchr/testify/require"
+	"github.com/vito/dang/v2/pkg/dang"
+	"github.com/vito/dang/v2/pkg/introspection"
+)
+
+func TestParsedModuleDeclaredTypeNames(t *testing.T) {
+	public := dang.PublicVisibility
+	files := []*dang.FileBlock{{Forms: []dang.Node{
+		&dang.ObjectDecl{Name: &dang.Symbol{Name: "Test"}, Visibility: public},
+		&dang.ObjectDecl{Name: &dang.Symbol{Name: "Hidden"}, Visibility: dang.PrivateVisibility},
+		&dang.InterfaceDecl{Name: &dang.Symbol{Name: "Readable"}, Visibility: public},
+		&dang.EnumDecl{Name: &dang.Symbol{Name: "Choice"}, Visibility: public},
+		&dang.ScalarDecl{Name: &dang.Symbol{Name: "Timestamp"}, Visibility: public},
+		&dang.Block{Forms: []dang.Node{
+			&dang.ObjectDecl{Name: &dang.Symbol{Name: "Nested"}, Visibility: public},
+		}},
+	}}, {Forms: []dang.Node{
+		&dang.ObjectDecl{Name: &dang.Symbol{Name: "Widget"}, Visibility: public},
+		&dang.ScalarDecl{Name: &dang.Symbol{Name: "Timestamp"}, Visibility: public},
+		&dang.EnumDecl{Visibility: public},
+	}}}
+	require.Equal(t, []string{"Test", "Readable", "Choice", "Timestamp", "Widget"}, moduleDeclaredTypeNames(files, "test"))
+	require.Equal(t, []string{"MainThing"}, moduleDeclaredTypeNames(nil, "main-thing"))
+	// The projection must not inject declarations into or reorder parsed forms.
+	require.Len(t, files[0].Forms, 6)
+	require.Equal(t, "Widget", files[1].Forms[0].(*dang.ObjectDecl).Name.Name)
+}
+
+func TestParsedSelfTypeNamesPreserveExistingSchemaAndScalars(t *testing.T) {
+	src := &core.ModuleSource{ModuleName: "renamed", ModuleOriginalName: "test"}
+	widgetName := core.NamespaceObject("Widget", src.ModuleName, src.ModuleOriginalName)
+	widget := &introspection.Type{Kind: introspection.TypeKindObject, Name: widgetName}
+	schema := &introspection.Schema{Types: introspection.Types{widget}}
+	files := []*dang.FileBlock{{Forms: []dang.Node{
+		&dang.ObjectDecl{Name: &dang.Symbol{Name: "Widget"}, Visibility: dang.PublicVisibility},
+		&dang.ScalarDecl{Name: &dang.Symbol{Name: "Timestamp"}, Visibility: dang.PublicVisibility},
+	}}}
+	ensureModuleSelfTypes(schema, src, files)
+	require.Same(t, widget, schema.Types.Get(widgetName))
+	scalarName := core.NamespaceObject("Timestamp", src.ModuleName, src.ModuleOriginalName)
+	require.NotNil(t, schema.Types.Get(scalarName), "source-only scalar name must still be synthesized")
+	length := len(schema.Types)
+	ensureModuleSelfTypes(schema, src, files)
+	require.Len(t, schema.Types, length, "runtime preparation must leave existing types alone")
+}
+
+func TestParsedModuleDeclarationNamesMatchFileParser(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "main.dang")
+	require.NoError(t, os.WriteFile(file, []byte(`
+scalar Timestamp
+type Test {
+  pub echo(value: Timestamp!): Timestamp! { value }
+}
+`), 0o600))
+	// The old discovery path parsed the file directly without the directory
+	// runner's filePath global. The new projection must find the same names.
+	parsed, err := dang.ParseFile(file)
+	require.NoError(t, err)
+	expected := moduleDeclaredTypeNames([]*dang.FileBlock{parsed.(*dang.FileBlock)}, "test")
+	require.Contains(t, expected, "Timestamp")
+	for _, run := range []func(context.Context, string, bool, dang.DirectoryOptions) (dang.ValueScope, error){
+		dang.DeclareDirWithOptions, dang.RunDirWithOptions,
+	} {
+		calls := 0
+		_, err := run(context.Background(), dir, false, dang.DirectoryOptions{
+			BeforeInference: func(_ context.Context, files []*dang.FileBlock) error {
+				calls++
+				require.Equal(t, expected, moduleDeclaredTypeNames(files, "test"))
+				return nil
+			},
+		})
+		require.NoError(t, err)
+		require.Equal(t, 1, calls)
+	}
+}
