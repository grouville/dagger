diff --git a/core/sdk/dang/shared/profile.go b/core/sdk/dang/shared/profile.go
new file mode 100644
index 0000000000..54573c6acd
--- /dev/null
+++ b/core/sdk/dang/shared/profile.go
@@ -0,0 +1,21 @@
+package dangshared
+
+import (
+	"context"
+
+	"github.com/dagger/dagger/core"
+	"github.com/dagger/dagger/dagql"
+	telemetry "github.com/dagger/otel-go"
+	"go.opentelemetry.io/otel/trace"
+)
+
+// BeginProfilePhase is temporary diagnostic instrumentation, not a cache or
+// lifecycle change. Preserve the user-facing span across invisible phases.
+func BeginProfilePhase(ctx context.Context, name string) (context.Context, func()) {
+	if !dagql.OTelProfActive(ctx) {
+		return ctx, func() {}
+	}
+	previous := trace.SpanContextFromContext(ctx)
+	ctx, span := core.Tracer(ctx).Start(ctx, "dang.phase."+name, telemetry.Passthrough())
+	return dagql.MarkProfilingSpan(ctx, previous), func() { span.End() }
+}
